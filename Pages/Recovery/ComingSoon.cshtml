@page "/Recovery/ComingSoon"
@model HmisWeb.Pages.Recovery.ComingSoonModel
@{
    // Form/Page        : /Recovery/ComingSoon - 'form under migration' status card
    // Module           : Billing - Recovery - HMC
    // Purpose          : The pending bars of the legacy BSMENU.MPR Recovery pad
    //                    point here so the sidebar wiring is complete without
    //                    dead links.  Shows the legacy form name, what the form
    //                    did, and its planned sprint from the approved Phase-3
    //                    proposal.  Read-only, no business logic.
    // Developer        : [TAJWER JALAL]
    // Created/Modified : 2026-10-21 10:22
    // Change Log       : 2026-10-21 10:22 - created with the full pad wiring.
    ViewData["Title"] = "Recovery - " + (Model.Info != null ? Model.Info.Title : "Recovery module");
}

<h4 class="mb-3"><i class="fa-solid fa-layer-group me-2"></i>Billing - Recovery</h4>

<div class="card">
    <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <strong>
            @if (Model.Info != null)
            {
                <text><i class="bi bi-bar-chart-steps me-1"></i>Menu bar @Model.Info.Bar - @Model.Info.Title</text>
            }
            else
            {
                <text><i class="bi bi-bar-chart-steps me-1"></i>Recovery pad</text>
            }
        </strong>
        <span class="badge text-bg-warning">Form under migration</span>
    </div>
    <div class="card-body">
        @if (Model.Info != null)
        {
            <dl class="row mb-3">
                <dt class="col-sm-3">Legacy VFP form</dt>
                <dd class="col-sm-9"><code>@Model.Info.Form</code></dd>

                <dt class="col-sm-3">What the legacy form did</dt>
                <dd class="col-sm-9">@Model.Info.OneLiner</dd>

                <dt class="col-sm-3">Review status</dt>
                <dd class="col-sm-9">
                    Phase 1-3 review complete - full findings in
                    <code>billsys\_Workspace\Docs\Recovery_Module_Review.md</code>.
                </dd>

                <dt class="col-sm-3">Planned build</dt>
                <dd class="col-sm-9">@Model.Info.Planned</dd>

                @if (Model.Info.Next)
                {
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9"><span class="badge text-bg-primary">Next screen in the sprint order - say the word and it starts</span></dd>
                }
            </dl>
        }
        else
        {
            <div class="text-muted small mb-3">
                This bar belongs to the legacy Recovery pad. Pick one of the linked
                screens from the sidebar - the live entry (Invoice/Letter - IPD) opens
                directly and the remaining bars show their legacy form and planned
                sprint here.
            </div>
        }

        <div class="alert alert-light border py-2 small mb-0">
            <i class="bi bi-info-circle me-1"></i>The live screens of the pad open directly:
            <a asp-page="/Recovery/Invoice">Invoice/Letter (IPD)</a>
            - raised on <code>RECOVERY_INV</code> with server-side numbering
            (<code>CID/MM/YYYY</code>), audit trail and the covering letter PDF;
            <a asp-page="/Recovery/Receipt">Receipts / Cheques (IPD)</a>
            - raised on <code>RECOVERY_RCPT</code>/<code>RECOVERY_RCPT_ALLOC</code>
            with per-invoice allocation, over-allocation refusal, the cheque
            lifecycle (pending &rarr; cleared / bounced) and audit rows.
        </div>
    </div>
</div>
