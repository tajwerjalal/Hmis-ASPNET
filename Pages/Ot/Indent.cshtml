@page "/ot/indent"
@model HmisWeb.Pages.Ot.IndentModel
@*
    Operation Theatre indent screen (route /ot/indent).

    Purpose
      Renders the shared department indent UI so the OT process is identical to
      Ultrasound: patient search, IPD detection, service popup, cart, save.

    Why
      The page used to read INV-OT-* rows from [ITEM] and had its own layout.
      It now uses the SERVICES DEPT 06 catalogue and the shared process.

    Business rules / validations
      Handled by the shared page model (patient + one line required, DEPT 06
      services only, panel rate resolution, discount clamping, IPD vs OPD).
      OT case records remain on the Case Entry screen.

    Developer : AI Assistant
    Created   : 27-Oct-2026 11:27
*@
@{
    ViewData["Title"] = "Operation Theatre Service Indent (Invoice)";
}

<partial name="_DepartmentIndent" model="Model" />

@section Scripts {
    <script src="~/js/department-indent.js" asp-append-version="true"></script>
}
