@page "/ot/Reports/OtUtilization"
@model HmisWeb.Pages.Ot.Reports.OtUtilizationModel
@{
    ViewData["Title"] = "OT Utilization";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-speedometer2 me-2 text-primary"></i>OT Utilization Report</h4>
        <div class="text-secondary small">Theatre-wise case load and occupancy against an 8-hour theatre day</div>
    </div>
    <a asp-page="/Ot/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>OT Menu</a>
</div>

<form method="get" class="card shadow-sm border-0 mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Date from</label>
                <input asp-for="FromDate" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Date to</label>
                <input asp-for="ToDate" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>View</button>
                @if (Model.Rows.Any())
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="otuPrint()">
                        <i class="bi bi-printer me-1"></i>Print
                    </button>
                }
            </div>
        </div>
    </div>
</form>

<div class="row g-2 mb-3">
    <div class="col"><div class="card shadow-sm border-0 text-center py-2"><div class="fs-4 fw-bold">@Model.TotalCases</div><div class="text-secondary small text-uppercase">Cases</div></div></div>
    <div class="col"><div class="card shadow-sm border-0 text-center py-2"><div class="fs-4 fw-bold text-success">@Model.TotalCompleted</div><div class="text-secondary small text-uppercase">Completed</div></div></div>
    <div class="col"><div class="card shadow-sm border-0 text-center py-2"><div class="fs-4 fw-bold text-danger">@Model.TotalCancelled</div><div class="text-secondary small text-uppercase">Cancelled</div></div></div>
    <div class="col"><div class="card shadow-sm border-0 text-center py-2"><div class="fs-4 fw-bold">@Model.TotalElective</div><div class="text-secondary small text-uppercase">Elective</div></div></div>
    <div class="col"><div class="card shadow-sm border-0 text-center py-2"><div class="fs-4 fw-bold text-danger">@Model.TotalEmergency</div><div class="text-secondary small text-uppercase">Emergency</div></div></div>
    <div class="col"><div class="card shadow-sm border-0 text-center py-2"><div class="fs-4 fw-bold">@Model.TotalMinutes</div><div class="text-secondary small text-uppercase">OT minutes</div></div></div>
    <div class="col"><div class="card shadow-sm border-0 text-center py-2"><div class="fs-4 fw-bold text-primary">@Model.GrandPct%</div><div class="text-secondary small text-uppercase">Occupancy</div></div></div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-semibold">Theatre Utilization &mdash; @Model.PeriodText (@Model.DaysInPeriod day(s) &times; @HmisWeb.Pages.Ot.Reports.OtUtilizationModel.TheatreDayMins min)</div>
    <div class="card-body p-0">
        <div class="table-responsive" id="otUtilTable">
            <table class="table table-sm table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Theatre</th>
                        <th>Type</th>
                        <th class="text-end">Cases</th>
                        <th class="text-end">Elective</th>
                        <th class="text-end">Emergency</th>
                        <th class="text-end">Completed</th>
                        <th class="text-end">Cancelled</th>
                        <th class="text-end">Postponed</th>
                        <th class="text-end">OT minutes</th>
                        <th class="text-end">Avg mins/case</th>
                        <th class="text-end">Available min</th>
                        <th class="text-end">Occupancy</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="12" class="text-center text-secondary py-5">No theatres configured - add one in OT Theatre Setup.</td></tr>
                }
                else
                {
                    foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @r.Theatre
                                @if (!r.Active)
                                {
                                    <span class="badge bg-secondary ms-1">Inactive</span>
                                }
                            </td>
                            <td>@r.TheatreType</td>
                            <td class="text-end">@r.Cases</td>
                            <td class="text-end">@r.Elective</td>
                            <td class="text-end">@r.Emergency</td>
                            <td class="text-end text-success">@r.Completed</td>
                            <td class="text-end text-danger">@r.Cancelled</td>
                            <td class="text-end">@r.Postponed</td>
                            <td class="text-end fw-semibold">@r.Minutes</td>
                            <td class="text-end">@(r.AvgMins > 0 ? r.AvgMins.ToString() : "—")</td>
                            <td class="text-end">@(r.AvailableMins > 0 ? r.AvailableMins.ToString() : "—")</td>
                            <td class="text-end">
                                @if (r.AvailableMins > 0)
                                {
                                    var pct = r.Pct;
                                    var cls = pct >= 70 ? "bg-success" : (pct >= 40 ? "bg-warning text-dark" : "bg-danger");
                                    <span class="badge @cls">@pct%</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
                @if (Model.Rows.Any())
                {
                    <tfoot class="table-light fw-semibold">
                        <tr>
                            <td colspan="2">Total</td>
                            <td class="text-end">@Model.TotalCases</td>
                            <td class="text-end">@Model.TotalElective</td>
                            <td class="text-end">@Model.TotalEmergency</td>
                            <td class="text-end text-success">@Model.TotalCompleted</td>
                            <td class="text-end text-danger">@Model.TotalCancelled</td>
                            <td class="text-end">@Model.Rows.Sum(r => r.Postponed)</td>
                            <td class="text-end">@Model.TotalMinutes</td>
                            <td class="text-end">—</td>
                            <td class="text-end">@Model.TotalAvailable</td>
                            <td class="text-end">@Model.GrandPct%</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function otuPrint() {
            var w = window.open('', '_blank', 'width=1100,height=1000');
            if (!w) { alert('Allow pop-ups to print the report.'); return; }
            var css = 'body{font-family:Segoe UI,Arial,sans-serif;font-size:8pt;padding:12mm;color:#000}' +
                      'table{border-collapse:collapse;width:100%;font-size:8pt}' +
                      'th,td{border:1px solid #999;padding:3px 5px}' +
                      'th{background:#f0f0f0;text-align:left}' +
                      'h1{font-size:13pt;text-align:center;margin:0 0 2px}' +
                      '.sub{text-align:center;color:#555;font-size:9pt;margin-bottom:8px}' +
                      '@@page{margin:10mm}';
            w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>OT Utilization</title><style>' + css + '</style></head><body>');
            w.document.write('<h1>OT UTILIZATION REPORT</h1>');
            w.document.write('<div class="sub">Operation Theatre &nbsp;|&nbsp; @Model.PeriodText &nbsp;|&nbsp; @Model.TotalCases case(s)</div>');
            w.document.write(document.getElementById('otUtilTable').innerHTML);
            w.document.write('</body></html>');
            w.document.close();
            w.focus();
            w.print();
        }
    </script>
}
