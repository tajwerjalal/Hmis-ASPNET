@page "/ot/Reports/IndentPrintout"
@model HmisWeb.Pages.Ot.Reports.IndentPrintoutModel
@{
    ViewData["Title"] = "Indent Printout";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-receipt me-2 text-primary"></i>Indent Printout</h4>
        <div class="text-secondary small">Single indent header and line items &middot; migrated from VFP us0250</div>
    </div>
    <a asp-page="/Hospital/Reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Reports</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-circle me-1"></i>@Model.ErrorMessage</div>
}

<form method="get" class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1" for="IndentNo">Indent / Bill No</label>
                <input asp-for="IndentNo" class="form-control form-control-sm" placeholder="e.g. 10015" />
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>View</button>
                @if (Model.Found)
                {
                    <a asp-page="/Hospital/Reports/IndentPrintout" asp-page-handler="Export" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-filetype-csv me-1"></i>CSV
                    </a>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="ipPrint()">
                        <i class="bi bi-printer me-1"></i>Print
                    </button>
                }
            </div>
        </div>
    </div>
</form>

@if (Model.Found)
{
    <div id="ipDoc">
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold">Indent details</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3"><label class="form-label small text-secondary mb-0">Indent No</label><div class="fw-semibold">@Model.Header.IndentNo</div></div>
                    <div class="col-md-3"><label class="form-label small text-secondary mb-0">Date</label><div class="fw-semibold">@(Model.Header.Date?.ToString("dd MMM yyyy") ?? "-")</div></div>
                    <div class="col-md-3"><label class="form-label small text-secondary mb-0">Invoice No</label><div class="fw-semibold">@(Model.Header.InvoiceNo ?? "-")</div></div>
                    <div class="col-md-3"><label class="form-label small text-secondary mb-0">Visit / BHT</label><div class="fw-semibold">@(Model.Header.EncounterNo ?? "-")</div></div>

                    <div class="col-md-6"><label class="form-label small text-secondary mb-0">Patient</label><div class="fw-semibold">@(Model.Header.PatientName ?? "-")</div></div>
                    <div class="col-md-3"><label class="form-label small text-secondary mb-0">Patient code</label><div class="fw-semibold">@(Model.Header.PatientCode ?? "-")</div></div>
                    <div class="col-md-3"><label class="form-label small text-secondary mb-0">Company</label><div class="fw-semibold">@(Model.Header.Company ?? "Private")</div></div>

                    <div class="col-md-3"><label class="form-label small text-secondary mb-0">Status</label>
                        <div>
                            @if (Model.Header.Cancelled)
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else if (Model.Header.Retired)
                            {
                                <span class="badge bg-secondary">Retired</span>
                            }
                            else
                            {
                                <span class="badge bg-@(Model.Header.Posted ? "success" : "warning")">@(Model.Header.Posted ? "Posted" : "Un-posted")</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between">
                <span>Line items (@Model.Lines.Count)</span>
                <span>Net: <strong>@Model.Header.NetTotal.ToString("N2")</strong></span>
            </div>
            <div class="card-body p-0">
                @if (Model.Lines.Any())
                {
                    <div class="table-responsive" id="ipTable">
                        <table class="table table-sm table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Rate</th>
                                    <th class="text-end">Discount</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in Model.Lines)
                                {
                                    <tr>
                                        <td>@l.Serial</td>
                                        <td>
                                            @l.Description
                                            @if (l.IsUltrasound)
                                            {
                                                <span class="badge bg-info text-dark">US</span>
                                            }
                                        </td>
                                        <td class="text-end">@l.Qty.ToString("0.##")</td>
                                        <td class="text-end">@l.Rate.ToString("N2")</td>
                                        <td class="text-end">@l.Discount.ToString("N2")</td>
                                        <td class="text-end">@l.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="4" class="text-end">Total</th>
                                    <th class="text-end">@Model.Header.Discount.ToString("N2")</th>
                                    <th class="text-end">@Model.Header.NetTotal.ToString("N2")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-secondary m-3">This indent has no line items.</p>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function ipPrint() {
            var w = window.open('', '_blank', 'width=900,height=1200');
            if (!w) { alert('Allow pop-ups to print the report.'); return; }
            var css = 'body{font-family:Segoe UI,Arial,sans-serif;font-size:10pt;padding:20px;color:#000}' +
                      'table{border-collapse:collapse;width:100%;font-size:9pt;margin-top:10px}' +
                      'th,td{border:1px solid #999;padding:3px 5px}' +
                      'th{background:#f0f0f0;text-align:left}' +
                      'h1{font-size:14pt;text-align:center;margin:0 0 10px}' +
                      '@@page{margin:14mm}';
            w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Indent Printout</title><style>' + css + '</style></head><body>');
            w.document.write('<h1>ULTRASOUND INDENT</h1>');
            w.document.write(document.getElementById('ipDoc').innerHTML);
            w.document.write('</body></html>');
            w.document.close();
            w.focus();
            setTimeout(function () { w.print(); }, 400);
        }
    </script>
}