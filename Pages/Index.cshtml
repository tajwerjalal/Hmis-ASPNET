@page
@model HmisWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="header-row d-flex justify-content-between align-items-center mb-2">
    <div>
        <h4 class="mb-0">@Model.InstitutionName</h4>
        <div class="text-muted small">@Model.DepartmentName</div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-primary-subtle text-primary"><i class="bi bi-people"></i></div>
                <div>
                    <div class="fs-4 fw-bold">@Model.PatientCount</div>
                    <div class="text-muted small">Registered Patients</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-info-subtle text-info"><i class="bi bi-hospital"></i></div>
                <div>
                    <div class="fs-4 fw-bold">@Model.ActiveInpatientCount</div>
                    <div class="text-muted small">Inpatients</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-success-subtle text-success"><i class="bi bi-receipt"></i></div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TodayBillCount</div>
                    <div class="text-muted small">Bills Today</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-warning-subtle text-warning"><i class="bi bi-cash-coin"></i></div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TodaySalesValue.ToString("N2")</div>
                    <div class="text-muted small">Sales Today</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Quick Modules</div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var link in Model.ModuleLinks)
                    {
                        var parts = link.Split(':');
                        var url = parts[0];
                        var label = parts[1];
                        var icon = parts[2];
                        <div class="col-md-4 col-sm-6">
                            <a href="@url" class="text-decoration-none">
                                <div class="d-flex flex-column align-items-center justify-content-center p-3 border rounded bg-light text-center h-100" style="min-height:110px;">
                                    <i class="bi @icon fs-2 text-primary mb-2"></i>
                                    <div class="small fw-semibold text-dark">@label</div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Recent Bills</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>#</th><th>Patient</th><th>Amount</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.RecentBills)
                        {
                            <tr>
                                <td>@b.Id</td>
                                <td>@(b.Patient?.Person?.NameWithInitials ?? b.Patient?.Person?.Name ?? "-")</td>
                                <td>@b.NetTotal.ToString("N2")</td>
                                <td>
                                    @if (b.Paid) { <span class="badge bg-success">Paid</span> }
                                    else if (b.Cancelled) { <span class="badge bg-danger">Cancelled</span> }
                                    else { <span class="badge bg-warning text-dark">Pending</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>