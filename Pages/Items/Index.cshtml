@page
@model HmisWeb.Pages.Items.IndexModel
@{
    ViewData["Title"] = "Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Items</h4>
        <div class="text-muted small">Manage Items records.</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7 col-12">
        <div class="card">
            <div class="card-header bg-white d-flex align-items-center justify-content-between">
                <strong>Items</strong>
                <span class="badge bg-primary rounded-pill">@Model.Items.Count</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Category</th>
                            <th>Unit</th>
                            <th>VAT %</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-3">No records yet. Add the first one on the right.</td></tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@(item.Code ?? "-")</td>
                                <td>@(item.ItemType?.ToString() ?? "-")</td>
                                <td>@(item.Category?.Name ?? "-")</td>
                                <td>@(item.MeasurementUnit?.Name ?? "-")</td>
                                <td>@item.VatPercentage</td>
                                <td class="text-end">
                                    <form method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="handler" value="Delete" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Retire" onclick="return confirm('Retire this record?');"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5 col-12">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Add New</div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
                }
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Name" class="form-label">Name *</label>
                            <input asp-for="Input.Name" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Code" class="form-label">Code</label>
                            <input asp-for="Input.Code" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ItemType" class="form-label">Item Type</label>
                            <select asp-for="Input.ItemType" asp-items="Html.GetEnumSelectList<ItemType>()" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.CategoryId" class="form-label">Category</label>
                            <select asp-for="Input.CategoryId" asp-items="Model.CategoryIdList" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.MeasurementUnitId" class="form-label">Measurement Unit</label>
                            <select asp-for="Input.MeasurementUnitId" asp-items="Model.MeasurementUnitIdList" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.VatPercentage" class="form-label">VAT %</label>
                            <input asp-for="Input.VatPercentage" class="form-control" type="number" step="any" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="Input.Billable" class="form-check-input" type="checkbox" />
                                <label asp-for="Input.Billable" class="form-check-label">Billable</label>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="Input.Inactive" class="form-check-input" type="checkbox" />
                                <label asp-for="Input.Inactive" class="form-check-label">Inactive</label>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3 w-100"><i class="bi bi-plus-lg"></i> Save</button>
                </form>
            </div>
        </div>
    </div>
</div>