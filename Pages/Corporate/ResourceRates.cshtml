@page "/corporate/resourcerates"
@model HmisWeb.Pages.Corporate.ResourceRatesModel
@{
    ViewData["Title"] = "Resource Rates";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-gear-wide-connected me-1 text-primary"></i>Resource Rates</h4>
        <div class="text-secondary small">Per-resource service charges: Staff Rate (SRATE) and Unit Rate (URATE).</div>
    </div>
    <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addRateModal">
        <i class="bi bi-plus-circle me-1"></i>Add Resource Rate
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Resource</label>
            <select asp-for="FilterResourceId" asp-items="Model.ResourceList" class="form-select form-select-sm">
                <option value="">All Resources</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Department</label>
            <select asp-for="FilterDepartmentId" asp-items="Model.DepartmentList" class="form-select form-select-sm">
                <option value="">All Departments</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filter</button>
            <a asp-page="/Corporate/ResourceRates" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </div>
</form>

<div class="card mb-4">
    <div class="card-header bg-white fw-semibold">
        <span><i class="bi bi-gear me-1 text-primary"></i>Assigned Resource Rates</span>
        <span class="badge bg-primary ms-1">@Model.Rates.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Resource</th>
                        <th>Service</th>
                        <th class="text-end">Staff Rate</th>
                        <th class="text-end">Unit Rate</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rates.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-gear fs-3 d-block mb-2"></i>
                                No resource rates assigned yet. Click "Add Resource Rate" to add one.
                            </td>
                        </tr>
                    }
                    @{ var rrNum = 0; }
                    @foreach (var rate in Model.Rates.OrderBy(r => r.Resource?.Name).ThenBy(r => r.Item?.Name))
                    {
                        rrNum++;
                        <tr>
                            <td class="text-muted">@rrNum</td>
                            <td class="fw-semibold">@(rate.Resource?.Name ?? "-")</td>
                            <td>@(rate.Item?.Name ?? "-")</td>
                            <td class="text-end">@rate.StaffRate.ToString("N2")</td>
                            <td class="text-end">@rate.UnitRate.ToString("N2")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#rateModal"
                                        data-id="@rate.Id"
                                        data-resource-id="@rate.ResourceId"
                                        data-item-id="@rate.ItemId"
                                        data-resource-name="@(rate.Resource?.Name ?? "")"
                                        data-item-name="@(rate.Item?.Name ?? "")"
                                        data-staffrate="@rate.StaffRate"
                                        data-unitrate="@rate.UnitRate"
                                        title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" class="d-inline"
                                      onsubmit="return confirm('Retire this resource rate?');">
                                    <input type="hidden" name="id" value="@rate.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Retire"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="addRateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Save" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-1 text-success"></i>Add Resource Rate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="Rate.Id" id="addRateId" />
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Resource <span class="text-danger">*</span></label>
                        <select asp-for="Rate.ResourceId" asp-items="Model.ResourceList" class="form-select" id="addRateResourceId">
                            <option value="">-- Select Resource --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Service <span class="text-danger">*</span></label>
                        <select asp-for="Rate.ItemId" class="form-select" id="addRateItemId">
                            <option value="">-- Select Service --</option>
                            @foreach (var s in Model.Services)
                            {
                                <option value="@s.Id">@s.Name (@string.IsNullOrEmpty(s.Code) ? "-" : s.Code)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Staff Rate</label>
                        <input asp-for="Rate.StaffRate" class="form-control" type="number" step="0.01" min="0" id="addRateStaffRate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Unit Rate</label>
                        <input asp-for="Rate.UnitRate" class="form-control" type="number" step="0.01" min="0" id="addRateUnitRate" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Save Resource Rate</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="rateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Save" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-1 text-primary"></i>Edit Resource Rate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="Rate.Id" id="rateId2" />
                <input type="hidden" asp-for="Rate.ResourceId" id="rateResourceId" />
                <input type="hidden" asp-for="Rate.ItemId" id="rateItemId" />
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Resource</label>
                        <div class="form-control-plaintext fw-semibold" id="rateResourceName">-</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Service</label>
                        <div class="form-control-plaintext fw-semibold" id="rateItemName">-</div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Staff Rate</label>
                        <input asp-for="Rate.StaffRate" class="form-control" type="number" step="0.01" min="0" id="rateStaffRate2" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Unit Rate</label>
                        <input asp-for="Rate.UnitRate" class="form-control" type="number" step="0.01" min="0" id="rateUnitRate2" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage) && Model.Rate != null && Model.Rate.ResourceId > 0)
    {
        <text>bootstrap.Modal.getOrCreateInstance(document.getElementById('addRateModal')).show();</text>
    }
    var rateModal = document.getElementById('rateModal');
    rateModal.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('rateId2').value = btn.getAttribute('data-id');
        document.getElementById('rateResourceId').value = btn.getAttribute('data-resource-id');
        document.getElementById('rateItemId').value = btn.getAttribute('data-item-id');
        document.getElementById('rateResourceName').textContent = btn.getAttribute('data-resource-name') || '-';
        document.getElementById('rateItemName').textContent = btn.getAttribute('data-item-name') || '-';
        document.getElementById('rateStaffRate2').value = btn.getAttribute('data-staffrate');
        document.getElementById('rateUnitRate2').value = btn.getAttribute('data-unitrate');
    });
</script>
}