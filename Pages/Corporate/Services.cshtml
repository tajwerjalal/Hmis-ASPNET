@page "/corporate/services"
@model HmisWeb.Pages.Corporate.ServicesModel
@{
    ViewData["Title"] = "Corporate Services";
}

<style>
    .service-name-cell .name { font-weight: 600; color: #212529; }
    .service-name-cell .code { font-size: 0.78rem; color: #6c757d; }
    .rate-badge { min-width: 32px; display: inline-block; text-align: center; }
    .toast-msg { position: fixed; top: 16px; right: 16px; z-index: 9999; min-width: 300px; }
</style>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="toast-msg alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle me-1"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="toast-msg alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-gear-wide-connected me-1 text-primary"></i>Corporate Services</h4>
        <div class="text-secondary small">Billable services across departments (X-Ray, US, CT, Lab, Room Charges, Consultant, etc.)</div>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="bi bi-plus-circle me-1"></i>Add Service
        </button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card text-center py-3">
            <div class="text-secondary small">Total Billable</div>
            <div class="fs-4 fw-bold text-primary">@Model.TotalCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center py-3">
            <div class="text-secondary small">Filtered Results</div>
            <div class="fs-4 fw-bold text-dark">@Model.FilteredCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center py-3">
            <div class="text-secondary small">Departments</div>
            <div class="fs-4 fw-bold text-info">@Model.Services.Select(s => s.DepartmentId).Distinct().Count()</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center py-3">
            <div class="text-secondary small">Total Company Rates</div>
            <div class="fs-4 fw-bold text-warning">@Model.Services.Sum(s => s.CompanyRateCount)</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white fw-semibold">
        <div class="row g-2 align-items-end">
            <div class="col-md-12">
                <form method="get" class="d-flex gap-2 align-items-end flex-wrap">
                    <div>
                        <label class="form-label small text-muted mb-1">Search</label>
                        <input asp-for="Q" class="form-control form-control-sm" placeholder="Name or code..." style="width:180px" />
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-1">Department</label>
                        <select asp-for="FilterDepartmentId" asp-items="Model.DepartmentList" class="form-select form-select-sm">
                            <option value="">All Departments</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-1">Item Type</label>
                        <select asp-for="FilterItemType" asp-items="Model.ItemTypeList" class="form-select form-select-sm">
                            <option value="">All Types</option>
                        </select>
                    </div>
                    <div class="d-flex gap-1">
                        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filter</button>
                        <a asp-page="/Corporate/Services" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-circle me-1"></i>Clear</a>
                    </div>
                </form>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="text-muted small">Services <span class="badge bg-primary ms-1">@Model.FilteredCount</span></span>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Type</th>
                        <th class="text-end">Base Rate</th>
                        <th class="text-end">Staff Rate</th>
                        <th class="text-end">Unit Rate</th>
                        <th class="text-center">Cons. Req.</th>
                        <th class="text-center">Discount</th>
                        <th class="text-center">Company Rates</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Services.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">
                                <i class="bi bi-gear-wide-connected fs-3 d-block mb-2"></i>
                                No services found. Click "Add Service" to create one.
                            </td>
                        </tr>
                    }
                    @foreach (var s in Model.Services)
                    {
                        <tr>
                            <td class="small text-muted fw-semibold">@(string.IsNullOrEmpty(s.Code) ? "-" : s.Code)</td>
                            <td class="service-name-cell">
                                <div class="name">@s.Name</div>
                            </td>
                            <td>@s.DepartmentName</td>
                            <td>
                                @if (s.ItemType != "-")
                                {
                                    <span class="badge bg-secondary">@s.ItemType</span>
                                }
                                else
                                {
                                    @:-
                                }
                            </td>
                            <td class="text-end fw-semibold">@(s.BaseRate.HasValue ? s.BaseRate.Value.ToString("N2") : "-")</td>
                            <td class="text-end">@(s.StaffRate.HasValue ? s.StaffRate.Value.ToString("N2") : "-")</td>
                            <td class="text-end">@(s.UnitRate.HasValue ? s.UnitRate.Value.ToString("N2") : "-")</td>
                            <td class="text-center">
                                @if (s.ConsultantRequired == true)
                                {
                                    <i class="bi bi-check-circle-fill text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-dash-circle text-muted"></i>
                                }
                            </td>
                            <td class="text-center">
                                @if (s.DiscountAllowed)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-dash-circle text-muted"></i>
                                }
                            </td>
                            <td class="text-center">
                                @if (s.CompanyRateCount > 0)
                                {
                                    <span class="badge bg-info rate-badge">@s.CompanyRateCount</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted rate-badge">0</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#editModal"
                                        data-id="@s.Id"
                                        data-name="@s.Name"
                                        data-sname="@s.Code"
                                        data-code="@s.Code"
                                        data-rate="@s.BaseRate"
                                        data-staffrate="@s.StaffRate"
                                        data-unitrate="@s.UnitRate"
                                        data-consultantrequired="@s.ConsultantRequired"
                                        data-corporateactive="@s.CorporateActive"
                                        data-requirements="@s.Requirements"
                                        data-minduration="@s.MinDuration"
                                        data-maxduration="@s.MaxDuration"
                                        data-source="@s.Source"
                                        data-departmentid="@s.DepartmentId"
                                        data-itemtype="@s.ItemType"
                                        data-discountallowed="@s.DiscountAllowed"
                                        title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Retire" class="d-inline">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Retire"
                                            onclick="return confirm('Retire service @s.Name?')">
                                        <i class="bi bi-archive"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Create" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-1 text-success"></i>Add New Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Code</label>
                    <input class="form-control" id="createCode" value="@Model.AutoCode" disabled />
                    <div class="form-text">Auto-generated on save — cannot be changed.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Service Name <span class="text-danger">*</span></label>
                    <input asp-for="FormItem.Name" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Short Name</label>
                    <input asp-for="FormItem.Sname" class="form-control" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Base Rate</label>
                        <input asp-for="FormItem.Total" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Item Type</label>
                        <select asp-for="FormItem.ItemType" asp-items="Model.ItemTypeList" class="form-select" id="createItemType">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Staff Rate</label>
                        <input asp-for="FormItem.StaffRate" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Unit Rate</label>
                        <input asp-for="FormItem.UnitRate" class="form-control" type="number" step="0.01" />
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Min Duration</label>
                        <input asp-for="FormItem.MinDuration" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max Duration</label>
                        <input asp-for="FormItem.MaxDuration" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Source</label>
                        <input asp-for="FormItem.Source" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Requirements</label>
                    <input asp-for="FormItem.Requirements" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Department</label>
                    <select asp-for="FormItem.DepartmentId" asp-items="Model.DepartmentList" class="form-select" id="createDepartmentId">
                        <option value="">-- Select Department --</option>
                    </select>
                </div>
                <div class="d-flex gap-3 mb-3">
                    <div class="form-check">
                        <input asp-for="FormItem.DiscountAllowed" class="form-check-input" />
                        <label asp-for="FormItem.DiscountAllowed" class="form-check-label">Discount Allowed</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="FormItem.ConsultantRequired" class="form-check-input" />
                        <label asp-for="FormItem.ConsultantRequired" class="form-check-label">Consultant Required</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="FormItem.CorporateActive" class="form-check-input" />
                        <label asp-for="FormItem.CorporateActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Create Service</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Edit" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-1 text-primary"></i>Edit Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="EditId" id="editId" />
                <div class="mb-3">
                    <label class="form-label">Code</label>
                    <input asp-for="FormItem.Code" class="form-control" id="editCode" disabled />
                    <div class="form-text">Auto-generated — cannot be changed after saving.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Service Name <span class="text-danger">*</span></label>
                    <input asp-for="FormItem.Name" class="form-control" id="editName" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Short Name</label>
                    <input asp-for="FormItem.Sname" class="form-control" id="editSname" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Base Rate</label>
                        <input asp-for="FormItem.Total" class="form-control" type="number" step="0.01" id="editTotal" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Item Type</label>
                        <select asp-for="FormItem.ItemType" asp-items="Model.ItemTypeList" class="form-select" id="editItemType">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Staff Rate</label>
                        <input asp-for="FormItem.StaffRate" class="form-control" type="number" step="0.01" id="editStaffRate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Unit Rate</label>
                        <input asp-for="FormItem.UnitRate" class="form-control" type="number" step="0.01" id="editUnitRate" />
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Min Duration</label>
                        <input asp-for="FormItem.MinDuration" class="form-control" id="editMinDuration" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Max Duration</label>
                        <input asp-for="FormItem.MaxDuration" class="form-control" id="editMaxDuration" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Source</label>
                        <input asp-for="FormItem.Source" class="form-control" id="editSource" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Requirements</label>
                    <input asp-for="FormItem.Requirements" class="form-control" id="editRequirements" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Department</label>
                    <select asp-for="FormItem.DepartmentId" asp-items="Model.DepartmentList" class="form-select" id="editDepartmentId">
                        <option value="">-- Select Department --</option>
                    </select>
                </div>
                <div class="d-flex gap-3 mb-3">
                    <div class="form-check">
                        <input asp-for="FormItem.DiscountAllowed" class="form-check-input" id="editDiscountAllowed" />
                        <label asp-for="FormItem.DiscountAllowed" class="form-check-label">Discount Allowed</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="FormItem.ConsultantRequired" class="form-check-input" id="editConsultantRequired" />
                        <label asp-for="FormItem.ConsultantRequired" class="form-check-label">Consultant Required</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="FormItem.CorporateActive" class="form-check-input" id="editCorporateActive" />
                        <label asp-for="FormItem.CorporateActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    var nextNumbers = {
        @foreach (var kv in Model.NextCodeMap)
        {
            @:'@kv.Key': @kv.Value,
        }
    };

    function servicePrefix() {
        var type = document.getElementById('createItemType').value;
        if (type === 'Investigation') {
            var deptSelect = document.getElementById('createDepartmentId');
            var deptName = (deptSelect.options[deptSelect.selectedIndex] || { text: '' }).text || '';
            var n = deptName.toUpperCase();
            if (n.indexOf('RADIO') >= 0 || n.indexOf('X-RAY') >= 0 || n.indexOf('XRAY') >= 0) return 'RAD';
            if (n.indexOf('ULTRASOUND') >= 0 || n.indexOf('USG') >= 0 || n.indexOf(' US') >= 0) return 'USG';
            if (n.indexOf('CT') >= 0) return 'CTS';
            if (n.indexOf('MRI') >= 0) return 'MRI';
            if (n.indexOf('ECG') >= 0 || n.indexOf('EEG') >= 0) return 'ECG';
            return 'INV';
        }
        if (type === 'Service') return 'SER';
        return 'ITM';
    }

    function updateCreateCode() {
        var prefix = servicePrefix();
        var num = nextNumbers[prefix] || 1;
        document.getElementById('createCode').value = prefix + '-' + String(num).padStart(3, '0');
    }

    document.getElementById('createItemType').addEventListener('change', updateCreateCode);
    document.getElementById('createDepartmentId').addEventListener('change', updateCreateCode);

    var editModal = document.getElementById('editModal');
    editModal.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('editId').value = btn.getAttribute('data-id');
        document.getElementById('editName').value = btn.getAttribute('data-name') || '';
        document.getElementById('editSname').value = btn.getAttribute('data-sname') || '';
        document.getElementById('editCode').value = btn.getAttribute('data-code') || '';
        document.getElementById('editTotal').value = btn.getAttribute('data-rate') || '';
        document.getElementById('editStaffRate').value = btn.getAttribute('data-staffrate') || '';
        document.getElementById('editUnitRate').value = btn.getAttribute('data-unitrate') || '';
        document.getElementById('editMinDuration').value = btn.getAttribute('data-minduration') || '';
        document.getElementById('editMaxDuration').value = btn.getAttribute('data-maxduration') || '';
        document.getElementById('editSource').value = btn.getAttribute('data-source') || '';
        document.getElementById('editRequirements').value = btn.getAttribute('data-requirements') || '';

        var deptId = btn.getAttribute('data-departmentid') || '';
        var deptSelect = document.getElementById('editDepartmentId');
        for (var i = 0; i < deptSelect.options.length; i++) {
            if (deptSelect.options[i].value === deptId) {
                deptSelect.selectedIndex = i;
                break;
            }
        }

        var itemType = btn.getAttribute('data-itemtype') || '';
        var typeSelect = document.getElementById('editItemType');
        for (var i = 0; i < typeSelect.options.length; i++) {
            if (typeSelect.options[i].value === itemType) {
                typeSelect.selectedIndex = i;
                break;
            }
        }

        var discount = btn.getAttribute('data-discountallowed') === 'True';
        document.getElementById('editDiscountAllowed').checked = discount;

        var consReq = btn.getAttribute('data-consultantrequired') === 'True';
        document.getElementById('editConsultantRequired').checked = consReq;

        var corpActive = btn.getAttribute('data-corporateactive') === 'True';
        document.getElementById('editCorporateActive').checked = corpActive;
    });

    setTimeout(function () {
        var alerts = document.querySelectorAll('.toast-msg');
        alerts.forEach(function (el) {
            var bsAlert = bootstrap.Alert.getOrCreateInstance(el);
            bsAlert.close();
        });
    }, 4000);
</script>
}
