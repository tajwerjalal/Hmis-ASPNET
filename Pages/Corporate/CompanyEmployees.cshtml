@page "/corporate/companyemployees"
@model HmisWeb.Pages.Corporate.CompanyEmployeesModel
@{
    ViewData["Title"] = "Company Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-people me-1 text-primary"></i>Company Employees</h4>
        <div class="text-secondary small">Employees of insurance companies / corporate clients (EMPLOYEE.DBF equivalent).</div>
    </div>
    <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#createModal">
        <i class="bi bi-plus-circle me-1"></i>Add Employee
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Company</label>
            <select asp-for="FilterCompanyId" asp-items="Model.CompanyList" class="form-select form-select-sm">
                <option value="">All Companies</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input asp-for="Q" class="form-control form-control-sm" placeholder="Name, code, designation, mobile" />
        </div>
        <div class="col-md-4 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filter</button>
            <a asp-page="/Corporate/CompanyEmployees" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header bg-white fw-semibold">
        <span><i class="bi bi-people me-1 text-primary"></i>Employees</span>
        <span class="badge bg-primary ms-1">@Model.Employees.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Code</th>
                        <th>Employee</th>
                        <th>Company</th>
                        <th>Designation</th>
                        <th>Mobile</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Employees.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-people fs-3 d-block mb-2"></i>
                                No employees found. Click "Add Employee" to create one.
                            </td>
                        </tr>
                    }
                    @{ var rowNum = 0; }
                    @foreach (var e in Model.Employees)
                    {
                        rowNum++;
                        <tr class="@(e.Retired ? "table-light" : "")">
                            <td class="text-muted">@rowNum</td>
                            <td class="small text-muted">@(string.IsNullOrEmpty(e.EmployeeCode) ? "-" : e.EmployeeCode)</td>
                            <td class="fw-semibold">@e.Name</td>
                            <td>@(e.Company?.Name ?? "-")</td>
                            <td>@(string.IsNullOrEmpty(e.Designation) ? "-" : e.Designation)</td>
                            <td>@(string.IsNullOrEmpty(e.Mobile) ? "-" : e.Mobile)</td>
                            <td>
                                @if (e.Retired)
                                {
                                    <span class="badge bg-secondary">Retired</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#editModal"
                                        data-id="@e.Id"
                                        data-company-id="@e.CompanyId"
                                        data-code="@e.EmployeeCode"
                                        data-name="@e.Name"
                                        data-designation="@e.Designation"
                                        data-nic="@e.Nic"
                                        data-mobile="@e.Mobile"
                                        data-address="@e.Address"
                                        data-email="@e.Email"
                                        title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                @if (!e.Retired)
                                {
                                    <form method="post" asp-page-handler="Retire" class="d-inline">
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Retire"
                                                onclick="return confirm('Retire employee @e.Name?');">
                                            <i class="bi bi-archive"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Restore" class="d-inline">
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Restore"
                                                onclick="return confirm('Restore employee @e.Name?');">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Create" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-1 text-success"></i>Add New Employee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Company <span class="text-danger">*</span></label>
                        <select asp-for="EmployeeInput.CompanyId" asp-items="Model.CompanyList" class="form-select" required>
                            <option value="">-- Select Company --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Employee Code</label>
                        <input asp-for="EmployeeInput.EmployeeCode" class="form-control" />
                        <div class="form-text">Auto-generated from company if empty.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input asp-for="EmployeeInput.Name" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Designation</label>
                        <input asp-for="EmployeeInput.Designation" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">NIC</label>
                        <input asp-for="EmployeeInput.Nic" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Mobile</label>
                        <input asp-for="EmployeeInput.Mobile" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input asp-for="EmployeeInput.Email" type="email" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <input asp-for="EmployeeInput.Address" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Create Employee</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Edit" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-1 text-primary"></i>Edit Employee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="EditId" id="editId" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Company <span class="text-danger">*</span></label>
                        <select asp-for="EmployeeInput.CompanyId" asp-items="Model.CompanyList" class="form-select" id="editCompanyId" required>
                            <option value="">-- Select Company --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Employee Code</label>
                        <input asp-for="EmployeeInput.EmployeeCode" class="form-control" id="editCode" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input asp-for="EmployeeInput.Name" class="form-control" id="editName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Designation</label>
                        <input asp-for="EmployeeInput.Designation" class="form-control" id="editDesignation" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">NIC</label>
                        <input asp-for="EmployeeInput.Nic" class="form-control" id="editNic" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Mobile</label>
                        <input asp-for="EmployeeInput.Mobile" class="form-control" id="editMobile" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input asp-for="EmployeeInput.Email" type="email" class="form-control" id="editEmail" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <input asp-for="EmployeeInput.Address" class="form-control" id="editAddress" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    var editModal = document.getElementById('editModal');
    editModal.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('editId').value = btn.getAttribute('data-id');
        document.getElementById('editCompanyId').value = btn.getAttribute('data-company-id') || '';
        document.getElementById('editCode').value = btn.getAttribute('data-code') || '';
        document.getElementById('editName').value = btn.getAttribute('data-name') || '';
        document.getElementById('editDesignation').value = btn.getAttribute('data-designation') || '';
        document.getElementById('editNic').value = btn.getAttribute('data-nic') || '';
        document.getElementById('editMobile').value = btn.getAttribute('data-mobile') || '';
        document.getElementById('editEmail').value = btn.getAttribute('data-email') || '';
        document.getElementById('editAddress').value = btn.getAttribute('data-address') || '';
    });
</script>
}