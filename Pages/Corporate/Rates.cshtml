@page
@model HmisWeb.Pages.Corporate.RatesModel
@{
    ViewData["Title"] = "Corporate Rates";
}

<div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0"><i class="bi bi-cash-coin me-1 text-primary"></i>Corporate Rates</h4>
        <div class="text-muted small">
            Company rate card - pick a company and a department, then every service of that
            department is listed with the company's rate (legacy master <code>compchg.dbf</code>).
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Model.SelectedCompanyCode) && !string.IsNullOrEmpty(Model.FilterDept))
    {
        <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addRateModal">
            <i class="bi bi-plus-circle me-1"></i>Add / Change Rate
        </button>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="icon bg-primary bg-opacity-10 text-primary rounded-3"><i class="bi bi-building"></i></div>
                <div>
                    <div class="text-muted small">Companies with Rates</div>
                    <div class="fw-bold fs-5">@Model.TotalCompaniesWithRates</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="icon bg-success bg-opacity-10 text-success rounded-3"><i class="bi bi-box2"></i></div>
                <div>
                    <div class="text-muted small">Services with Rates</div>
                    <div class="fw-bold fs-5">@Model.TotalServicesWithRates</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="icon bg-info bg-opacity-10 text-info rounded-3"><i class="bi bi-gear"></i></div>
                <div>
                    <div class="text-muted small">Total Configurations</div>
                    <div class="fw-bold fs-5">@Model.TotalRateConfigurations</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="icon bg-warning bg-opacity-10 text-warning rounded-3"><i class="bi bi-check2-square"></i></div>
                <div>
                    <div class="text-muted small">Rates of Selected Company</div>
                    <div class="fw-bold fs-5">@Model.CompanyRateCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---- company + department selection ---- *@
<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small mb-1">Company</label>
                <select name="SelectedCompanyCode" class="form-select form-select-sm">
                    <option value="">-- Select Company --</option>
                    @foreach (var c in Model.CompanyFilterList)
                    {
                        if (Model.SelectedCompanyCode == c.Value)
                        {
                            <option value="@c.Value" selected>@c.Text</option>
                        }
                        else
                        {
                            <option value="@c.Value">@c.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Department</label>
                <select name="FilterDept" class="form-select form-select-sm">
                    <option value="">-- Select Department --</option>
                    @foreach (var d in Model.DeptFilterList)
                    {
                        if (Model.FilterDept == d.Value)
                        {
                            <option value="@d.Value" selected>@d.Text</option>
                        }
                        else
                        {
                            <option value="@d.Value">@d.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Search</label>
                <input name="Q" value="@Model.Q" class="form-control form-control-sm" placeholder="service code or name" />
            </div>
            <div class="col-md-1 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Show</button>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <strong>
            @if (!string.IsNullOrEmpty(Model.SelectedCompanyCode))
            {
                <span>Rate card - company @Model.SelectedCompanyCode</span>
            }
            else
            {
                <span>Rate card</span>
            }
            @if (!string.IsNullOrEmpty(Model.FilterDept))
            {
                <span class="text-muted small ms-2">@Model.FilterDept</span>
            }
        </strong>
        @if (Model.ShowRates)
        {
            <span class="badge bg-primary rounded-pill">@Model.TotalCount services</span>
        }
    </div>
    <div class="card-body p-0">
        @if (!Model.Rows.Any())
        {
            <div class="p-4 text-center text-muted">
                @if (string.IsNullOrEmpty(Model.SelectedCompanyCode) && string.IsNullOrEmpty(Model.FilterDept))
                {
                    <span>Select a company and a department to see the rate card.</span>
                }
                else if (string.IsNullOrEmpty(Model.SelectedCompanyCode))
                {
                    <span>Select a company to see its rates for this department.</span>
                }
                else if (string.IsNullOrEmpty(Model.FilterDept))
                {
                    <span>Select a department to see the rates of company @Model.SelectedCompanyCode.</span>
                }
                else
                {
                    <span>No service of this department matches the search.</span>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Service</th>
                            <th>Dept</th>
                            <th class="text-end">Base Rate</th>
                            <th class="text-end">Base Foreigner</th>
                            <th class="text-end">Company Rate</th>
                            <th class="text-end">Foreigner</th>
                            <th class="text-end">Discount %</th>
                            <th>Effective</th>
                            <th>Legacy Stamp</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var rate = row.Rate;
                            <tr class="@(rate == null ? "" : "table-light")">
                                <td class="fw-semibold">@row.ServiceCode</td>
                                <td>@row.ServiceName</td>
                                <td class="text-muted small">@row.Dept</td>
                                <td class="text-end">@row.BaseRate.ToString("N2")</td>
                                <td class="text-end text-muted">@row.BaseForeignerRate.ToString("N2")</td>
                                <td class="text-end">
                                    @if (rate != null)
                                    {
                                        <span class="fw-bold text-success">@rate.Rate.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (rate != null && rate.URate.HasValue)
                                    {
                                        @rate.URate.Value.ToString("N2")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (rate != null && rate.DiscountPercent.HasValue)
                                    {
                                        @rate.DiscountPercent.Value.ToString("N1")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @if (rate != null && (rate.EffectiveFrom.HasValue || rate.EffectiveTo.HasValue))
                                    {
                                        @((rate.EffectiveFrom?.ToString("dd-MMM-yy") ?? "-") + " to " + (rate.EffectiveTo?.ToString("dd-MMM-yy") ?? "-"))
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @if (rate != null)
                                    {
                                        @(rate.UserId ?? "-") @(rate.UDate?.ToString("dd-MMM-yy") ?? "") @(rate.UTime ?? "")
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (rate != null)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary edit-rate-btn"
                                                data-rate-id="@rate.Id"
                                                data-company-id="@rate.CompanyId"
                                                data-company-name="@Model.SelectedCompanyCode"
                                                data-item-id="@rate.ItemId"
                                                data-item-name="@row.ServiceName"
                                                data-service-code="@row.ServiceCode"
                                                data-dept="@row.Dept"
                                                data-base-rate="@row.BaseRate.ToString("N2")"
                                                data-rate="@rate.Rate.ToString("N2")"
                                                data-urate="@(rate.URate?.ToString() ?? "")"
                                                data-staffrate="@(rate.StaffRate?.ToString() ?? "")"
                                                data-unitrate="@(rate.UnitRate?.ToString() ?? "")"
                                                data-discount="@(rate.DiscountPercent?.ToString() ?? "")"
                                                data-effective-from="@(rate.EffectiveFrom?.ToString("yyyy-MM-dd") ?? "")"
                                                data-effective-to="@(rate.EffectiveTo?.ToString("yyyy-MM-dd") ?? "")"
                                                title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" asp-page-handler="DeleteRate" class="d-inline" onsubmit="return confirm('Retire this rate?');">
                                            <input type="hidden" name="id" value="@rate.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Retire"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<partial name="_Pager" model="Model" />

@* ---- add / change a rate ---- *@
<div class="modal fade" id="addRateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="SaveRate" class="modal-content" id="addRateForm">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-1 text-success"></i>Add / Change Company Rate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Company <span class="text-danger">*</span></label>
                        <select asp-for="RateInput.CompanyId" class="form-select" id="addRateCompanyId">
                            <option value="">-- Select Company --</option>
                            @foreach (var c in Model.Companies)
                            {
                                <option value="@c.Id">@c.Code - @c.Name</option>
                            }
                        </select>
                        <input type="hidden" asp-for="RateInput.CompanyCode" id="addRateCompanyCode" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Service <span class="text-danger">*</span></label>
                        <select asp-for="RateInput.ServiceCode" class="form-select" id="addRateServiceCode">
                            <option value="">-- Select Service --</option>
                            @foreach (var s in Model.ServiceList)
                            {
                                <option value="@s.Value">@s.Text</option>
                            }
                        </select>
                        <input type="hidden" asp-for="RateInput.ItemId" id="addRateItemId" />
                        <input type="hidden" asp-for="RateInput.Dept" id="addRateDept" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Company Rate <span class="text-danger">*</span></label>
                        <input asp-for="RateInput.Rate" class="form-control" type="number" step="0.01" min="0" id="addRateValue" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Foreigner Rate</label>
                        <input asp-for="RateInput.URate" class="form-control" type="number" step="0.01" min="0" id="addRateUrate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Discount %</label>
                        <input asp-for="RateInput.DiscountPercent" class="form-control" type="number" step="0.1" min="0" max="100" id="addRateDiscount" />
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Effective From</label>
                        <input asp-for="RateInput.EffectiveFrom" class="form-control" type="date" id="addRateEffectiveFrom" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Effective To</label>
                        <input asp-for="RateInput.EffectiveTo" class="form-control" type="date" id="addRateEffectiveTo" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Save Company Rate</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="rateModal" tabindex="-1" aria-labelledby="rateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rateModalLabel">Change Company Rate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="SaveRate" id="rateForm">
                <div class="modal-body">
                    <input type="hidden" asp-for="RateInput.Id" id="rateId" />
                    <input type="hidden" asp-for="RateInput.CompanyId" id="rateCompanyId" />
                    <input type="hidden" asp-for="RateInput.ItemId" id="rateItemId" />
                    <input type="hidden" asp-for="RateInput.CompanyCode" id="rateCompanyCode" />
                    <input type="hidden" asp-for="RateInput.ServiceCode" id="rateServiceCode" />
                    <input type="hidden" asp-for="RateInput.Dept" id="rateDept" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Company</label>
                            <div class="form-control-plaintext fw-semibold" id="rateCompanyName">-</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Service</label>
                            <div class="form-control-plaintext fw-semibold" id="rateServiceName">-</div>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Base Rate</label>
                            <input class="form-control" id="rateBaseRate" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Company Rate <span class="text-danger">*</span></label>
                            <input asp-for="RateInput.Rate" class="form-control" type="number" step="0.01" min="0" id="rateValue" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Foreigner Rate</label>
                            <input asp-for="RateInput.URate" class="form-control" type="number" step="0.01" min="0" id="rateUrate" />
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Staff Rate</label>
                            <input asp-for="RateInput.StaffRate" class="form-control" type="number" step="0.01" min="0" id="rateStaffRate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Unit Rate</label>
                            <input asp-for="RateInput.UnitRate" class="form-control" type="number" step="0.01" min="0" id="rateUnitRate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Discount %</label>
                            <input asp-for="RateInput.DiscountPercent" class="form-control" type="number" step="0.1" min="0" max="100" id="rateDiscount" />
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Effective From</label>
                            <input asp-for="RateInput.EffectiveFrom" class="form-control" type="date" id="rateEffectiveFrom" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Effective To</label>
                            <input asp-for="RateInput.EffectiveTo" class="form-control" type="date" id="rateEffectiveTo" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // keep the selected company / department / service in the add-rate popup
    $('#addRateCompanyId').on('change', function () {
        var code = $(this).find('option:selected').text().split(' - ')[0];
        $('#addRateCompanyCode').val(code);
    });

    $('#addRateServiceCode').on('change', function () {
        $('#addRateServiceCode').trigger('change');
    });

    // the edit button fills the change-rate popup
    $(document).on('click', '.edit-rate-btn', function () {
        var btn = $(this);
        $('#rateId').val(btn.data('rate-id'));
        $('#rateCompanyId').val(btn.data('company-id'));
        $('#rateCompanyCode').val(btn.data('company-name'));
        $('#rateItemId').val(btn.data('item-id'));
        $('#rateServiceCode').val(btn.data('service-code'));
        $('#rateDept').val(btn.data('dept'));
        $('#rateCompanyName').text(btn.data('company-name') || '-');
        $('#rateServiceName').text((btn.data('service-code') || '') + ' ' + (btn.data('item-name') || ''));
        $('#rateBaseRate').val(btn.data('base-rate'));
        $('#rateValue').val(btn.data('rate'));
        $('#rateUrate').val(btn.data('urate'));
        $('#rateStaffRate').val(btn.data('staffrate'));
        $('#rateUnitRate').val(btn.data('unitrate'));
        $('#rateDiscount').val(btn.data('discount'));
        $('#rateEffectiveFrom').val(btn.data('effective-from'));
        $('#rateEffectiveTo').val(btn.data('effective-to'));
        new bootstrap.Modal(document.getElementById('rateModal')).show();
    });
</script>
}
