@page
@model HmisWeb.Pages.Patients.VisitsModel
@{
    ViewData["Title"] = "Patient Visits";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0">Patient Visits</h4>
        <div class="text-muted small">Encounter history for all patients.</div>
    </div>
    <form method="get" class="d-flex gap-2 align-items-center">
        <input asp-for="FromDate" class="form-control form-control-sm" type="date" />
        <span class="text-muted">to</span>
        <input asp-for="ToDate" class="form-control form-control-sm" type="date" />
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel"></i> Filter</button>
    </form>
</div>

<div class="card">
    <div class="card-header bg-white fw-semibold">Encounters (@Model.Encounters.Count)</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Encounter Id</th>
                    <th>Patient</th>
                    <th>PHN</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Department</th>
                    <th>Referral</th>
                    <th>Comments</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Encounters.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-3">No encounters in the selected range.</td></tr>
                }
                @foreach (var e in Model.Encounters)
                {
                    <tr>
                        <td>@e.Id</td>
                        <td class="fw-semibold">@(e.Patient?.Person?.Name ?? "-")</td>
                        <td>@(e.Patient?.Phn ?? "-")</td>
                        <td>@(e.EncounterType?.ToString() ?? "-")</td>
                        <td>@(e.EncounterDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@(e.EncounterTime?.ToString("HH:mm") ?? "-")</td>
                        <td>@(e.Department?.Name ?? "-")</td>
                        <td>@(e.ReferringStaff?.Person?.Name ?? "-")</td>
                        <td>@(e.EncounterComments ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>