@page "/patients/Index"
@model HmisWeb.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Patient Search</h4>
        <div class="text-muted small">Search registered patients by PHN, name or mobile number.</div>
    </div>
    <a asp-page="/patients/Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> New Patient</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-page="/patients/Index" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="Search by PHN / name / mobile" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Search</button>
            </div>
            <div class="col-md-auto">
                <a asp-page="/patients/Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white fw-semibold">Results (@Model.Patients.Count)</div>
    <div class="card-body p-0">
        @if (!Model.Patients.Any())
        {
            <div class="p-4 text-center text-muted">
                @if (string.IsNullOrWhiteSpace(Model.Q))
                {
                    <span>Enter a search term (PHN, name or mobile) to find a patient.</span>
                }
                else
                {
                    <span>No patients found matching &quot;@Model.Q&quot;.</span>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>PHN</th>
                            <th>Name</th>
                            <th>Age</th>
                            <th>Sex</th>
                            <th>Mobile</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Patients)
                        {
                            var name = p.Person?.NameWithInitials ?? p.Person?.Name ?? "-";
                            <tr>
                                <td>@(p.PatientId?.ToString() ?? p.Phn ?? "-")</td>
                                <td class="fw-semibold">@name</td>
                                <td>@(p.Person?.GetAgeString() ?? "-")</td>
                                <td>@(p.Person?.Sex?.ToString() ?? "-")</td>
                                <td>@(p.Person?.Mobile ?? "-")</td>
                                <td class="text-end">
                                    <a asp-page="/patients/Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> View</a>
                                    <a asp-page="/patients/Create" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>