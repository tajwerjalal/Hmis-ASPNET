@page "/patients/Details"
@model HmisWeb.Pages.Patients.DetailsModel
@{
    ViewData["Title"] = "Patient Details";
}

@if (Model.Patient != null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Patient Details</h4>
            <div class="text-muted small">PHN: @(Model.Patient.PatientId?.ToString() ?? Model.Patient.Phn ?? "-")</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/patients/Create" asp-route-id="@Model.Patient.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
            <a asp-page="/patients/Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-white fw-semibold">Personal Information</div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr><th class="w-25">Name</th><td>@(Model.Patient.Person?.NameWithInitials ?? Model.Patient.Person?.Name ?? "-")</td></tr>
                            <tr><th>Full Name</th><td>@(Model.Patient.Person?.Name ?? "-")</td></tr>
                            <tr><th>Age</th><td>@(Model.Patient.Person?.GetAgeString() ?? "-")</td></tr>
                            <tr><th>Date of Birth</th><td>@(Model.Patient.Person?.Dob?.ToString("dd MMM yyyy") ?? "-")</td></tr>
                            <tr><th>Sex</th><td>@(Model.Patient.Person?.Sex?.ToString() ?? "-")</td></tr>
                            <tr><th>NIC</th><td>@(Model.Patient.Person?.Nic ?? "-")</td></tr>
                            <tr><th>Mobile</th><td>@(Model.Patient.Person?.Mobile ?? "-")</td></tr>
                            <tr><th>Phone</th><td>@(Model.Patient.Person?.Phone ?? "-")</td></tr>
                            <tr><th>PHN</th><td>@(Model.Patient.PatientId?.ToString() ?? Model.Patient.Phn ?? "-")</td></tr>
                            <tr><th>Registered</th><td>@(Model.Patient.CreatedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "-")</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-white fw-semibold">Recent Bills (@Model.RecentBills.Count)</div>
                <div class="card-body p-0">
                    @if (!Model.RecentBills.Any())
                    {
                        <div class="p-4 text-center text-muted">No bills found for this patient.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Bill</th>
                                        <th>Date</th>
                                        <th>Items</th>
                                        <th class="text-end">Net Total</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in Model.RecentBills)
                                    {
                                        <tr>
                                            <td>@b.Id</td>
                                            <td>@(b.CreatedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                                            <td>@(b.BillItems?.Count ?? 0)</td>
                                            <td class="text-end">@b.NetTotal.ToString("N2")</td>
                                            <td class="text-center">
                                                @if (b.Paid) { <span class="badge bg-success">Paid</span> }
                                                else if (b.Cancelled) { <span class="badge bg-danger">Cancelled</span> }
                                                else { <span class="badge bg-warning text-dark">Pending</span> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Patient not found.</div>
    <a asp-page="/patients/Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Patients</a>
}