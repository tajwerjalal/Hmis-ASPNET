<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HMIS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --auth-navy: #0b2545;
            --auth-navy-2: #123b66;
            --auth-blue: #1d6fb8;
            --auth-accent: #4da3e8;
            --auth-ink: #14283f;
            --auth-muted: #6b7f95;
            --auth-line: #dbe6f2;
            --auth-soft: #f3f8fd;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; padding: 0; }
        body.auth-body {
            min-height: 100vh;
            font-family: 'Inter', 'Segoe UI', Tahoma, Arial, sans-serif;
            color: var(--auth-ink);
            background: #eaf2fa;
            -webkit-font-smoothing: antialiased;
        }

        .auth-brand-mark {
            display: inline-flex; align-items: center; justify-content: center;
            width: 46px; height: 46px; border-radius: 13px;
            background: #fff; overflow: hidden; flex-shrink: 0;
            box-shadow: 0 8px 18px rgba(5, 24, 46, .22);
        }
        .auth-brand-mark img { width: 100%; height: 100%; object-fit: cover; }

        .auth-field { margin-bottom: 1.05rem; }
        .auth-field > label {
            display: block; font-size: .76rem; font-weight: 700;
            letter-spacing: .35px; text-transform: uppercase;
            color: #50667f; margin-bottom: .4rem;
        }
        .auth-input-wrap { position: relative; }
        .auth-input-wrap > i {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            color: #8aa0b8; font-size: .95rem; pointer-events: none;
        }
        .auth-input {
            width: 100%; height: 48px; border: 1px solid var(--auth-line);
            border-radius: 11px; background: #fbfdff; color: var(--auth-ink);
            padding: 0 46px 0 42px; font-size: .92rem; font-weight: 500;
            transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
        }
        .auth-input::placeholder { color: #9aadc0; font-weight: 400; }
        .auth-input:focus {
            outline: none; background: #fff; border-color: #7db2e2;
            box-shadow: 0 0 0 4px rgba(29, 111, 184, .10);
        }
        .auth-select {
            width: 100%; height: 48px; border: 1px solid var(--auth-line);
            border-radius: 11px; background: #fbfdff; color: var(--auth-ink);
            padding: 0 40px 0 42px; font-size: .92rem; font-weight: 500;
            appearance: none; cursor: pointer;
            transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
        }
        .auth-select:focus {
            outline: none; background: #fff; border-color: #7db2e2;
            box-shadow: 0 0 0 4px rgba(29, 111, 184, .10);
        }
        .auth-input-wrap .auth-chevron {
            position: absolute; right: 14px; left: auto; top: 50%;
            transform: translateY(-50%); font-size: .7rem; color: #8aa0b8;
        }
        .auth-eye {
            position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
            width: 34px; height: 34px; border: 0; border-radius: 8px;
            background: transparent; color: #8aa0b8; cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center;
        }
        .auth-eye:hover { background: #eef5fc; color: var(--auth-blue); }

        .auth-check { display: flex; align-items: center; gap: .55rem; }
        .auth-check input { width: 17px; height: 17px; margin: 0; accent-color: var(--auth-blue); }
        .auth-check label { font-size: .84rem; color: #5a7088; margin: 0; cursor: pointer; }

        .auth-submit {
            width: 100%; height: 50px; border: 0; border-radius: 11px;
            background: linear-gradient(135deg, #174e84 0%, #1d6fb8 55%, #2f8bd8 100%);
            color: #fff; font-size: .95rem; font-weight: 700; letter-spacing: .25px;
            display: inline-flex; align-items: center; justify-content: center; gap: .55rem;
            box-shadow: 0 12px 24px rgba(23, 78, 132, .26);
            transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
        }
        .auth-submit:hover {
            transform: translateY(-1px); filter: brightness(1.05);
            box-shadow: 0 16px 30px rgba(23, 78, 132, .32);
        }
        .auth-submit:active { transform: translateY(0); }
        .auth-submit:disabled { opacity: .75; cursor: wait; transform: none; }

        .auth-alert {
            border: 0; border-radius: 10px; padding: .7rem .85rem;
            font-size: .82rem; font-weight: 500;
        }
        .auth-alert-danger { background: #fdecec; color: #a12828; border-left: 3px solid #d64545; }
        .auth-alert-info { background: #eaf4ff; color: #17558f; border-left: 3px solid #3f8fd8; }
        .auth-alert-warning { background: #fff7e6; color: #8a5b00; border-left: 3px solid #e2a53a; }

        .auth-link { color: var(--auth-blue); font-weight: 600; text-decoration: none; }
        .auth-link:hover { color: #124f8a; text-decoration: underline; }

        @@media (max-width: 575.98px) {
            .auth-input, .auth-select { height: 46px; }
        }
    </style>

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="auth-body">
    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
