<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HMIS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <style>
        body { background-color: #f5f6fa; font-family: 'Segoe UI', Tahoma, Arial, sans-serif; }
        .sidebar {
            background: linear-gradient(180deg, #0d2137 0%, #123355 100%);
            height: 100vh;
            color: #fff;
            position: fixed;
            top: 0; left: 0; width: 250px;
            overflow-y: auto;
            padding-bottom: 2rem;
        }
        .sidebar .brand { padding: 1.2rem 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.1); font-size: 1.15rem; font-weight: 600; }
        .sidebar .brand small { display: block; font-size: .7rem; font-weight: 300; color: #9fb3c8; }
        .sidebar a.nav-link { color: #c7d6e5; padding: .65rem 1.2rem; font-size: .9rem; }
        .sidebar a.nav-link:hover { background: rgba(255,255,255,0.06); color: #fff; }
        .sidebar a.nav-link.active { background: #1d6fb8; color: #fff; }
        .sidebar .nav-head { color: #6f8aa3; font-size: .7rem; text-transform: uppercase; letter-spacing: .5px; padding: 1rem 1.2rem .25rem; font-weight: 600; }
        .sidebar a.nav-link i { width: 22px; text-align: center; margin-right: 6px; }
        .menu-group > .menu-parent { display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; }
        .menu-group > .menu-parent > .bi-chevron-down { width: auto; margin-right: 0; font-size: .75rem; color: #8fa8bf; transition: transform .2s ease; }
        .menu-group.open > .menu-parent { background: rgba(255,255,255,0.08); color: #fff; }
        .menu-group.open > .menu-parent > .bi-chevron-down { transform: rotate(180deg); }
        .submenu { display: none; }
        .menu-group.open > .submenu { display: block; }
        .submenu .nav-link { padding-left: 2.6rem; font-size: .86rem; }
        .submenu .nav-link::before { content: "\2022"; margin-right: 7px; color: #7e97ae; }
        .submenu .menu-group .submenu .nav-link { padding-left: 3.7rem; font-size: .84rem; }
        .submenu .menu-group .submenu .submenu .nav-link { padding-left: 4.8rem; }
        .submenu .menu-group > .menu-parent { padding-left: 1.8rem; font-size: .84rem; color: #cfe0f0; font-weight: 600; }
        .submenu .menu-group > .menu-parent i { width: 18px; margin-right: 4px; }
        .submenu .menu-group > .menu-parent > .bi-chevron-down { color: #8fa8bf; margin-right: 0; }
        .menu-group.opd-flow .submenu .nav-link::before { content: none; }
        .submenu .nav-link .step { display: inline-block; width: 20px; font-size: .68rem; font-weight: 600; color: #9fb3c8; }
        .submenu .nav-link.active .step { color: #bcd6ee; }
        .submenu .nav-link.active { background: #1d6fb8; color: #fff; }
        .main-content { margin-left: 250px; padding: 1rem 1.5rem; }
        .topbar { background: #fff; padding: .65rem 1.2rem; border-radius: .5rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
        .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.08); border-radius: .5rem; }
        .stat-card .icon { width: 48px; height: 48px; border-radius: .5rem; display:flex; align-items:center; justify-content:center; font-size:1.4rem; }
        .table th { font-size: .78rem; text-transform: uppercase; letter-spacing: .3px; color: #6c757d; }
        .form-label { font-size: .82rem; font-weight: 600; color: #495057; }
        @@media print { .sidebar, .topbar, .no-print { display: none !important; } .main-content { margin-left: 0 !important; padding: 0 !important; } }
        @@media (max-width: 992px) { .sidebar { position: static; min-height: auto; width: 100%; } .main-content { margin-left: 0; } }
    </style>
</head>
<body>
    <div class="d-flex">
        <nav class="sidebar">
