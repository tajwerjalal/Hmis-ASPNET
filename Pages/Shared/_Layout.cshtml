    <script>
        $(function () {
            function toggleGroup($trigger, force) {
                var $group = $trigger.closest('.menu-group');
                var wasOpen = $group.hasClass('open');
                if (force && force !== 'open') return;
                if (force || (!wasOpen)) {
                    $group.addClass('open');
                } else {
                    $group.removeClass('open');
                }
            }

            $('.menu-parent').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                toggleGroup($(this));
            });

            var path = (window.location.pathname || '/').toLowerCase();
            $('.sidebar .submenu a.nav-link').each(function () {
                var href = (this.getAttribute('href') || '').toLowerCase();
                var match;
                if (href === '/' || href === '') {
                    match = (path === '/' || path === '');
                } else {
                    match = (path === href || path.indexOf(href + '/') === 0);
                }
                if (match) {
                    // 1. Mark ONLY the exact leaf as active
                    $(this).addClass('active');

                    // 2. Expand all ancestor menu-groups
                    var $leafGroup = $(this).closest('.menu-group');
                    $leafGroup.addClass('open');
                    $(this).parents('.menu-group').each(function () {
                        $(this).addClass('open');
                    });

                    // 3. Mark DIRECT PARENT group with distinct class (not .active)
                    $leafGroup.addClass('active-parent');

                    // 4. Higher ancestors get only .open (styled separately via CSS)
                }
            });

            // Mobile sidebar toggle
            var $sidebar = $('.sidebar');
            var $overlay = $('.sidebar-overlay');
            var $toggle = $('.sidebar-toggle');

            function setSidebar(open) {
                $sidebar.toggleClass('open', open);
                $overlay.toggleClass('open', open);
                $toggle.attr('aria-expanded', open ? 'true' : 'false');
            }

            $toggle.on('click', function () {
                setSidebar(!$sidebar.hasClass('open'));
            });

            $overlay.on('click', function () {
                setSidebar(false);
            });

            $('.sidebar a.nav-link').on('click', function () {
                if (window.matchMedia('(max-width: 992px)').matches) {
                    setSidebar(false);
                }
            });

            $(document).on('keyup', function (e) {
                if (e.key === 'Escape') {
                    setSidebar(false);
                }
            });

            $(window).on('resize', function () {
                if (!window.matchMedia('(max-width: 992px)').matches) {
                    setSidebar(false);
                }
            });
        });
    </script>
