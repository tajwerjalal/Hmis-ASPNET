                    <a asp-page="/institutions/Index" class="nav-link sub-link"><i class="bi bi-building"></i> Institutions</a>
                    <a asp-page="/departments/Index" class="nav-link sub-link"><i class="bi bi-diagram-3"></i> Departments</a>
                    <a asp-page="/categories/Index" class="nav-link sub-link"><i class="bi bi-tag"></i> Item Categories</a>
                    <a asp-page="/items/Index" class="nav-link sub-link"><i class="bi bi-box2"></i> Items</a>
                    <a asp-page="/fees/Index" class="nav-link sub-link"><i class="bi bi-currency-exchange"></i> Fees</a>
                    <a asp-page="/pricematrices/Index" class="nav-link sub-link"><i class="bi bi-table"></i> Price Matrix</a>
                    <a asp-page="/rooms/Index" class="nav-link sub-link"><i class="bi bi-door-closed"></i> Rooms &amp; Beds</a>
                    <a asp-page="/roomcategories/Index" class="nav-link sub-link"><i class="bi bi-door-open"></i> Room Categories</a>
                    <a asp-page="/measurementunits/Index" class="nav-link sub-link"><i class="bi bi-rulers"></i> Measurement Units</a>
                    <a asp-page="/Corporate/Companies" class="nav-link sub-link"><i class="bi bi-people"></i> Panel Companies</a>
                    <a asp-page="/Corporate/Services" class="nav-link sub-link"><i class="bi bi-list-check"></i> Panel Services</a>
                    <a asp-page="/Corporate/Rates" class="nav-link sub-link"><i class="bi bi-currency-dollar"></i> Company Rates</a>
                    <a asp-page="/Corporate/Resources" class="nav-link sub-link"><i class="bi bi-files"></i> Resources</a>
                    <a asp-page="/Corporate/ResourceRates" class="nav-link sub-link"><i class="bi bi-gear-wide-connected"></i> Resource Rates</a>
                    <a asp-page="/Corporate/ConsultantRates" class="nav-link sub-link"><i class="bi bi-person-vcard"></i> Consultant Rates</a>
