<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HMIS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; padding: 0; }
        body { background-color: #f5f6fa; font-family: 'Segoe UI', Tahoma, Arial, sans-serif; }
        
        .wrapper { display: flex; min-height: 100vh; width: 100%; }
        
        .sidebar {
            background: linear-gradient(180deg, #0d2137 0%, #123355 100%);
            color: #fff;
            position: fixed;
            top: 0; left: 0; bottom: 0; width: 250px;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1000;
            padding-bottom: 2rem;
        }
        .sidebar::-webkit-scrollbar { width: 6px; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }
        
        .sidebar .brand { 
            padding: 1rem 1.2rem; 
            border-bottom: 1px solid rgba(255,255,255,0.1); 
            font-size: 1.1rem; font-weight: 600; 
            flex-shrink: 0;
        }
        .sidebar .brand small { display: block; font-size: .7rem; font-weight: 300; color: #9fb3c8; margin-top: .25rem; }
        
        .sidebar .nav-head { color: #6f8aa3; font-size: .65rem; text-transform: uppercase; letter-spacing: .5px; padding: .75rem 1.2rem .35rem; font-weight: 600; flex-shrink: 0; }
        
        .sidebar .nav-link { color: #c7d6e5; padding: .55rem 1.2rem; font-size: .85rem; display: flex; align-items: center; gap: .5rem; white-space: nowrap; }
        .sidebar .nav-link:hover { background: rgba(255,255,255,0.06); color: #fff; }
        .sidebar .nav-link i { width: 20px; text-align: center; flex-shrink: 0; font-size: 1rem; }
        
        /* Active leaf */
        .sidebar .nav-link.active { 
            background: #1d6fb8; 
            color: #fff; 
            font-weight: 600; 
            border-left: 3px solid #4da3e8;
        }
        .sidebar .nav-link.active i { color: #fff; }
        
        /* Menu group parent */
        .menu-group > .menu-parent { 
            display: flex; align-items: center; justify-content: space-between; 
            cursor: pointer; user-select: none; 
            padding: .55rem 1.2rem; color: #c7d6e5; font-size: .85rem;
        }
        .menu-group > .menu-parent:hover { background: rgba(255,255,255,0.06); color: #fff; }
        .menu-group > .menu-parent i { width: 20px; text-align: center; flex-shrink: 0; }
        .menu-group > .menu-parent > .bi-chevron-down { 
            width: auto; margin-left: auto; font-size: .7rem; color: #8fa8bf; 
            transition: transform .2s ease; flex-shrink: 0;
        }
        .menu-group.open > .menu-parent > .bi-chevron-down { transform: rotate(180deg); color: #b8d0e8; }
        
        /* Active parent indicator */
        .menu-group.active-parent > .menu-parent { 
            background: rgba(29, 111, 184, 0.15); 
            color: #cfe0f0; 
            font-weight: 500; 
            border-left: 3px solid #2a7fd4;
        }
        .menu-group.active-parent > .menu-parent > .bi-chevron-down { color: #6db3f2; }
        
        /* Open ancestor indicator */
        .menu-group.open > .menu-parent { 
            background: rgba(255,255,255,0.04); 
            color: #b8d0e8; 
        }
        
        /* Submenu */
        .submenu { display: none; overflow: hidden; }
        .menu-group.open > .submenu { display: block; animation: slideDown .15s ease; }
        @@keyframes slideDown { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
        
        .submenu .nav-link { padding: .45rem 1.2rem .45rem 2.8rem; font-size: .8rem; }
        .submenu .nav-link::before { content: none; }
        .submenu .menu-group > .menu-parent { padding: .45rem 1.2rem .45rem 2.2rem; font-size: .78rem; color: #cfe0f0; font-weight: 600; }
        .submenu .menu-group > .menu-parent i { width: 16px; margin-right: 4px; }
        .submenu .menu-group > .menu-parent > .bi-chevron-down { color: #8fa8bf; }
        .submenu .menu-group .submenu .nav-link { padding-left: 3.4rem; font-size: .78rem; }
        .submenu .menu-group .submenu .submenu .nav-link { padding-left: 4rem; }
        .menu-group.opd-flow .submenu .nav-link { padding-left: 2.8rem; }
        
        .submenu .nav-link .step { 
            display: inline-flex; align-items: center; justify-content: center; 
            width: 18px; height: 18px; font-size: .6rem; font-weight: 700; 
            color: #9fb3c8; background: rgba(255,255,255,0.1); border-radius: 3px; 
            flex-shrink: 0; margin-right: .5rem;
        }
        .submenu .nav-link.active .step { color: #fff; background: rgba(255,255,255,0.2); }
        
        /* Main content */
        .main-content { 
            margin-left: 250px; 
            width: calc(100% - 250px); 
            min-width: 0; 
            min-height: 100vh;
            padding: 0.5rem 1.5rem; 
            background: #f5f6fa;
        }
        .topbar { 
            background: #fff; padding: .55rem 1.2rem; border-radius: .5rem; 
            display: flex; justify-content: space-between; align-items: center; 
            gap: .5rem; flex-wrap: wrap; row-gap: .35rem;
            margin-bottom: 0.5rem; box-shadow: 0 1px 3px rgba(0,0,0,.05); 
            flex-shrink: 0;
        }
        .sidebar-toggle { color: #0d2137; font-size: 1.5rem; line-height: 1; text-decoration: none; }
        .sidebar-toggle:hover { color: #1d6fb8; }
        .sidebar-overlay { display: none; }
        .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.06); border-radius: .5rem; }
        .stat-card .icon { width: 44px; height: 44px; border-radius: .5rem; display:flex; align-items:center; justify-content:center; font-size:1.25rem; }
        .table th { font-size: .75rem; text-transform: uppercase; letter-spacing: .3px; color: #6c757d; }
        .form-label { font-size: .8rem; font-weight: 600; color: #495057; }
        
        /* Responsive */
        @@media (max-width: 992px) { 
            .sidebar { position: fixed; left: -250px; width: 250px; height: 100vh; transition: left .3s ease; box-shadow: 4px 0 20px rgba(0,0,0,.15); }
            .sidebar.open { left: 0; }
            .main-content { margin-left: 0; width: 100%; }
            .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 999; }
            .sidebar-overlay.open { display: block; }
        }
        @@media print { .sidebar, .topbar, .no-print { display: none !important; } .main-content { margin-left: 0 !important; width: 100% !important; padding: 0 !important; } }
    </style>
</head>
