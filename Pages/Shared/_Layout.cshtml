                            <a asp-page="/lab/SampleCollection" class="nav-link sub-link"><i class="bi bi-eyedropper"></i> Sample Collection Entry</a>
                            <a asp-page="/lab/TestResultEntry" class="nav-link sub-link"><i class="bi bi-clipboard2-check"></i> Test Result Entry</a>
                            <a asp-page="/lab/PatientInquiry" class="nav-link sub-link"><i class="bi bi-person-search"></i> Patient Inquiry</a>
                        </div>
                    </div>

                    <div class="menu-group">
                        <a href="javascript:void(0)" class="nav-link menu-parent">
                            <span><i class="bi bi-graph-up"></i> Reports</span>
                            <i class="bi bi-chevron-down"></i>
                        </a>
                        <div class="submenu">
