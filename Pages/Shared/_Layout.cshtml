                <img src="~/images/logo.jpg" alt="Hospital Logo" style="max-height:56px; max-width:100%; width:auto; height:auto; border-radius:4px; display:block;" />
                <span>HMIS<small style="display:block; margin-top:2px; font-size:.66rem; font-weight:400; color:#9fb3c8;">Hospital Management System</small></span>
            </div>
            <div class="nav-head">Navigation</div>

            <div class="menu-group">
