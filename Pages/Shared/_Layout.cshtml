                <div class="fw-semibold text-secondary">@(ViewData["Title"]?.ToString() ?? "HMIS")</div>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-secondary small" style="font-weight:500;">@DateTime.Now.ToString("dd MMM yyyy")</span>
                    <partial name="_LoginPartial" />
                </div>
            </div>
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(function () {
            function toggleGroup($trigger, force) {
                var $group = $trigger.closest('.menu-group');
                var wasOpen = $group.hasClass('open');
                if (force && force !== 'open') return;
                if (force || (!wasOpen)) {
                    $group.addClass('open');
                    $group.find('.menu-parent').addClass('active');
                } else {
                    $group.removeClass('open');
                    $group.find('.menu-parent').removeClass('active');
                }
            }

            $('.menu-parent').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                toggleGroup($(this));
            });

            var path = (window.location.pathname || '/').toLowerCase();
            $('.sidebar .submenu a.nav-link').each(function () {
                var href = (this.getAttribute('href') || '').toLowerCase();
                var match;
                if (href === '/' || href === '') {
                    match = (path === '/' || path === '');
                } else {
                    match = (path === href || path.indexOf(href + '/') === 0);
                }
                if (match) {
                    $(this).addClass('active');
                    $(this).closest('.menu-group').addClass('open');
                    $(this).closest('.menu-group').find('.menu-parent').addClass('active');
                    $(this).parents('.menu-group').each(function () {
                        $(this).addClass('open');
                        $(this).children('.menu-parent').addClass('active');
                    });
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
