@model HmisWeb.Pages.Shared.IPagedGrid
@{
    // Rebuild the current query string minus the paging parameters, so the
    // pager keeps every filter of the page it sits on (search, status,
    // department, layout mode, ...). The canonical key is "PageNumber"
    // ("page" cannot be used - it is the reserved Razor Pages route value),
    // and the legacy "Pg" key is emitted too so the older billing screens
    // keep their behaviour.
    var q = Context.Request.Query
        .Where(kv => !string.Equals(kv.Key, "pagenumber", StringComparison.OrdinalIgnoreCase)
                  && !string.Equals(kv.Key, "pg", StringComparison.OrdinalIgnoreCase)
                  && !string.Equals(kv.Key, "pagesize", StringComparison.OrdinalIgnoreCase))
        .Select(kv => Uri.EscapeDataString(kv.Key) + "=" + Uri.EscapeDataString(kv.Value.ToString()))
        .ToList();

    Func<int, int, string> link = (page, size) =>
    {
        var parts = q.ToList();
        var no = Math.Max(1, page);        // a disabled Prev link must not emit page 0
        parts.Add("PageNumber=" + no);
        parts.Add("Pg=" + no);
        parts.Add("PageSize=" + size);
        return "?" + string.Join("&", parts);
    };

    var window = 2;                       // pages shown around the current one
    var current = Model.Page;
    var start = Math.Max(1, current - window);
    var end = Math.Min(Model.TotalPages, current + window);
}

@if (Model.TotalCount > 0)
{
    <div class="card mt-2">
        <div class="card-body py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="text-secondary small">
                Showing <strong>@Model.FirstRow</strong>&ndash;<strong>@Model.LastRow</strong>
                of <strong>@Model.TotalCount</strong> row(s) &middot; page @current of @Model.TotalPages
            </div>
            <div class="d-flex align-items-center gap-2">
                <form method="get" class="d-flex align-items-center gap-2">
                    @foreach (var kv in Context.Request.Query)
                    {
                        if (!string.Equals(kv.Key, "pagenumber", StringComparison.OrdinalIgnoreCase)
                            && !string.Equals(kv.Key, "pg", StringComparison.OrdinalIgnoreCase)
                            && !string.Equals(kv.Key, "pagesize", StringComparison.OrdinalIgnoreCase))
                        {
                            <input type="hidden" name="@kv.Key" value="@kv.Value" />
                        }
                    }
                    <input type="hidden" name="PageNumber" value="@current" />
                    <input type="hidden" name="Pg" value="@current" />
                    <label class="text-secondary small mb-0">Rows</label>
                    <select name="PageSize" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit();">
                        @foreach (var size in new[] { 25, 50, 100, 200 })
                        {
                            if (Model.PageSize == size)
                            {
                                <option value="@size" selected>@size</option>
                            }
                            else
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    </select>
                </form>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            <a class="page-link" href="@link(current - 1, Model.PageSize)">Prev</a>
                        </li>
                        @if (start > 1)
                        {
                            <li class="page-item"><a class="page-link" href="@link(1, Model.PageSize)">1</a></li>
                            @if (start > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                        }
                        @for (var p = start; p <= end; p++)
                        {
                            var pageNo = p;
                            <li class="page-item @(pageNo == current ? "active" : "")">
                                <a class="page-link" href="@link(pageNo, Model.PageSize)">@pageNo</a>
                            </li>
                        }
                        @if (end < Model.TotalPages)
                        {
                            @if (end < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                            <li class="page-item"><a class="page-link" href="@link(Model.TotalPages, Model.PageSize)">@Model.TotalPages</a></li>
                        }
                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link" href="@link(current + 1, Model.PageSize)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
}
