@page "/hospital/Reports/CompanySummary"
@model HmisWeb.Pages.Hospital.Reports.CompanySummaryModel
@{
    ViewData["Title"] = "Company Wise Summary Report";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-pie-chart me-2 text-primary"></i>Company Wise Summary Report</h4>
        <div class="text-secondary small">Migrated from VFP report us0205</div>
    </div>
    <a asp-page="/Hospital/Reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Reports</a>
</div>

<form method="get" class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Date from</label>
                <input asp-for="FromDate" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Date to</label>
                <input asp-for="ToDate" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Company</label>
                <input asp-for="CompanyId" class="form-control form-control-sm" placeholder="Institution id (blank = all)" />
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>View</button>
                <a asp-page="/Hospital/Reports/CompanySummary" asp-page-handler="Export" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-filetype-csv me-1"></i>CSV
                </a>
                @if (Model.Rows.Any())
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="csPrint()">
                        <i class="bi bi-printer me-1"></i>Print
                    </button>
                }
            </div>
        </div>
    </div>
</form>

@if (!Model.Searched)
{
    <div class="alert alert-info py-2"><i class="bi bi-info-circle me-1"></i>Choose a date range and press View.</div>
}
else if (!Model.Rows.Any())
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>No Result Found</div>
}
else
{
    <div class="card">
        <div class="card-header bg-white fw-semibold d-flex flex-wrap justify-content-between gap-2">
            <span>@Model.Rows.Count company group(s)</span>
            <span>@Model.PeriodText</span>
            <span>Total: <strong>@Model.GrandTests</strong> test(s) &mdash; <strong>@Model.GrandTotal.ToString("N2")</strong></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" id="csTable">
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Company</th>
                            <th class="text-end">OPD Tests</th>
                            <th class="text-end">OPD Amount</th>
                            <th class="text-end">IPD Tests</th>
                            <th class="text-end">IPD Amount</th>
                            <th class="text-end">Total Tests</th>
                            <th class="text-end">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td>@r.Company</td>
                                <td class="text-end">@r.OpdTests</td>
                                <td class="text-end">@r.OpdAmount.ToString("N2")</td>
                                <td class="text-end">@r.IpdTests</td>
                                <td class="text-end">@r.IpdAmount.ToString("N2")</td>
                                <td class="text-end"><strong>@r.TotalTests</strong></td>
                                <td class="text-end"><strong>@r.TotalAmount.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th>Grand total</th>
                            <th class="text-end">@Model.Rows.Sum(r => r.OpdTests)</th>
                            <th class="text-end">@Model.Rows.Sum(r => r.OpdAmount).ToString("N2")</th>
                            <th class="text-end">@Model.Rows.Sum(r => r.IpdTests)</th>
                            <th class="text-end">@Model.Rows.Sum(r => r.IpdAmount).ToString("N2")</th>
                            <th class="text-end">@Model.GrandTests</th>
                            <th class="text-end">@Model.GrandTotal.ToString("N2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function csPrint() {
            var w = window.open('', '_blank', 'width=1000,height=1000');
            if (!w) { alert('Allow pop-ups to print the report.'); return; }
            var css = 'body{font-family:Segoe UI,Arial,sans-serif;font-size:10pt;padding:16mm;color:#000}' +
                      'table{border-collapse:collapse;width:100%;font-size:9pt}' +
                      'th,td{border:1px solid #999;padding:3px 5px}' +
                      'th{background:#f0f0f0;text-align:left}' +
                      'h1{font-size:13pt;text-align:center;margin:0 0 2px}' +
                      '.sub{text-align:center;color:#555;margin-bottom:8px}' +
                      'tfoot{font-weight:bold}' +
                      '@@page{margin:12mm}';
            w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Company Summary</title><style>' + css + '</style></head><body>');
            w.document.write('<h1>COMPANY WISE SUMMARY</h1>');
            w.document.write('<div class="sub">Ultrasound &nbsp;|&nbsp; @Model.PeriodText</div>');
            w.document.write(document.getElementById('csTable').innerHTML);
            w.document.write('</body></html>');
            w.document.close();
            w.focus();
            setTimeout(function () { w.print(); }, 400);
        }
    </script>
}