@page "/hospital/indent"
@model HmisWeb.Pages.Hospital.IndentModel
@using HmisWeb.Data.Enums
@{
    ViewData["Title"] = "New Indent";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-file-earmark-text me-1 text-primary"></i>Department Indent / Invoice</h4>
        <div class="text-secondary small">Raise an indent for procedures, tests or services. The patient pays at the Cashier and returns with the receipt.</div>
    </div>
    <form method="post" asp-page-handler="StartNew" class="d-inline">
        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>New indent</button>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@Model.Success</div>
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Message</div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-person me-1 text-primary"></i>Step 1 - Find Patient</span>
                <a href="javascript:void(0)" onclick="toggleNewPatient(true)" class="btn btn-sm btn-outline-success"><i class="bi bi-person-plus me-1"></i>Add New Patient</a>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="SearchPatients" class="d-flex gap-2">
                    <input asp-for="PatientSearch" class="form-control" placeholder="Search by PHN, mobile or name..." />
                    <button type="submit" class="btn btn-primary text-nowrap"><i class="bi bi-search me-1"></i></button>
                </form>

                @if (Model.PatientResults.Any())
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>PHN</th><th>Name</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PatientResults)
                                {
                                    <tr>
                                        <td>@(p.PatientId?.ToString() ?? "-")</td>
                                        <td>@(p.Person?.NameWithInitials ?? p.Person?.Name ?? "")</td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="SelectPatient">
                                                <input type="hidden" asp-for="SelectedPatientId" value="@p.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Select</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (!Model.PatientResults.Any() && !string.IsNullOrEmpty(Model.PatientSearch))
                {
                    <div class="alert alert-info py-2 mt-3">
                        <i class="bi bi-info-circle me-1"></i>No patient found for "<b>@Model.PatientSearch</b>".
                        <a href="javascript:void(0)" onclick="toggleNewPatient(true)" class="fw-semibold text-decoration-underline">Add a new walk-in patient?</a>
                    </div>
                }

                <div id="newPatientSection" style="display:none">
                    <hr />
                    <div class="card mb-3">
                        <div class="card-header bg-white fw-semibold"><i class="bi bi-person-plus me-1 text-success"></i>Register a new (walk-in) patient</div>
                        <div class="card-body">
                            <form method="post" asp-page-handler="CreatePatient" class="row g-2">
                                <div class="col-md-4"><input asp-for="NewName" class="form-control form-control-sm" placeholder="Full name *" /></div>
                                <div class="col-md-4"><input asp-for="NewNameWithInitials" class="form-control form-control-sm" placeholder="Name with initials" /></div>
                                <div class="col-md-4"><input asp-for="NewNic" class="form-control form-control-sm" placeholder="NIC" /></div>
                                <div class="col-md-4"><input asp-for="NewMobile" class="form-control form-control-sm" placeholder="Mobile" /></div>
                                <div class="col-md-4"><input asp-for="NewPhone" class="form-control form-control-sm" placeholder="Phone" /></div>
                                <div class="col-md-4">
                                    <select asp-for="NewSex" asp-items="Html.GetEnumSelectList<Sex>()" class="form-select form-select-sm">
                                        <option value="">-- Sex --</option>
                                    </select>
                                </div>
                                <div class="col-12 d-flex gap-2 align-items-center">
                                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-plus-lg me-1"></i>Add & start indent</button>
                                    <a href="javascript:void(0)" onclick="toggleNewPatient(false)" class="small text-secondary">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.SelectedPatient != null)
        {
            <div class="card">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-cash-stack me-1 text-success"></i>Patient indents</span>
                    @if (Model.HasUnpaidIndents)
                    {
                        <span class="badge bg-warning text-dark">Has unpaid indents</span>
                    }
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>#</th><th>Visit</th><th>Dept</th><th class="text-end">Amount</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @if (!Model.PatientIndents.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-3">No indents for this patient yet.</td></tr>
                                }
                                @foreach (var i in Model.PatientIndents)
                                {
                                    <tr class="@(!i.Paid ? "table-warning" : "")">
                                        <td>@(i.InvoiceNumber ?? ("#" + i.Id))</td>
                                        <td>@(i.VisitId?.ToString() ?? "-")</td>
                                        <td class="small">@(string.IsNullOrEmpty(i.DepartmentName) ? "-" : i.DepartmentName)</td>
                                        <td class="text-end">@i.Amount.ToString("N2")</td>
                                        <td>
                                            @if (i.Paid)
                                            {
                                                <span class="badge bg-success">Paid</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Unpaid</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white">
                    @if (Model.HasUnpaidIndents)
                    {
                        <div class="alert alert-warning py-2 mb-0 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-exclamation-triangle me-1"></i>This patient has <strong>@Model.PatientIndents.Count(i => !i.Paid)</strong> unpaid indent(s). You can create a new indent below or collect payment for existing ones.</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary small mb-0">No unpaid indents. You can create a new indent below.</div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        @if (Model.SelectedPatient == null)
        {
            <div class="card">
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-person-plus fs-1 d-block mb-2"></i>
                    Search and select a patient to raise an indent.
                </div>
            </div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <div class="text-secondary small">Patient</div>
                            <div class="fw-semibold">@(Model.SelectedPatient.Person?.NameWithInitials ?? Model.SelectedPatient.Person?.Name ?? "")</div>
                            <div class="small text-secondary">PHN: @(Model.SelectedPatient.PatientId?.ToString() ?? "-") @(Model.SelectedPatient.Person?.Mobile != null ? "&middot; " + Model.SelectedPatient.Person.Mobile : "")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-0">Visit (unique visit no)</label>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-0">Department</label>
                        </div>
                    </div>
                    <div class="row g-2 align-items-end mt-1">
                        <div class="col-md-4">
                            <div class="border rounded p-2">
                                <div class="fw-semibold">@(Model.SelectedPatient.Person?.NameWithInitials ?? Model.SelectedPatient.Person?.Name ?? "")</div>
                                <div class="small text-secondary">PHN @(Model.SelectedPatient.PatientId?.ToString() ?? "-")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select asp-for="SelectedEncounterId" id="selVisit" class="form-select">
                                @if (!Model.Visits.Any())
                                {
                                    <option value="">No visit - create on save</option>
                                }
                                else
                                {
                                    <option value="">-- choose visit --</option>
                                    @foreach (var v in Model.Visits)
                                    {
                                        <option value="@v.Id">
                                            #@v.Id &middot; @v.EncounterType @(v.EncounterDate?.ToString("dd/MM/yyyy") ?? "")
                                        </option>
                                    }
                                }
                            </select>
                            <div class="form-text small">Each indent is linked to this visit no.</div>
                        </div>
                        <div class="col-md-4">
                            <select asp-for="DepartmentId" id="selDept" asp-items="@(new SelectList(Model.Departments, "Id", "Name"))" class="form-select">
                                <option value="">-- department --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-stack me-1 text-primary"></i>Step 2 - Add procedures / tests</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="SearchItems" class="d-flex gap-2">
                        <input type="hidden" asp-for="DepartmentId" />
                        <input asp-for="ItemSearch" class="form-control" placeholder="Search investigations / services / procedures..." />
                        <button type="submit" class="btn btn-primary text-nowrap"><i class="bi bi-search me-1"></i>Search</button>
                    </form>

                    @if (Model.ItemResults.Any())
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>Code</th><th>Service / Procedure</th><th class="text-end">Rate</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var it in Model.ItemResults)
                                    {
                                        <tr>
                                            <td>@it.Code</td>
                                            <td>@(it.PrintName ?? it.Name)</td>
                                            <td class="text-end">@(it.Total?.ToString("N2") ?? "-")</td>
                                            <td class="text-end">
                                                <form method="post" asp-page-handler="AddItem">
                                                    <input type="hidden" asp-for="DepartmentId" />
                                                    <input type="hidden" asp-for="SelectedItemId" value="@it.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            @if (Model.DisplayCart.Any())
            {
                <div class="card">
                    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-cart3 me-1 text-success"></i>Indent items</span>
                        <span class="badge bg-secondary">@Model.DisplayCart.Count item(s)</span>
                    </div>
                    <div class="card-body p-0">
                        <form method="post" asp-page-handler="UpdateCart">
                            <input type="hidden" asp-for="SelectedEncounterId" id="hidVisit" />
                            <input type="hidden" asp-for="DepartmentId" id="hidDept" />
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr><th>Item</th><th class="text-end" style="width:90px">Qty</th><th class="text-end" style="width:120px">Rate</th><th class="text-end" style="width:120px">Amount</th><th style="width:50px"></th></tr>
                                    </thead>
                                    <tbody>
                                        @for (var idx = 0; idx < Model.DisplayCart.Count; idx++)
                                        {
                                            var c = Model.DisplayCart[idx];
                                            <tr>
                                                <td class="small">
                                                    @c.ItemName
                                                    <div class="text-muted">@c.Code</div>
                                                </td>
                                                <td class="text-end">
                                                    <input type="number" name="Cart[@idx].ItemId" value="@c.ItemId" hidden />
                                                    <input type="number" name="Cart[@idx].Qty" value="@c.Qty" min="1" class="form-control form-control-sm text-end" />
                                                </td>
                                                <td class="text-end">
                                                    <input type="number" name="Cart[@idx].Rate" value="@c.Rate.ToString("0.00")" step="0.01" min="0" class="form-control form-control-sm text-end" />
                                                </td>
                                                <td class="text-end fw-semibold">@((c.Qty * c.Rate).ToString("N2"))</td>
                                                <td class="text-end">
                                                    <button type="submit" name="ItemToRemove" value="@c.ItemId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <input asp-for="Comments" class="form-control form-control-sm" placeholder="Note for this indent (optional)" style="width:320px" />
                                </div>
                                <div class="text-end">
                                    <div class="text-muted small">Total</div>
                                    <div class="fs-4 fw-bold text-primary">@Model.Total.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="card-footer bg-white d-flex gap-2">
                                <button type="submit" formaction="@Url.Page("/hospital/indent", "Save")" class="btn btn-success"><i class="bi bi-save me-1"></i>Raise Indent (patient pays at Cashier)</button>
                                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat me-1"></i>Recalculate</button>
                                <button type="submit" formaction="@Url.Page("/hospital/indent", "Clear")" class="btn btn-outline-danger ms-auto"><i class="bi bi-trash me-1"></i>Clear items</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        const selVisit = document.getElementById('selVisit');
        const selDept = document.getElementById('selDept');
        const hidVisit = document.getElementById('hidVisit');
        const hidDept = document.getElementById('hidDept');
        if (selVisit && hidVisit) {
            const syncVisit = () => { hidVisit.value = selVisit.value; };
            selVisit.addEventListener('change', syncVisit);
            syncVisit();
        }
        if (selDept && hidDept) {
            const syncDept = () => { hidDept.value = selDept.value; };
            selDept.addEventListener('change', syncDept);
            syncDept();
        }
        function toggleNewPatient(open) {
            var el = document.getElementById('newPatientSection');
            if (el) { el.style.display = open ? '' : 'none'; }
        }
    </script>
}