@page
@model HmisWeb.Pages.Admin.RoleCreateModel
@{
    ViewData["Title"] = "Create Role";
}

<h4>Create Role</h4>

<div class="card mt-3">
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Role Name *</label>
                <input asp-for="Input.Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Privileges (comma separated)</label>
                <input asp-for="Input.Privileges" class="form-control" placeholder="e.g. lab_view,hr_view,admin_view" />
                <div class="form-text">Enter privileges separated by commas. Available: @Model.AvailablePrivileges</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="/Admin/Roles" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
