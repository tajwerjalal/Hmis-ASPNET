@page
@model HmisWeb.Pages.Admin.AddConfigModel
@{
    ViewData["Title"] = "Add Config";
}

<h4>Add Config Option</h4>

<div class="card mt-3">
    <div class="card-body">
        <form method="post">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Name *</label>
                    <input asp-for="Input.Name" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Value</label>
                    <input asp-for="Input.OptionValue" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Scope *</label>
                    <select asp-for="Input.OptionScope" asp-items="Html.GetEnumSelectList<OptionScope>()" class="form-select" required>
                        <option value="">-- Select --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Institution</label>
                    <select asp-for="Input.InstitutionId" asp-items="Model.InstitutionList" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="/Admin/Config" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
