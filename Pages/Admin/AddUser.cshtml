@page
@model HmisWeb.Pages.Admin.AddUserModel
@{
    ViewData["Title"] = "Add User";
}

<h4>Add User</h4>

<div class="card mt-3">
    <div class="card-body">
        <form method="post">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Username *</label>
                    <input asp-for="Input.UserName" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Password *</label>
                    <input asp-for="Input.Password" class="form-control" type="password" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Real Name</label>
                    <input asp-for="Input.RealUserName" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Institution</label>
                    <select asp-for="Input.InstitutionId" asp-items="Model.InstitutionList" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Department</label>
                    <select asp-for="Input.DepartmentId" asp-items="Model.DepartmentList" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Role</label>
                    <select asp-for="Input.WebUserRoleUserId" asp-items="Model.RoleList" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="/Admin/Users" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
