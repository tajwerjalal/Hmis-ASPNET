@page
@model HmisWeb.Pages.Pharmacy.CategoriesModel
@using System.Text.Json
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Item Catalogue";
    var jsonOpts = new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var rowJson = JsonSerializer.Serialize(Model.Rows.Select(r => new {
        id = r.Id, code = r.Code, name = r.Name
    }).ToList(), jsonOpts);
}

<h4 class="mb-3"><i class="fa-solid fa-tags"></i> Item Catalogue <small class="text-muted fs-6">(legacy: CATALOG.DBF)</small></h4>

@if (Model.Message != null)
{
    <div class="alert alert-success py-2"><i class="fa-solid fa-circle-check"></i> @Model.Message</div>
}
@if (Model.Error != null)
{
    <div class="alert alert-danger py-2"><i class="fa-solid fa-circle-exclamation"></i> @Model.Error</div>
}

<div class="card">
    <div class="card-header bg-white">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-1">Search</label>
                <input asp-for="Search" class="form-control form-control-sm" placeholder="Code or catalogue name..." />
            </div>
            <div class="col-md-8 d-flex gap-2 align-items-center pb-1">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-filter"></i> Apply</button>
                <a asp-page="Categories" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-eraser"></i> Clear</a>
                <button type="button" class="btn btn-sm btn-success ms-auto" id="btnAddNew">
                    <i class="fa-solid fa-plus"></i> Add New Catalogue
                </button>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height:72vh; overflow-y:auto;">
            <table class="table table-sm table-striped table-hover mb-0 align-middle" id="catTable">
                <thead class="table-light" style="position:sticky; top:0; z-index:1;">
                    <tr>
                        <th>Code</th>
                        <th>Catalogue</th>
                        <th class="text-end">Drugs</th>
                        <th style="width:86px"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No catalogue matches this search.</td></tr>
                    }
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="ph-row" data-id="@r.Id" style="cursor:pointer" title="Click to edit">
                            <td><code>@r.Code</code></td>
                            <td>@r.Name</td>
                            <td class="text-end">@r.ItemCount</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary ph-edit" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger ph-del"
                                        title="Delete" data-id="@r.Id" data-code="@r.Code" data-name="@r.Name">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white small text-muted">
        Showing @Model.Rows.Count catalogue(s) of 18. Click any row to open its data-entry popup.
    </div>
</div>

<div class="modal fade" id="catModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="Save" id="catForm">
                <input type="hidden" asp-for="Edit.Id" id="Edit_Id" />
                <input type="hidden" asp-for="Search" />
                <div class="modal-header">
                    <h6 class="modal-title" id="catModalTitle">Add Catalogue</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small">Code</label>
                            <input asp-for="Edit.Code" id="Edit_Code" class="form-control form-control-sm" maxlength="20" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small">Catalogue name</label>
                            <input asp-for="Edit.Name" id="Edit_Name" class="form-control form-control-sm" maxlength="200" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form method="post" asp-page-handler="Delete" id="delForm" class="d-none">
    <input type="hidden" name="id" id="del_Id" />
    <input type="hidden" name="Search" value="@Model.Search" />
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.1/sweetalert2.all.min.js"></script>
    <script src="~/js/pharmacy-crud.js"></script>
    <script id="phRows" type="application/json">@Html.Raw(rowJson)</script>
    <script>
        PhCrud.init({
            data: 'phRows',
            modal: 'catModal',
            form: 'catForm',
            title: 'catModalTitle',
            addBtn: 'btnAddNew',
            rowSelector: '#catTable tr.ph-row',
            delSelector: '#catTable .ph-del',
            deleteForm: 'delForm',
            deleteId: 'del_Id',
            label: 'Catalogue',
            fields: ['Id', 'Code', 'Name'],
            deleteTitle: 'Delete this catalogue?',
            deleteNote: 'It cannot be deleted while medicines still use it.'
        });
    </script>
}
