@page
@model HmisWeb.Pages.Pharmacy.AccountsModel
@using System.Text.Json
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Chart of Accounts";
    var jsonOpts = new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var rowJson = JsonSerializer.Serialize(Model.Rows.Select(r => new {
        id = r.Id, code = r.Code, name = r.Name, accountType = r.AccountType,
        level = r.Level, parentCode = r.ParentCode, openingBalance = r.OpeningBalance,
        yearDebit = r.YearDebit, yearCredit = r.YearCredit
    }).ToList(), jsonOpts);
    // Indent by level so the hierarchy is readable in a flat table.
    int IndentFor(int level) => Math.Max(0, level - 1) * 14;
}

<h4 class="mb-3"><i class="fa-solid fa-sitemap"></i> Chart of Accounts <small class="text-muted fs-6">(legacy: chart.spr)</small></h4>

@if (Model.Message != null)
{
    <div class="alert alert-success py-2"><i class="fa-solid fa-circle-check"></i> @Model.Message</div>
}
@if (Model.Error != null)
{
    <div class="alert alert-danger py-2"><i class="fa-solid fa-circle-exclamation"></i> @Model.Error</div>
}

<div class="card">
    <div class="card-header bg-white">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-1">Search</label>
                <input asp-for="Search" class="form-control form-control-sm" placeholder="Code or account name..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Type</label>
                <select asp-for="TypeFilter" class="form-select form-select-sm">
                    <option value="">-- All --</option>
                    <option value="G">Group heading</option>
                    <option value="D">Detail account</option>
                </select>
            </div>
            <div class="col-md-6 d-flex gap-2 align-items-center pb-1">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-filter"></i> Apply</button>
                <a asp-page="Accounts" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-eraser"></i> Clear</a>
                <button type="button" class="btn btn-sm btn-success ms-auto" id="btnAddNew">
                    <i class="fa-solid fa-plus"></i> Add New Account
                </button>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height:72vh; overflow-y:auto;">
            <table class="table table-sm table-striped table-hover mb-0 align-middle" id="accTable">
                <thead class="table-light" style="position:sticky; top:0; z-index:1;">
                    <tr>
                        <th>Code</th>
                        <th>Account</th>
                        <th class="text-center">Type</th>
                        <th class="text-center">Lvl</th>
                        <th class="text-end">Opening</th>
                        <th class="text-end">Year Dr</th>
                        <th class="text-end">Year Cr</th>
                        <th class="text-end">Balance</th>
                        <th class="text-end">Postings</th>
                        <th style="width:86px"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">No account matches these filters.</td></tr>
                    }
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="ph-row @(r.IsGroup ? "fw-semibold" : "")" data-id="@r.Id" style="cursor:pointer" title="Click to edit">
                            <td><code>@r.Code</code></td>
                            <td style="padding-left:@(18 + IndentFor(r.Level))px">
                                @if (r.IsGroup)
                                {
                                    <i class="fa-solid fa-folder text-secondary me-1"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-file-lines text-muted me-1"></i>
                                }
                                @r.Name
                            </td>
                            <td class="text-center small">@r.AccountType</td>
                            <td class="text-center small text-muted">@r.Level</td>
                            <td class="text-end">@r.OpeningBalance.ToString("N2")</td>
                            <td class="text-end">@r.YearDebit.ToString("N2")</td>
                            <td class="text-end">@r.YearCredit.ToString("N2")</td>
                            <td class="text-end">@r.Balance.ToString("N2")</td>
                            <td class="text-end text-muted small">@(r.PostingCount == 0 ? "-" : r.PostingCount.ToString("N0"))</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary ph-edit" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger ph-del"
                                        title="Delete" data-id="@r.Id" data-code="@r.Code" data-name="@r.Name">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white small text-muted">
        Showing @Model.Rows.Count account(s) of 636. Click any row to open its data-entry popup.
    </div>
</div>

<div class="modal fade" id="accModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="Save" id="accForm">
                <input type="hidden" asp-for="Edit.Id" id="Edit_Id" />
                <input type="hidden" asp-for="Search" />
                <input type="hidden" asp-for="TypeFilter" />
                <div class="modal-header">
                    <h6 class="modal-title" id="accModalTitle">Add Account</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label small">Code</label>
                            <input asp-for="Edit.Code" id="Edit_Code" class="form-control form-control-sm" maxlength="20" required />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label small">Name</label>
                            <input asp-for="Edit.Name" id="Edit_Name" class="form-control form-control-sm" maxlength="200" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Type</label>
                            <select asp-for="Edit.AccountType" id="Edit_AccountType" class="form-select form-select-sm">
                                <option value="">--</option>
                                <option value="G">Group heading</option>
                                <option value="D">Detail account</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Level</label>
                            <input asp-for="Edit.Level" id="Edit_Level" type="number" min="1" max="9" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Parent account</label>
                            <input asp-for="Edit.ParentCode" id="Edit_ParentCode" class="form-control form-control-sm"
                                   maxlength="20" list="parentList" placeholder="Leave blank for a top-level account" />
                            <datalist id="parentList">
                                @foreach (var a in Model.AllAccounts.Where(x => x.IsGroup).Take(400))
                                {
                                    <option value="@a.Code">@a.Code - @a.Name</option>
                                }
                            </datalist>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>

                        <div class="col-md-4">
                            <label class="form-label small">Opening balance</label>
                            <input asp-for="Edit.OpeningBalance" id="Edit_OpeningBalance" type="number" step="any" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Year debit</label>
                            <input asp-for="Edit.YearDebit" id="Edit_YearDebit" type="number" step="any" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Year credit</label>
                            <input asp-for="Edit.YearCredit" id="Edit_YearCredit" type="number" step="any" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form method="post" asp-page-handler="Delete" id="delForm" class="d-none">
    <input type="hidden" name="id" id="del_Id" />
    <input type="hidden" name="Search" value="@Model.Search" />
    <input type="hidden" name="TypeFilter" value="@Model.TypeFilter" />
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.1/sweetalert2.all.min.js"></script>
    <script src="~/js/pharmacy-crud.js"></script>
    <script id="phRows" type="application/json">@Html.Raw(rowJson)</script>
    <script>
        PhCrud.init({
            data: 'phRows',
            modal: 'accModal',
            form: 'accForm',
            title: 'accModalTitle',
            addBtn: 'btnAddNew',
            rowSelector: '#accTable tr.ph-row',
            delSelector: '#accTable .ph-del',
            deleteForm: 'delForm',
            deleteId: 'del_Id',
            label: 'Account',
            fields: ['Id', 'Code', 'Name', 'AccountType', 'Level', 'ParentCode',
                     'OpeningBalance', 'YearDebit', 'YearCredit'],
            newDefaults: { Level: 1, AccountType: 'D' },
            deleteTitle: 'Delete this account?',
            deleteNote: 'An account that carries ledger postings or has child accounts cannot be deleted - ' +
                        'that money would disappear from the trial balance.'
        });
    </script>
}
