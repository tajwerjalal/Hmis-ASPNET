@page
@model HmisWeb.Pages.Pharmacy.SaleModel
@{
    ViewData["Title"] = "Pharmacy Sale";
}

<h4 class="mb-3">Pharmacy Sale (POS)</h4>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header"><strong>Item Search</strong></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Search">
                    <div class="input-group mb-2">
                        <input type="text" asp-for="SearchTerm" class="form-control" placeholder="Search by code, name or barcode..." />
                        <button type="submit" class="btn btn-outline-primary">Search</button>
                    </div>
                </form>

                @if (Model.SearchResults.Any())
                {
                    <div style="max-height:300px;overflow-y:auto;" class="mt-2">
                        <table class="table table-sm table-hover">
                            <thead><tr><th>Item</th><th>Code</th><th>Price</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.SearchResults)
                                {
                                    <tr>
                                        <td>@(item.PrintName ?? item.Name)</td>
                                        <td>@item.Code</td>
                                        <td>@(item.Total?.ToString("N2") ?? "0.00")</td>
                                        <td>
                                            <form method="post" asp-page-handler="AddToCart" style="display:inline">
                                                <input type="hidden" name="itemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">+ Add</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header"><strong>Cart</strong></div>
            <div class="card-body p-0">
                @if (Model.Cart.Any())
                {
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr><th>#</th><th>Item</th><th>Qty</th><th>Price</th><th>Total</th><th></th></tr>
                        </thead>
                        <tbody>
                            @{ var idx = 0; }
                            @foreach (var c in Model.Cart)
                            {
                                <tr>
                                    <td>@(idx + 1)</td>
                                    <td>@c.ItemName</td>
                                    <td>@c.Qty</td>
                                    <td>@c.SellingPrice.ToString("N2")</td>
                                    <td>@c.LineTotal.ToString("N2")</td>
                                    <td>
                                        <form method="post" asp-page-handler="RemoveFromCart" style="display:inline">
                                            <input type="hidden" name="index" value="@idx" />
                                            <button type="submit" class="btn btn-sm btn-danger">X</button>
                                        </form>
                                    </td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No items in cart.</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-6"><strong>Sub Total</strong></div>
                    <div class="col-6 text-end">@Model.SubTotal.ToString("N2")</div>
                </div>
                <form method="post" asp-page-handler="Save">
                    <div class="row mb-2 align-items-center">
                        <div class="col-6">
                            <label class="form-label mb-0"><strong>Discount %</strong></label>
                        </div>
                        <div class="col-6">
                            <input type="number" asp-for="DiscountPercent" class="form-control form-control-sm" step="0.01" min="0" max="100" value="@Model.DiscountPercent" />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6"><strong>Discount</strong></div>
                        <div class="col-6 text-end text-danger">- @Model.DiscountAmount.ToString("N2")</div>
                    </div>
                    <hr />
                    <div class="row mb-3">
                        <div class="col-6"><h5 class="mb-0">Net Total</h5></div>
                        <div class="col-6 text-end"><h5 class="mb-0">@Model.NetTotal.ToString("N2")</h5></div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100" @(Model.Cart.Any() ? "" : "disabled")>
                        Save & Complete Sale
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
