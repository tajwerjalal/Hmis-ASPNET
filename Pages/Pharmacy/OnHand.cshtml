@page
@model HmisWeb.Pages.Pharmacy.OnHandModel
@{
    ViewData["Title"] = "Pharmacy On-Hand Stock";
}

<h4 class="mb-3"><i class="fa-solid fa-boxes-stacked"></i> On-Hand Stock &amp; Ending Inventory</h4>

<form method="post" class="row g-2 mb-3 align-items-end">
    <div class="col-md-3">
        <label class="form-label small mb-1">Store</label>
        <select asp-for="SelectedStoreId" class="form-select form-select-sm"
                asp-items="@(new SelectList(Model.Stores, "Id", "Name"))">
            <option value="0">-- All stores --</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1">Catalogue</label>
        <select asp-for="SelectedCategoryId" class="form-select form-select-sm"
                asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
            <option value="">-- All --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-1">Search</label>
        <input asp-for="Search" class="form-control form-control-sm" placeholder="Code or name..." />
    </div>
    <div class="col-md-4 d-flex gap-3 align-items-center pb-1">
        <div class="form-check">
            <input asp-for="BelowReorderOnly" class="form-check-input" />
            <label class="form-check-label small">Below reorder</label>
        </div>
        <div class="form-check">
            <input asp-for="IncludeZero" class="form-check-input" />
            <label class="form-check-label small">Include zero stock</label>
        </div>
        <button type="submit" class="btn btn-sm btn-primary ms-auto"><i class="fa-solid fa-filter"></i> Apply</button>
    </div>
</form>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm"><div class="card-body py-2">
            <div class="small text-muted">Rows</div>
            <div class="fs-5 fw-semibold">@Model.Rows.Count</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm"><div class="card-body py-2">
            <div class="small text-muted">Total Quantity</div>
            <div class="fs-5 fw-semibold">@Model.TotalQty.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm"><div class="card-body py-2">
            <div class="small text-muted">Stock Value (Cost)</div>
            <div class="fs-5 fw-semibold">@Model.TotalCost.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm"><div class="card-body py-2">
            <div class="small text-muted">Stock Value (Retail)</div>
            <div class="fs-5 fw-semibold">@Model.TotalRetail.ToString("N2")</div>
        </div></div>
    </div>
</div>

@if (Model.Truncated)
{
    <div class="alert alert-warning py-2">
        <i class="fa-solid fa-triangle-exclamation"></i>
        Showing the first @Model.MaxRows rows. Narrow the search or pick a single store to see the rest.
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height:70vh; overflow-y:auto;">
            <table class="table table-sm table-striped table-hover mb-0 align-middle">
                <thead class="table-light" style="position:sticky; top:0; z-index:1;">
                    <tr>
                        <th>Code</th>
                        <th>Drug</th>
                        <th>Generic</th>
                        <th>Supplier</th>
                        <th class="text-end">On-Hand</th>
                        <th class="text-end">Reorder</th>
                        <th class="text-end">Avg Cost</th>
                        <th class="text-end">Retail</th>
                        <th class="text-end">Value (Cost)</th>
                        <th class="text-end">Value (Retail)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                No stock rows match these filters.
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="@(r.BelowReorder ? "table-warning" : "")">
                            <td><code>@r.ItemCode</code></td>
                            <td>
                                @r.ItemName
                                @if (r.BelowReorder)
                                {
                                    <span class="badge text-bg-warning ms-1">Reorder</span>
                                }
                            </td>
                            <td class="text-muted">@(string.IsNullOrEmpty(r.GenericName) ? "-" : r.GenericName)</td>
                            <td class="text-muted">@(string.IsNullOrEmpty(r.SupplierName) ? "-" : r.SupplierName)</td>
                            <td class="text-end">@r.OnHandQty.ToString("N2")</td>
                            <td class="text-end text-muted">@r.ReorderLevel.ToString("N2")</td>
                            <td class="text-end">@r.AvgCost.ToString("N2")</td>
                            <td class="text-end">@r.RetailPrice.ToString("N2")</td>
                            <td class="text-end">@r.ValueAtCost.ToString("N2")</td>
                            <td class="text-end">@r.ValueAtRetail.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                @if (Model.Rows.Any())
                {
                    <tfoot class="table-light fw-semibold">
                        <tr>
                            <td colspan="4">Total (@Model.Rows.Count rows)</td>
                            <td class="text-end">@Model.TotalQty.ToString("N2")</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td class="text-end">@Model.TotalCost.ToString("N2")</td>
                            <td class="text-end">@Model.TotalRetail.ToString("N2")</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>
