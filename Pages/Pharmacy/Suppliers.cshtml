@page
@model HmisWeb.Pages.Pharmacy.SuppliersModel
@using System.Text.Json
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Supplier";
    bool ServerOpened = false;   // popup is opened client-side; see pharmacy-crud.js
    var jsonOpts = new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var rowJson = JsonSerializer.Serialize(Model.Rows.Select(r => new {
        id = r.Id, code = r.Code, name = r.Name, shortName = r.ShortName,
        address = r.Address, phone = r.Phone, city = r.City,
        supplierType = r.SupplierType, active = r.Active
    }).ToList(), jsonOpts);
}

<h4 class="mb-3"><i class="fa-solid fa-truck-field"></i> Supplier <small class="text-muted fs-6">(legacy: supplier.spr)</small></h4>

@if (Model.Message != null)
{
    <div class="alert alert-success py-2"><i class="fa-solid fa-circle-check"></i> @Model.Message</div>
}
@if (Model.Error != null)
{
    <div class="alert alert-danger py-2"><i class="fa-solid fa-circle-exclamation"></i> @Model.Error</div>
}

<div class="card">
    <div class="card-header bg-white">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-1">Search</label>
                <input asp-for="Search" class="form-control form-control-sm" placeholder="Code, name or short name..." />
            </div>
            <div class="col-md-8 d-flex gap-2 align-items-center pb-1">
                <div class="form-check">
                    <input asp-for="ActiveOnly" class="form-check-input" />
                    <label class="form-check-label small">Active only</label>
                </div>
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-filter"></i> Apply</button>
                <a asp-page="Suppliers" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-eraser"></i> Clear</a>
                <button type="button" class="btn btn-sm btn-success ms-auto" id="btnAddNew">
                    <i class="fa-solid fa-plus"></i> Add New Supplier
                </button>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height:72vh; overflow-y:auto;">
            <table class="table table-sm table-striped table-hover mb-0 align-middle" id="supTable">
                <thead class="table-light" style="position:sticky; top:0; z-index:1;">
                    <tr>
                        <th style="width:35px"></th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Short name</th>
                        <th>City</th>
                        <th>Phone</th>
                        <th class="text-center">Type</th>
                        <th class="text-end">Balance</th>
                        <th class="text-end">Drugs</th>
                        <th style="width:86px"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">No supplier matches these filters.</td></tr>
                    }
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="ph-row @(r.Active ? "" : "text-muted")" data-id="@r.Id" style="cursor:pointer" title="Click to edit">
                            <td>
                                @if (!r.Active)
                                {
                                    <span class="badge text-bg-secondary">In</span>
                                }
                            </td>
                            <td><code>@r.Code</code></td>
                            <td>@r.Name</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(r.ShortName) ? "-" : r.ShortName)</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(r.City) ? "-" : r.City)</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(r.Phone) ? "-" : r.Phone)</td>
                            <td class="text-center small">@(string.IsNullOrEmpty(r.SupplierType) ? "-" : r.SupplierType)</td>
                            <td class="text-end">@r.Balance.ToString("N2")</td>
                            <td class="text-end">@r.ItemCount</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary ph-edit" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger ph-del"
                                        title="Delete" data-id="@r.Id" data-code="@r.Code" data-name="@r.Name">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white small text-muted">
        Showing @Model.Rows.Count supplier(s). Click any row to open its data-entry popup.
    </div>
</div>

<!-- ===================== DATA-ENTRY POPUP ===================== -->
<div class="modal fade" id="supModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="Save" id="supForm">
                <input type="hidden" asp-for="Edit.Id" id="Edit_Id" />
                <input type="hidden" asp-for="Search" />
                <input type="hidden" asp-for="ActiveOnly" />
                <div class="modal-header">
                    <h6 class="modal-title" id="supModalTitle">Add Supplier</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label small">Code</label>
                            <input asp-for="Edit.Code" id="Edit_Code" class="form-control form-control-sm" maxlength="20" required />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label small">Name</label>
                            <input asp-for="Edit.Name" id="Edit_Name" class="form-control form-control-sm" maxlength="150" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Short name</label>
                            <input asp-for="Edit.ShortName" id="Edit_ShortName" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">City</label>
                            <input asp-for="Edit.City" id="Edit_City" class="form-control form-control-sm" maxlength="80" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Phone</label>
                            <input asp-for="Edit.Phone" id="Edit_Phone" class="form-control form-control-sm" maxlength="50" />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label small">Address</label>
                            <input asp-for="Edit.Address" id="Edit_Address" class="form-control form-control-sm" maxlength="200" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Type</label>
                            <select asp-for="Edit.SupplierType" id="Edit_SupplierType" class="form-select form-select-sm">
                                <option value="">--</option>
                                <option value="M">Medicine</option>
                                <option value="D">Distribution</option>
                                <option value="G">General</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Edit.Active" id="Edit_Active" class="form-check-input" />
                                <label class="form-check-label small">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form method="post" asp-page-handler="Delete" id="delForm" class="d-none">
    <input type="hidden" name="id" id="del_Id" />
    <input type="hidden" name="Search" value="@Model.Search" />
    <input type="hidden" name="ActiveOnly" value="@Model.ActiveOnly.ToString().ToLower()" />
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.1/sweetalert2.all.min.js"></script>
    <script src="~/js/pharmacy-crud.js"></script>
    <script id="phRows" type="application/json">@Html.Raw(rowJson)</script>
    <script>
        PhCrud.init({
            data: 'phRows',
            modal: 'supModal',
            form: 'supForm',
            title: 'supModalTitle',
            addBtn: 'btnAddNew',
            rowSelector: '#supTable tr.ph-row',
            delSelector: '#supTable .ph-del',
            deleteForm: 'delForm',
            deleteId: 'del_Id',
            label: 'Supplier',
            fields: ['Id', 'Code', 'Name', 'ShortName', 'Address', 'Phone', 'City', 'SupplierType', 'Active'],
            newDefaults: { Active: true },
            deleteTitle: 'Delete this supplier?',
            deleteNote: 'The supplier is removed from the pick list but kept on every historic purchase. ' +
                        'It cannot be deleted while medicines still name it as their supplier.'
        });
    </script>
}
