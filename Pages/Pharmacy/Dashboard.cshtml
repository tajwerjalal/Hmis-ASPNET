@page
@model HmisWeb.Pages.Pharmacy.DashboardModel
@{
    ViewData["Title"] = "Pharmacy Dashboard";
    string Fmt(decimal v) => v.ToString("N2");
    string Qty(decimal v) => v.ToString("N0");
}

<h4 class="mb-3"><i class="fa-solid fa-store"></i> Pharmacy &mdash; Multi-Store Dashboard</h4>

<form method="post" class="row g-2 mb-4 align-items-end">
    <div class="col-auto">
        <label class="form-label mb-1 small">From</label>
        <input type="date" asp-for="From" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <label class="form-label mb-1 small">To</label>
        <input type="date" asp-for="To" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-filter"></i> Apply</button>
    </div>
    <div class="col-auto">
        <span class="text-muted small">@Model.FromDate.ToString("dd/MM/yyyy") &ndash; @Model.ToDate.ToString("dd/MM/yyyy")</span>
    </div>
</form>

@if (!Model.Stores.Any())
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation"></i>
        No pharmacy stores are configured yet. Add one under
        <a asp-page="/Pharmacy/Stores">Pharmacy &rarr; Stores</a>.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Ending Inventory (Cost)</div>
                    <div class="fs-4 fw-semibold">@Fmt(Model.TotalStockCost)</div>
                    <div class="small text-muted">across @Model.Stores.Count store(s)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Ending Inventory (Retail)</div>
                    <div class="fs-4 fw-semibold">@Fmt(Model.TotalStockRetail)</div>
                    <div class="small text-muted">potential margin @Fmt(Model.TotalStockRetail - Model.TotalStockCost)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">On-Hand Quantity</div>
                    <div class="fs-4 fw-semibold">@Qty(Model.TotalQty)</div>
                    <div class="small text-muted">units across all stores</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Open Balance &mdash; Receivable</div>
                    <div class="fs-4 fw-semibold text-success">@Fmt(Model.Ledger.TotalReceivable)</div>
                    <div class="small text-muted">payable @Fmt(Model.Ledger.TotalPayable)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-white"><strong>Store-wise position</strong></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Store</th>
                            <th>Type</th>
                            <th class="text-end">Drugs Carried</th>
                            <th class="text-end">In Stock</th>
                            <th class="text-end">On-Hand Qty</th>
                            <th class="text-end">Stock Value (Cost)</th>
                            <th class="text-end">Stock Value (Retail)</th>
                            <th class="text-end">Below Reorder</th>
                            <th class="text-end">Purchases</th>
                            <th class="text-end">Sales</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Summaries)
                        {
                            <tr>
                                <td>
                                    <i class="fa-solid @(s.StoreType == "MAIN" ? "fa-warehouse" : "fa-shop")"></i>
                                    @s.StoreName
                                    <span class="badge text-bg-light ms-1">@s.StoreCode</span>
                                </td>
                                <td>
                                    @if (s.StoreType == "MAIN")
                                    {
                                        <span class="badge text-bg-primary">Main Store</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Sub Store</span>
                                    }
                                </td>
                                <td class="text-end">@Qty(s.ItemCount)</td>
                                <td class="text-end">@Qty(s.InStockCount)</td>
                                <td class="text-end">@Qty(s.TotalQty)</td>
                                <td class="text-end">@Fmt(s.EndingInventoryCost)</td>
                                <td class="text-end">@Fmt(s.EndingInventoryRetail)</td>
                                <td class="text-end">
                                    @if (s.ReorderCount > 0)
                                    {
                                        <span class="badge text-bg-warning">@Qty(s.ReorderCount)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-end">@Fmt(s.PurchaseValue)</td>
                                <td class="text-end">@Fmt(s.SalesValue)</td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.Summaries.Any())
                    {
                        <tfoot class="table-light fw-semibold">
                            <tr>
                                <td colspan="4">Total</td>
                                <td class="text-end">@Qty(Model.TotalQty)</td>
                                <td class="text-end">@Fmt(Model.TotalStockCost)</td>
                                <td class="text-end">@Fmt(Model.TotalStockRetail)</td>
                                <td></td>
                                <td class="text-end">@Fmt(Model.TotalPurchases)</td>
                                <td class="text-end">@Fmt(Model.TotalSales)</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    <p class="text-muted small mt-3 mb-0">
        Open balance is derived from the migrated double-entry ledger
        (<code>PHVOUCHER</code> / <code>PHVOUCHERLINE</code>) for the period above &mdash;
        it is money owed to or by the store, not a stock valuation. The period shown is limited by the
        migrated ledger sample; earlier years are not included.
    </p>
}
