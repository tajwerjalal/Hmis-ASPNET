@page "/cnp/indent"
@model HmisWeb.Pages.Cnp.IndentModel
@*
    Consultancy &amp; Procedures indent screen (route /cnp/indent).

    Purpose
      Renders the shared department indent UI so the CNP process is identical to
      Ultrasound: patient search, IPD detection, service popup, cart, save.

    Why
      The page used to read INV-CNP-* rows from [ITEM] and used a three-step
      layout. It now uses the SERVICES DEPT 11 catalogue and the shared process.

    Business rules / validations
      Handled by the shared page model (patient + one line required, DEPT 11
      services only, panel rate resolution, discount clamping, IPD vs OPD).

    Developer : AI Assistant
    Created   : 27-Oct-2026 11:27
*@
@{
    ViewData["Title"] = "Consultancy & Procedures Service Indent (Invoice)";
}

<partial name="_DepartmentIndent" model="Model" />

@section Scripts {
    <script src="~/js/department-indent.js" asp-append-version="true"></script>
}
