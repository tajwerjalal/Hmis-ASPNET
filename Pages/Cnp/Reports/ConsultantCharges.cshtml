@page "/cnp/Reports/ConsultantCharges"
@model HmisWeb.Pages.Cnp.Reports.ConsultantChargesModel
@{
    ViewData["Title"] = "Consultant Charges Report";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-person-vcard me-2 text-primary"></i>Consultant Charges Report</h4>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <select asp-for="ConsultantId" asp-items="Model.Consultants" class="form-select form-select-sm">
            <option value="">-- All Consultants --</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary btn-sm">Show</button>
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Consultant</th>
                    <th>Service</th>
                    <th class="text-end">Consultant Rate</th>
                    <th class="text-end">Urgent Rate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@(r.Consultant?.Person?.Name ?? r.ConsultantId.ToString())</td>
                        <td>@(r.Item?.Name ?? r.ItemId.ToString())</td>
                        <td class="text-end">@r.StaffRate.ToString("N2")</td>
                        <td class="text-end">@r.UnitRate.ToString("N2")</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="4" class="text-center text-secondary py-3">No consultant charges found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>