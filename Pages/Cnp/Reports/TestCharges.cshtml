@page "/cnp/Reports/TestCharges"
@model HmisWeb.Pages.Cnp.Reports.TestChargesModel
@{
    ViewData["Title"] = "Test Charges Report";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-cash-coin me-2 text-primary"></i>Test Charges Report</h4>
        <div class="text-secondary small">Panel company charges by department &middot; migrated from VFP us0210 (compchg)</div>
    </div>
    <a asp-page="/Hospital/Reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Reports</a>
</div>

@if (!Model.CompanyId.HasValue)
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>Please select a panel company.</div>
}

<form method="get" class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Department</label>
                <select asp-for="Department" class="form-select form-select-sm">
                    <option value="All">All departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Code">@d.Code - @d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small mb-1">Panel company</label>
                <select asp-for="CompanyId" class="form-select form-select-sm">
                    <option value="">-- select a panel company --</option>
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Id">@c.Code @c.Name (@c.ChargeCount)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Order by</label>
                <select asp-for="OrderBy" class="form-select form-select-sm">
                    <option value="Code">Test ID</option>
                    <option value="Name">Test name</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Tests</label>
                <input asp-for="SelectedCodes" class="form-control form-control-sm" placeholder="blank = all" />
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>View</button>
                <a asp-page="/Hospital/Reports/TestCharges" asp-page-handler="Export" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-filetype-csv me-1"></i>CSV
                </a>
                @if (Model.Rows.Any())
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="tcPrint()">
                        <i class="bi bi-printer me-1"></i>Print
                    </button>
                }
            </div>
        </div>
    </div>
</form>

@if (Model.Rows.Any())
{
    <div class="card">
        <div class="card-header bg-white fw-semibold d-flex flex-wrap justify-content-between gap-2">
            <span>@Model.CompanyName &mdash; @Model.Rows.Count test(s)</span>
            <span>Standard: <strong>@Model.TotalStandard.ToString("N2")</strong> &nbsp;|&nbsp; Company: <strong>@Model.TotalCompany.ToString("N2")</strong></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" id="tcTable" style="max-height:70vh;overflow:auto">
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Service</th>
                            <th>Group</th>
                            <th>Department</th>
                            <th class="text-end">Standard</th>
                            <th class="text-end">Foreigner</th>
                            <th class="text-end">Company</th>
                            <th>Billable</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td>@r.Code</td>
                                <td>@r.Name</td>
                                <td>@r.Group</td>
                                <td>@r.Department</td>
                                <td class="text-end">@r.StandardRate.ToString("N2")</td>
                                <td class="text-end">@r.StandardForeigner.ToString("N2")</td>
                                <td class="text-end"><strong>@r.CompanyRate.ToString("N2")</strong></td>
                                <td>
                                    @if (r.Linked)
                                    {
                                        <span class="badge bg-success">Linked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" title="Service not yet migrated to HMIS billing">Not in HMIS</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function tcPrint() {
            var w = window.open('', '_blank', 'width=1100,height=1200');
            if (!w) { alert('Allow pop-ups to print the report.'); return; }
            var css = 'body{font-family:Segoe UI,Arial,sans-serif;font-size:9pt;padding:14mm;color:#000}' +
                      'table{border-collapse:collapse;width:100%;font-size:8.5pt}' +
                      'th,td{border:1px solid #999;padding:3px 5px}' +
                      'th{background:#f0f0f0;text-align:left}' +
                      'h1{font-size:14pt;text-align:center;margin:0 0 2px}' +
                      '.sub{text-align:center;color:#555;margin-bottom:8px}' +
                      'thead{display:table-header-group}' +
                      'tr{page-break-inside:avoid}' +
                      '@@page{margin:10mm}';
            w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Test Charges</title><style>' + css + '</style></head><body>');
            w.document.write('<h1>TEST CHARGES REPORT</h1>');
            w.document.write('<div class="sub">@Model.CompanyName &nbsp;|&nbsp; Department: @Model.Department &nbsp;|&nbsp; @Model.Rows.Count test(s) &nbsp;|&nbsp; Standard @Model.TotalStandard.ToString("N2") &nbsp;|&nbsp; Company @Model.TotalCompany.ToString("N2")</div>');
            w.document.write(document.getElementById('tcTable').innerHTML);
            w.document.write('</body></html>');
            w.document.close();
            w.focus();
            setTimeout(function () { w.print(); }, 400);
        }
    </script>
}