@page "/us/Reports/CollectionPeriodic"
@model HmisWeb.Pages.Us.Reports.CollectionPeriodicModel
@{
    ViewData["Title"] = "Periodic Collection Report";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-journal-text me-2 text-primary"></i>Periodic Collection Report</h4>
        <div class="text-secondary small">Migrated from VFP ultrasound reports</div>
    </div>
    <a asp-page="/Us/Reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Reports</a>
</div>

<partial name="_CollectionGrid" model="Model" />