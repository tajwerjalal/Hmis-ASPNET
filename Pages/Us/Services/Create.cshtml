@page "/us/services/create"
@model HmisWeb.Pages.Us.Services.CreateModel
@using HmisWeb.Data.Enums
@{
    ViewData["Title"] = "Add Ultrasound Service";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2 text-success"></i>Add Ultrasound Service</h4>
        <div class="text-secondary small">Create a new ultrasound service. The code is generated automatically.</div>
    </div>
    <a asp-page="/Us/Services" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-circle me-1"></i>@Model.ErrorMessage</div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <div class="card mb-3">
        <div class="card-header bg-white fw-semibold"><i class="bi bi-info-circle me-1 text-primary"></i>Service Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Code</label>
                    <input class="form-control form-control-sm" value="@Model.AutoCode" disabled />
                    <div class="form-text">Auto-generated on save &mdash; cannot be changed.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Service.Name" class="form-label small fw-bold">Name *</label>
                    <input asp-for="Service.Name" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="Service.Sname" class="form-label small fw-bold">Short Name</label>
                    <input asp-for="Service.Sname" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Service.CategoryId" class="form-label small fw-bold">Category</label>
                    <select asp-for="Service.CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))" class="form-select form-select-sm">
                        <option value="">-- Select Category --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Department</label>
                    <input class="form-control form-control-sm" value="Ultrasound (Radiology)" disabled />
                    <div class="form-text">Fixed for all ultrasound services.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Service.ItemType" class="form-label small fw-bold">Item Type</label>
                    <select asp-for="Service.ItemType" asp-items="Html.GetEnumSelectList<ItemType>()" class="form-select form-select-sm">
                        <option value="">-- Type --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Service.Rate" class="form-label small fw-bold">Rate (Rs)</label>
                    <input asp-for="Service.Rate" type="number" step="0.01" min="0" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Service.RateForeigner" class="form-label small fw-bold">Foreigner Rate</label>
                    <input asp-for="Service.RateForeigner" type="number" step="0.01" min="0" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Service.Priority" class="form-label small fw-bold">Priority</label>
                    <select asp-for="Service.Priority" asp-items="Html.GetEnumSelectList<Priority>()" class="form-select form-select-sm">
                        <option value="">-- Priority --</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Service.Requirements" class="form-label small fw-bold">Requirements / Preparation</label>
                    <textarea asp-for="Service.Requirements" class="form-control form-control-sm" rows="2" placeholder="Patient preparation instructions..."></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-white fw-semibold"><i class="bi bi-toggles me-1 text-primary"></i>Settings</div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="Service.Billable" id="billable" />
                        <label class="form-check-label small" for="billable">Billable</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="Service.DiscountAllowed" id="discountAllowed" />
                        <label class="form-check-label small" for="discountAllowed">Discount Allowed</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="Service.Active" id="active" />
                        <label class="form-check-label small" for="active">Active</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-save me-1"></i>Create Service</button>
        <a asp-page="/Us/Services" class="btn btn-outline-secondary btn-sm">Cancel</a>
    </div>
</form>
