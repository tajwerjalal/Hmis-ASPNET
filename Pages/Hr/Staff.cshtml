@page
@model HmisWeb.Pages.Hr.StaffModel
@{
    ViewData["Title"] = "Staff";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Staff</h4>
    <a asp-page="/Hr/NewStaff" class="btn btn-primary btn-sm">Add Staff</a>
</div>

<table class="table table-bordered table-sm table-hover">
    <thead class="table-light">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Designation</th>
            <th>Department</th>
            <th>Institution</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.StaffList.Any())
        {
            @foreach (var s in Model.StaffList)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@(s.Person != null ? (s.Person.NameWithInitials ?? s.Person.Name ?? "") : "")</td>
                    <td>@(s.Designation != null ? s.Designation.Name ?? "" : "")</td>
                    <td>@(s.Department != null ? s.Department.Name ?? "" : "")</td>
                    <td>@(s.Institution != null ? s.Institution.Name ?? "" : "")</td>
                    <td class="text-end">
                        <a asp-page="/Hr/EditStaff" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="6" class="text-center text-muted">No staff found.</td></tr>
        }
    </tbody>
</table>
