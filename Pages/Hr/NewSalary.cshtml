@page
@model HmisWeb.Pages.Hr.NewSalaryModel
@{
    ViewData["Title"] = "New Salary";
}

<h4>New Salary</h4>

<div class="card mt-3">
    <div class="card-body">
        <form method="post">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Staff *</label>
                    <select asp-for="Input.StaffId" asp-items="Model.StaffList" class="form-select" required>
                        <option value="">-- Select Staff --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Salary Date *</label>
                    <input asp-for="Input.SalaryDate" class="form-control" type="date" required />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Gross Salary</label>
                    <input asp-for="Input.GrossSalary" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">EPF (Employee)</label>
                    <input asp-for="Input.EpfEmployee" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">ETF</label>
                    <input asp-for="Input.Etf" class="form-control" type="number" step="0.01" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">PAYE</label>
                    <input asp-for="Input.Payee" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Net Salary</label>
                    <input asp-for="Input.NetSalary" class="form-control" type="number" step="0.01" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="/Hr/Salary" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
