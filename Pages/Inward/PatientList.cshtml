@page
@model HmisWeb.Pages.Inward.PatientListModel
@*
    Inpatient list - active IPD stays.

    Paged and searchable, with the current bed from [PATIENTROOM] -> [BED_POS]
    and quick links to billing, ward transfer, company transfer and discharge.

    Developer : [TAJWER JALAL]
    Date      : 22-Oct-2026
    Time      : 18:30
    Change Log: 22-Oct-2026 - paging, search, current bed and transfer links.
*@
@{
    ViewData["Title"] = "Inpatient List";
}

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h4 class="mb-0 fw-bold">Inpatients</h4>
        <span class="text-secondary small">Currently admitted patients</span>
    </div>
    <a asp-page="/Inward/Admission" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Admission</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-secondary mb-1">Search</label>
                <input name="Q" value="@Model.Q" class="form-control form-control-sm" placeholder="BHT or patient name" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Search</button>
                <a asp-page="/Inward/PatientList" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Inpatients.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Patient</th>
                            <th>BHT</th>
                            <th>Admission Date</th>
                            <th>Bed</th>
                            <th>Consultant</th>
                            <th>Payment</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Inpatients)
                        {
                            var e = row.Encounter;
                            <tr>
                                <td>
                                    <div class="fw-semibold">@HmisWeb.Services.PatientDisplayName.Of(e.Patient)</div>
                                    <small class="text-secondary">PHN: @(e.Patient?.Phn ?? "-")</small>
                                </td>
                                <td><span class="badge bg-secondary">@(e.BhtNo ?? "-")</span></td>
                                <td>@(e.DateOfAdmission?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>
                                    @if (row.CurrentBed != null)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis">@row.CurrentBed.BedCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var consultant = e.ReferringConsultant?.Person?.Name
                                            ?? e.ReferringConsultant?.Person?.Surname
                                            ?? "-";
                                    }
                                    @consultant
                                </td>
                                <td>
                                    @if (e.PaymentFinalized)
                                    {
                                        <span class="badge bg-success">Settled</span>
                                    }
                                    else if (e.PaymentMethod == HmisWeb.Data.Enums.PaymentMethod.Credit)
                                    {
                                        <span class="badge bg-warning text-dark">Credit</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pending</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-page="/Inward/Billing" asp-route-encounterId="@e.Id" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-cash-stack me-1"></i>Bill</a>
                                    <a asp-page="/Inward/WardTransfer" asp-route-SelectedEncounterId="@e.Id" class="btn btn-sm btn-outline-secondary me-1" title="Ward transfer"><i class="bi bi-arrow-left-right"></i></a>
                                    <a asp-page="/Corporate/CompanyTransfers" asp-route-SelectedEncounterId="@e.Id" class="btn btn-sm btn-outline-secondary me-1" title="Company transfer"><i class="bi bi-building"></i></a>
                                    <a asp-page="/Inward/Discharge" asp-route-encounterId="@e.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Discharge</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-secondary" style="font-size:2.5rem;"></i>
                <p class="text-secondary mt-2 mb-0">No active inpatients.</p>
            </div>
        }
    </div>
</div>

<partial name="_Pager" model="Model" />