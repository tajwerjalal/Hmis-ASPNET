@page "/cashier/eodreport"
@model HmisWeb.Pages.Cashier.EodReportModel
@*
    Developer : [TAJWER JALAL]
    Date      : 23-Oct-2026
    Time      : 11:15
    Change Log: 23-Oct-2026 - moved the EOD collection report from the OPD
                module to the Cashier module and route (/cashier/eodreport).
*@
@{
    ViewData["Title"] = "EOD Collection Report";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-clipboard-data me-1 text-primary"></i>End of Day - Consultant-wise Collection Report</h4>
        <div class="text-secondary small">Cashier reconciliation of OPD collections and token summary per consultant session.</div>
    </div>
    <form method="get" class="d-flex gap-2 align-items-center">
        <input asp-for="SessionDate" type="date" class="form-control form-control-sm" />
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-calendar2-check me-1"></i> Show</button>
        <button type="button" onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer me-1"></i> Print</button>
    </form>
</div>

@if (!Model.Rows.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            No OPD sessions were run on @Model.ViewDate.ToString("dd MMM yyyy").
        </div>
    </div>
}
else
{
    <div class="print-area">
        <div class="text-center d-none d-print-block mb-3">
            <div class="fw-bold fs-5">OPD End of Day Collection Report</div>
            <div class="small">@Model.ViewDate.ToString("dd MMM yyyy dddd")</div>
        </div>

        <div class="row g-3 mb-3 no-print">
            <div class="col-md-3">
                <div class="card border-primary">
                    <div class="card-body py-2 text-center">
                        <div class="fw-bold fs-4 text-primary">@Model.Totals.TokensIssued</div>
                        <div class="text-secondary small">Tokens Issued</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success">
                    <div class="card-body py-2 text-center">
                        <div class="fw-bold fs-4 text-success">@Model.Totals.Completed</div>
                        <div class="text-secondary small">Consulted</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-danger">
                    <div class="card-body py-2 text-center">
                        <div class="fw-bold fs-4 text-danger">@Model.Totals.NoShow</div>
                        <div class="text-secondary small">No Show</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning">
                    <div class="card-body py-2 text-center">
                        <div class="fw-bold fs-4 text-warning">Rs. @Model.Totals.Total.ToString("N2")</div>
                        <div class="text-secondary small">Total Collected</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive card">
            <table class="table table-bordered table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Consultant</th>
                        <th>Speciality / Room</th>
                        <th class="text-center">Tokens Issued</th>
                        <th class="text-center">Waiting</th>
                        <th class="text-center">Consulted</th>
                        <th class="text-center">No Show</th>
                        <th class="text-end">Hospital Fee</th>
                        <th class="text-end">Consultant Fee</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Handed Over</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@r.ConsultantName</div>
                                <div class="small text-secondary">@r.FromTime @(r.Settled ? "" : "&middot; Pending")</div>
                            </td>
                            <td class="small">@r.SpecialityName <span class="text-secondary">/ Room @(r.RoomNo ?? "-")</span></td>
                            <td class="text-center">@r.TokensIssued</td>
                            <td class="text-center">@r.Waiting</td>
                            <td class="text-center">@r.Completed</td>
                            <td class="text-center">@r.NoShow</td>
                            <td class="text-end">@r.HospitalFee.ToString("N2")</td>
                            <td class="text-end">@r.ProfessionalFee.ToString("N2")</td>
                            <td class="text-end fw-semibold">@r.Total.ToString("N2")</td>
                            <td class="text-end">
                                @if (r.Settled)
                                {
                                    <span class="badge bg-success">@r.HandedOver.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-danger small">@r.HandedOver.ToString("N2")</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold table-light">
                        <td colspan="2">TOTAL</td>
                        <td class="text-center">@Model.Totals.TokensIssued</td>
                        <td class="text-center"></td>
                        <td class="text-center">@Model.Totals.Completed</td>
                        <td class="text-center">@Model.Totals.NoShow</td>
                        <td class="text-end">@Model.Totals.HospitalFee.ToString("N2")</td>
                        <td class="text-end">@Model.Totals.ProfessionalFee.ToString("N2")</td>
                        <td class="text-end">@Model.Totals.Total.ToString("N2")</td>
                        <td class="text-end">@Model.Totals.HandedOver.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="mt-2 d-flex justify-content-end no-print">
        <a asp-page="/Opd/Handover" asp-route-SessionDate="@Model.ViewDate.ToString("yyyy-MM-dd")" class="btn btn-success">
            <i class="bi bi-cash-coin me-1"></i>Hand over to consultants
        </a>
    </div>
}
