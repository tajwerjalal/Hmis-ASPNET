@page
@model HmisWeb.Pages.Cashier.PatientPaymentModel
@{
    ViewData["Title"] = "Patient Payment Statement";
}
<div class="container-fluid mt-3">
    <h3><i class="bi bi-person"></i> Patient Payment Statement</h3>
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-2">
            <label class="form-label">Register No.</label>
            <input asp-for="RegNo" type="number" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">From</label>
            <input asp-for="FromDate" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To</label>
            <input asp-for="ToDate" type="date" class="form-control" />
        </div>
        <div class="col-md-2 align-self-end">
            <button type="submit" class="btn btn-primary">Show</button>
        </div>
    </form>

    @if (Model.Patient != null)
    {
        <div class="mb-2">
            <strong>Patient:</strong> @Model.Patient.Person?.Name
        </div>
    }

    <table class="table table-sm table-striped">
        <thead><tr><th>Vou No</th><th>Vou Date</th><th>Type</th><th>Tr No</th><th class="text-end">Total</th></tr></thead>
        <tbody>
            @foreach (var e in Model.Entries)
            {
                <tr><td>@e.VouNo</td><td>@e.VouDate.ToString("dd-MM-yyyy")</td><td>@e.TrType</td><td>@e.TrNo</td><td class="text-end">@e.TotalAmt.ToString("N2")</td></tr>
            }
        </tbody>
    </table>
    <a asp-page="/cashier" class="btn btn-secondary">Back</a>
</div>