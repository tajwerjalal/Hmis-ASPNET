@page
@model HmisWeb.Pages.Cashier.IndexModel
@{
    ViewData["Title"] = "Cashier";
}

<div class="container mt-4">
    <h2><i class="bi bi-cash-stack"></i> Cashier Module</h2>
    <p class="text-muted">Migrated from the legacy VFP Register/Cashier application. Transactions, day-end posting, counters and reports.</p>

    <div class="row g-3 mt-2">
        <div class="col-md-3"><a asp-page="/cashier/receipt" class="btn btn-outline-primary w-100"><i class="bi bi-receipt"></i><br/>Cash Receipts</a></div>
        <div class="col-md-3"><a asp-page="/cashier/payment" class="btn btn-outline-primary w-100"><i class="bi bi-cash"></i><br/>Cash Payments</a></div>
        <div class="col-md-3"><a asp-page="/cashier/dayendposting" class="btn btn-outline-warning w-100"><i class="bi bi-calendar-check"></i><br/>Day End Posting</a></div>
        <div class="col-md-3"><a asp-page="/cashier/cashaudit" class="btn btn-outline-info w-100"><i class="bi bi-journal-check"></i><br/>Cash Audit (Un-posted)</a></div>
        <div class="col-md-3"><a asp-page="/cashier/cashbook" class="btn btn-outline-info w-100"><i class="bi bi-book"></i><br/>Cash Book</a></div>
        <div class="col-md-3"><a asp-page="/cashier/voucherslist" class="btn btn-outline-info w-100"><i class="bi bi-list-ul"></i><br/>Vouchers List</a></div>
        <div class="col-md-3"><a asp-page="/cashier/countersetup" class="btn btn-outline-secondary w-100"><i class="bi bi-hdd-stack"></i><br/>Counter Setup</a></div>
        <div class="col-md-3"><a asp-page="/cashier/createcounter" class="btn btn-outline-secondary w-100"><i class="bi bi-plus-circle"></i><br/>Create Counter</a></div>
    </div>
</div>