@page "/Cashier/ReceiptPrint"
@model HmisWeb.Pages.Cashier.ReceiptPrintModel
@{
    Layout = null;
}
@*
    ============================================================================
    File........: Pages/Cashier/ReceiptPrint.cshtml
    Purpose.....: Standalone 80 mm thermal receipt for one CashReceipt.
    Inputs......: ReceiptPrintModel (Receipt, PatientName, ErrorMessage, AutoPrint).
    Outputs.....: Thermal receipt layout with Print/Close controls.
    Business
      rules.....: 1. Only the receipt identified by TrNo is printed.
                  2. All receipt detail lines are printed.
                  3. print=1 opens the browser print dialog automatically.
    Developer...: Tajwer Jalal
    Date/Time...: 2026-11-04 10:00
    ============================================================================
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Receipt @(Model.Receipt?.TrNo ?? "")</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            background: #f2f2f2;
            color: #000;
            font-family: "Courier New", Courier, monospace;
            font-size: 11pt;
        }
        .receipt {
            width: 80mm;
            margin: 6mm auto;
            padding: 4mm;
            background: #fff;
            box-shadow: 0 0 8px rgba(0,0,0,.15);
        }
        .center { text-align: center; }
        .bold { font-weight: bold; }
        .line { border-top: 1px dashed #000; margin: 4px 0; }
        .row { display: flex; justify-content: space-between; gap: 6px; }
        .row .label { flex: 1; }
        .row .value { text-align: right; white-space: nowrap; }
        table { width: 100%; border-collapse: collapse; font-size: 10pt; }
        th, td { padding: 2px 0; vertical-align: top; }
        td.amt { text-align: right; white-space: nowrap; }
        .total { font-weight: bold; border-top: 1px solid #000; padding-top: 3px; }
        .no-print { text-align: center; padding: 8px 0 0; }
        .no-print button {
            padding: 6px 14px;
            margin: 0 3px;
            border: 1px solid #0d6efd;
            border-radius: 4px;
            background: #0d6efd;
            color: #fff;
            cursor: pointer;
            font-size: 10pt;
        }
        .no-print button.secondary { background: #fff; color: #0d6efd; }
        .error { max-width: 80mm; margin: 30mm auto; padding: 14px; border: 1px solid #dc3545; background: #fff5f5; color: #842029; }
        @@media print {
            body { background: #fff; }
            .receipt { width: auto; margin: 0; padding: 0; box-shadow: none; }
            .no-print { display: none !important; }
            @@page { size: 80mm auto; margin: 4mm; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        @if (string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <button type="button" onclick="window.print()">Print Receipt</button>
        }
        <button type="button" class="secondary" onclick="window.close()">Close</button>
        <a class="secondary" href="/Cashier/Receipt" style="display:inline-block;padding:6px 14px;margin:0 3px;border:1px solid #0d6efd;border-radius:4px;color:#0d6efd;text-decoration:none;font-size:10pt;">Back to Receipts</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">
            <strong>Receipt not available.</strong>
            <div>@Model.ErrorMessage</div>
        </div>
    }
    else if (Model.Receipt != null)
    {
        var r = Model.Receipt;
        <div class="receipt">
            <div class="center bold">HMIS HOSPITAL</div>
            <div class="center">CASH RECEIPT</div>
            <div class="line"></div>

            <div class="row"><span class="label">Receipt No</span><span class="value">@r.TrNo</span></div>
            <div class="row"><span class="label">Date</span><span class="value">@r.TrDate.ToString("dd-MMM-yyyy") @r.TrTime</span></div>
            <div class="row"><span class="label">Reg No</span><span class="value">@(r.RegNo?.ToString() ?? "-")</span></div>
            @if (!string.IsNullOrWhiteSpace(Model.PatientName))
            {
                <div class="row"><span class="label">Patient</span><span class="value">@Model.PatientName</span></div>
            }
            <div class="row"><span class="label">Type</span><span class="value">@r.Type</span></div>
            <div class="row"><span class="label">Mode</span><span class="value">@r.Mode</span></div>
            @if (!string.IsNullOrWhiteSpace(r.Reference))
            {
                <div class="row"><span class="label">Ref</span><span class="value">@r.Reference</span></div>
            }
            <div class="line"></div>

            <table>
                <thead>
                    <tr>
                        <th>Description</th>
                        <th class="amt">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in r.Details)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(d.Remarks) ? d.AccNo : d.Remarks)</td>
                            <td class="amt">@d.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="line"></div>
            @if (r.CDisc > 0)
            {
                <div class="row"><span class="label">Discount</span><span class="value">@r.CDisc.ToString("N2")</span></div>
            }
            <div class="row total"><span class="label">Total</span><span class="value">@r.TotalAmt.ToString("N2")</span></div>
            <div class="line"></div>

            <div class="row"><span class="label">Cashier</span><span class="value">@r.UserId</span></div>
            <div class="center" style="margin-top:6px;">Thank you</div>
        </div>
    }

    @if (Model.AutoPrint && string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <script>
            window.addEventListener('load', function () {
                setTimeout(function () { window.print(); }, 300);
            });
        </script>
    }
</body>
</html>