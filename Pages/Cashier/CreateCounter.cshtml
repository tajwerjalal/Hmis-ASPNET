@page
@model HmisWeb.Pages.Cashier.CreateCounterModel
@*
    Create / open cash counter.

    Developer : [TAJWER JALAL]
    Date      : 23-Oct-2026
    Time      : 12:50
    Change Log: 23-Oct-2026 - opening a counter now requires the activation key
                to be typed twice and both values must match.
                23-Oct-2026 - added the Department / Line selector; the chosen
                department is stored in session so the open-counter guard matches.
*@
@{
    ViewData["Title"] = "Create Cash Counter";
}
<div class="container mt-4">
    <h3><i class="bi bi-plus-circle"></i> Create Cash Counter</h3>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    @if (!string.IsNullOrEmpty(Model.Success)) { <div class="alert alert-success">@Model.Success</div> }

    <form method="post" asp-page-handler="Save" id="createCounterForm" class="mb-3">
        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <label class="form-label">Department / Line</label>
                <select asp-for="Input.LCode" class="form-select" required>
                    <option value="">-- select department / line --</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Counter</label>
                <select asp-for="Input.CCode" class="form-select">
                    <option value="">-- default counter --</option>
                    @foreach (var c in Model.Counters) { <option value="@c.CCode">@c.CCode - @c.Desc</option> }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Description</label>
                <input asp-for="Input.Desc" class="form-control" required />
            </div>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label">Activation Key</label>
                <input asp-for="Input.ActiveKey" type="password" class="form-control" required autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Confirm Activation Key</label>
                <input asp-for="Input.ConfirmActiveKey" type="password" class="form-control" required autocomplete="off" />
            </div>
            <div class="col-md-3 align-self-end">
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Create / Open</button>
            </div>
        </div>
    </form>

    <h5>Recent Sessions</h5>
    <table class="table table-sm table-striped">
        <thead><tr><th>Code</th><th>Desc</th><th>Active Date</th><th>Active By</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var s in Model.Sessions)
            {
                <tr><td>@s.CCode</td><td>@s.Desc</td><td>@s.ActiveDt?.ToString("dd-MM-yyyy")</td><td>@s.ActiveBy</td><td>@s.Status</td></tr>
            }
        </tbody>
    </table>
    <a asp-page="/cashier" class="btn btn-secondary">Back</a>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('createCounterForm');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                var key = document.getElementById('Input_ActiveKey');
                var confirm = document.getElementById('Input_ConfirmActiveKey');
                if (key && confirm && key.value !== confirm.value) {
                    e.preventDefault();
                    alert('Activation key and confirmation key do not match.');
                    confirm.focus();
                }
            });
        })();
    </script>
}
