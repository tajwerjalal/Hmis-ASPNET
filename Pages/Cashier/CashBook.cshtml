@page
@model HmisWeb.Pages.Cashier.CashBookModel
@{
    ViewData["Title"] = "Cash Book Statement";
}
<div class="container-fluid mt-3">
    <h3><i class="bi bi-book"></i> Cash Book Statement (Posted)</h3>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-2">
            <label class="form-label">From</label>
            <input asp-for="FromDate" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To</label>
            <input asp-for="ToDate" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Type</label>
            <select asp-for="TypeFilter" class="form-select">
                <option value="B">Both</option>
                <option value="R">Receipts</option>
                <option value="P">Payments</option>
            </select>
        </div>
        <div class="col-md-2 align-self-end">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </form>

    <div class="mb-2">
        <strong>Receipts:</strong> @Model.ReceiptTotal.ToString("N2") &nbsp;|&nbsp;
        <strong>Payments:</strong> @Model.PaymentTotal.ToString("N2") &nbsp;|&nbsp;
        <strong>Net:</strong> @((Model.ReceiptTotal - Model.PaymentTotal).ToString("N2"))
    </div>

    <table class="table table-sm table-striped">
        <thead><tr><th>Vou No</th><th>Vou Date</th><th>Type</th><th>Tr No</th><th>Tr Date</th><th>AccNo</th><th>Dept</th><th class="text-end">Amount</th></tr></thead>
        <tbody>
            @foreach (var h in Model.Entries)
            {
                foreach (var d in h.Details)
                {
                    <tr>
                        <td>@h.VouNo</td>
                        <td>@h.VouDate.ToString("dd-MM-yyyy")</td>
                        <td>@h.TrType</td>
                        <td>@h.TrNo</td>
                        <td>@h.TrDate.ToString("dd-MM-yyyy")</td>
                        <td>@d.AccNo</td>
                        <td>@d.Dept</td>
                        <td class="text-end">@d.Amount.ToString("N2")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <a asp-page="/cashier" class="btn btn-secondary">Back</a>
</div>