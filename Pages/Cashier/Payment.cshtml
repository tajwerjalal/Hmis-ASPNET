@page
@model HmisWeb.Pages.Cashier.PaymentModel
@{
    ViewData["Title"] = "Cash Payments";
}

<div class="container-fluid mt-3">
    <h3><i class="bi bi-cash"></i> Cash Payments Transaction</h3>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success">@Model.Success</div>
    }

    <form method="post" asp-page-handler="Save">
        <div class="row g-2 mb-3">
            <div class="col-md-2">
                <label class="form-label">Date</label>
                <input asp-for="Input.TrDate" type="date" class="form-control" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Time</label>
                <input asp-for="Input.TrTime" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Type</label>
                <input asp-for="Input.Type" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Register No.</label>
                <input asp-for="Input.RegNo" type="number" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Expense Code</label>
                <input asp-for="Input.ECode" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Reference</label>
                <input asp-for="Input.Reference" class="form-control" />
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-2">
                <label class="form-label">Discount</label>
                <input asp-for="Input.CDisc" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Discount By</label>
                <input asp-for="Input.DiscBy" class="form-control" />
            </div>
        </div>

        <h5>Detail Lines</h5>
        <table class="table table-sm table-bordered" id="linesTable">
            <thead class="table-light">
                <tr><th>Account Head</th><th>Dept</th><th>Indent No</th><th>Remarks</th><th class="text-end">Amount</th></tr>
            </thead>
            <tbody>
                @for (int i = 0; i < (Model.Input.Lines?.Count ?? 0); i++)
                {
                    <tr>
                        <td>
                            <select asp-for="Input.Lines[i].AccNo" class="form-select form-select-sm">
                                <option value="">-- select --</option>
                                @foreach (var a in Model.AccountHeads)
                                {
                                    <option value="@a.AccNo">@a.AccNo - @a.AccDesc</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select asp-for="Input.Lines[i].Dept" class="form-select form-select-sm">
                                <option value="">--</option>
                                @foreach (var d in Model.Departments)
                                {
                                    <option value="@d.Code">@d.Code - @d.Name</option>
                                }
                            </select>
                        </td>
                        <td><input asp-for="Input.Lines[i].IndentNo" class="form-control form-control-sm" /></td>
                        <td><input asp-for="Input.Lines[i].Remarks" class="form-control form-control-sm" /></td>
                        <td><input asp-for="Input.Lines[i].Amount" type="number" step="0.01" class="form-control form-control-sm text-end" /></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mb-3">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addLine()">+ Add Line</button>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Payment</button>
        <a asp-page="/cashier" class="btn btn-secondary">Back</a>
    </form>

    <hr />
    <h5>Recent Payments</h5>
    <table class="table table-sm table-striped">
        <thead><tr><th>P.V. No.</th><th>Date</th><th>RegNo</th><th>Total</th><th>User</th></tr></thead>
        <tbody>
            @foreach (var p in Model.Recent)
            {
                <tr><td>@p.TrNo</td><td>@p.TrDate.ToString("dd-MM-yyyy")</td><td>@p.RegNo</td><td class="text-end">@p.TotalAmt.ToString("N2")</td><td>@p.UserId</td></tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function addLine() {
            var tbody = document.querySelector('#linesTable tbody');
            var idx = tbody.rows.length;
            var row = tbody.insertRow();
            row.innerHTML = '<td><select name="Input.Lines[' + idx + '].AccNo" class="form-select form-select-sm"><option value="">-- select --</option>@foreach (var a in Model.AccountHeads){<text><option value="@a.AccNo">@a.AccNo - @a.AccDesc</option></text>}</select></td>' +
                '<td><select name="Input.Lines[' + idx + '].Dept" class="form-select form-select-sm"><option value="">--</option>@foreach (var d in Model.Departments){<text><option value="@d.Code">@d.Code - @d.Name</option></text>}</select></td>' +
                '<td><input name="Input.Lines[' + idx + '].IndentNo" class="form-control form-control-sm" /></td>' +
                '<td><input name="Input.Lines[' + idx + '].Remarks" class="form-control form-control-sm" /></td>' +
                '<td><input name="Input.Lines[' + idx + '].Amount" type="number" step="0.01" class="form-control form-control-sm text-end" /></td>';
        }
    </script>
}