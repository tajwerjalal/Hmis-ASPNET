@page
@model HmisWeb.Pages.Cashier.ChangeKeyModel
@{
    ViewData["Title"] = "Change Activation Key";
}
<div class="container mt-4">
    <h3><i class="bi bi-key"></i> Change Activation Key</h3>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    @if (!string.IsNullOrEmpty(Model.Success)) { <div class="alert alert-success">@Model.Success</div> }

    <form method="post" asp-page-handler="Save" class="row g-2 mb-3">
        <div class="col-md-2">
            <label class="form-label">Counter Code</label>
            <input asp-for="Input.CCode" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Line Code</label>
            <input asp-for="Input.LCode" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Old Key</label>
            <input asp-for="Input.OldKey" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">New Key</label>
            <input asp-for="Input.NewKey" class="form-control" />
        </div>
        <div class="col-md-2 align-self-end">
            <button type="submit" class="btn btn-primary">Change</button>
        </div>
    </form>

    <table class="table table-sm table-striped">
        <thead><tr><th>Code</th><th>Desc</th><th>Active Date</th><th>Active By</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var s in Model.Sessions)
            {
                <tr><td>@s.CCode</td><td>@s.Desc</td><td>@s.ActiveDt?.ToString("dd-MM-yyyy")</td><td>@s.ActiveBy</td><td>@s.Status</td></tr>
            }
        </tbody>
    </table>
    <a asp-page="/cashier" class="btn btn-secondary">Back</a>
</div>