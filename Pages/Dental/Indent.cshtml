@page "/dental/indent"
@model HmisWeb.Pages.Dental.IndentModel
@*
    Dental indent screen (route /dental/indent).

    Purpose
      Renders the shared department indent UI so the Dental process is identical
      to Ultrasound: patient search, IPD detection, service popup, cart, save.

    Why
      The page used to read INV-DNT-* rows from [ITEM] and had its own layout.
      It now uses the SERVICES DEPT 04 catalogue and the shared process.

    Business rules / validations
      Handled by the shared page model (patient + one line required, DEPT 04
      services only, panel rate resolution, discount clamping, IPD vs OPD).

    Developer : AI Assistant
    Created   : 27-Oct-2026 11:27
*@
@{
    ViewData["Title"] = "Dental Service Indent (Invoice)";
}

<partial name="_DepartmentIndent" model="Model" />

@section Scripts {
    <script src="~/js/department-indent.js" asp-append-version="true"></script>
}
