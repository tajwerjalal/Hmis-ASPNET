@page "/dental/Reports/AuditStatement"
@model HmisWeb.Pages.Dental.Reports.AuditStatementModel
@{
    ViewData["Title"] = "Audit Statement";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-journal-check me-2 text-primary"></i>Audit Statement</h4>
        <div class="text-secondary small">Migrated from VFP report us0201</div>
    </div>
    <a asp-page="/Hospital/Reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Reports</a>
</div>

<form method="get" class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">Date from</label>
                <input asp-for="FromDate" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Date to</label>
                <input asp-for="ToDate" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Patient type</label>
                <select asp-for="PatientType" class="form-select form-select-sm">
                    <option>Both</option>
                    <option>Opd</option>
                    <option>Ipd</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Company type</label>
                <select asp-for="CompanyType" class="form-select form-select-sm">
                    <option>Both</option>
                    <option>Private</option>
                    <option>Panel</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Company</label>
                <select asp-for="CompanyId" class="form-select form-select-sm">
                    <option value="">-- all --</option>
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Reg no / name</label>
                <input asp-for="RegNo" class="form-control form-control-sm" placeholder="optional" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="WholePeriod" class="form-check-input" />
                    <label class="form-check-label small" for="WholePeriod">Whole period</label>
                </div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>View</button>
                <a asp-page="/Hospital/Reports/AuditStatement" asp-page-handler="Export" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-filetype-csv me-1"></i>CSV
                </a>
                @if (Model.Rows.Any())
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="asPrint()">
                        <i class="bi bi-printer me-1"></i>Print
                    </button>
                }
            </div>
        </div>
    </div>
</form>

@if (!Model.Searched)
{
    <div class="alert alert-info py-2"><i class="bi bi-info-circle me-1"></i>Choose the filters above and press View.</div>
}
else if (!Model.Rows.Any())
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>No Record Found</div>
}
else
{
    <div class="card">
        <div class="card-header bg-white fw-semibold d-flex flex-wrap justify-content-between gap-2">
            <span>@Model.Rows.Count line(s)</span>
            <span>@Model.PeriodText</span>
            <span>Charges: <strong>@Model.TotalCharges.ToString("N2")</strong> &nbsp;|&nbsp; Net: <strong>@Model.TotalNet.ToString("N2")</strong></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" id="asTable" style="max-height:70vh;overflow:auto">
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Indent</th>
                            <th>Reg No</th>
                            <th>Patient</th>
                            <th>Type</th>
                            <th>Group</th>
                            <th>Code</th>
                            <th>Service</th>
                            <th class="text-end">Charges</th>
                            <th>Company</th>
                            <th class="text-end">Bill Total</th>
                            <th class="text-end">Concession</th>
                            <th class="text-end">Net</th>
                            <th class="text-end">Balance</th>
                            <th>Posted</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td>@(r.Date?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@r.IndentNo</td>
                                <td>@(r.RegNo ?? "-")</td>
                                <td>@r.PatientName</td>
                                <td>@r.PatientType</td>
                                <td>@r.Group</td>
                                <td>@r.Code</td>
                                <td>@r.Service</td>
                                <td class="text-end">@r.Charges.ToString("N2")</td>
                                <td>@r.Company</td>
                                <td class="text-end">@r.BillTotal.ToString("N2")</td>
                                <td class="text-end">@r.Concession.ToString("N2")</td>
                                <td class="text-end">@r.Net.ToString("N2")</td>
                                <td class="text-end">@r.Balance.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-@(r.Posted ? "success" : "warning")">@(r.Posted ? "Posted" : "Un-Posted")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function asPrint() {
            var w = window.open('', '_blank', 'width=1200,height=1200');
            if (!w) { alert('Allow pop-ups to print the report.'); return; }
            var css = 'body{font-family:Segoe UI,Arial,sans-serif;font-size:8pt;padding:12mm;color:#000}' +
                      'table{border-collapse:collapse;width:100%;font-size:7.5pt}' +
                      'th,td{border:1px solid #999;padding:2px 4px}' +
                      'th{background:#f0f0f0;text-align:left}' +
                      'h1{font-size:13pt;text-align:center;margin:0 0 2px}' +
                      '.sub{text-align:center;color:#555;font-size:9pt;margin-bottom:8px}' +
                      'thead{display:table-header-group}' +
                      'tr{page-break-inside:avoid}' +
                      '@@page{margin:10mm}';
            w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Audit Statement</title><style>' + css + '</style></head><body>');
            w.document.write('<h1>AUDIT STATEMENT</h1>');
            w.document.write('<div class="sub">Ultrasound &nbsp;|&nbsp; @Model.PeriodText &nbsp;|&nbsp; @Model.Rows.Count line(s)</div>');
            w.document.write(document.getElementById('asTable').innerHTML);
            w.document.write('<\/body><\/html>');
            w.document.close();
            w.focus();
            setTimeout(function () { w.print(); }, 400);
        }
    </script>
}