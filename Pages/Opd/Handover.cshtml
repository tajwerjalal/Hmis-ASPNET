@page "/opd/handover"
@model HmisWeb.Pages.Opd.HandoverModel
@{
    ViewData["Title"] = "Consultant Handover";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-cash-coin me-1 text-primary"></i>Handover to Consultants</h4>
        <div class="text-secondary small">Hand over the day's consultant consultation fees to each consultant and record the receipt.</div>
    </div>
    <form method="get" class="d-flex gap-2 align-items-center">
        <input asp-for="SessionDate" type="date" class="form-control form-control-sm" />
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-calendar2-check me-1"></i> Show</button>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle me-1"></i>@Model.ErrorMessage</div>
}

@if (Model.Receipt != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="print-area">
                <div class="text-center border-bottom pb-3 mb-3">
                    <div class="fw-bold fs-5">@Model.Receipt.HospitalName</div>
                    <div class="small">Consultant Settlement / Handover Receipt</div>
                    <div class="text-muted small">Settlement No: @Model.Receipt.ReferenceNo &middot; @Model.Receipt.ReceivedAt.ToString("dd MMM yyyy HH:mm")</div>
                </div>
                <div class="row small mb-2">
                    <div class="col-6"><b>Consultant:</b> @Model.Receipt.ConsultantName</div>
                    <div class="col-6 text-end"><b>Received by:</b> @Model.Receipt.ReceivedByName</div>
                </div>
                <div class="row small mb-2">
                    <div class="col-6"><b>Bills:</b> @Model.Receipt.BillCount</div>
                    <div class="col-6 text-end"><b>Tokens:</b> @Model.Receipt.TokenCount</div>
                </div>
                <table class="table table-sm mb-2">
                    <tr><td>Hospital fees (collected)</td><td class="text-end">@Model.Receipt.AmountHospital.ToString("N2")</td></tr>
                    <tr class="fw-bold"><td>Consultant fees handed over</td><td class="text-end">@Model.Receipt.AmountHandedOver.ToString("N2")</td></tr>
                    <tr class="fw-bold"><td>Settlement total</td><td class="text-end">@Model.Receipt.AmountTotal.ToString("N2")</td></tr>
                    <tr><td>Payment method</td><td class="text-end">@Model.Receipt.PaymentMethod</td></tr>
                </table>
                <div class="text-center text-muted small mt-3">Signature of consultant: ____________________ &nbsp;&nbsp; Signature of cashier: ____________________</div>
            </div>
            <div class="d-flex gap-2 mt-3 no-print">
                <button type="button" onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer me-1"></i> Print</button>
                <a asp-page="/Opd/Handover" asp-route-SessionDate="@Model.ViewDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Done</a>
            </div>
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-hourglass-split me-1 text-warning"></i>Pending Handover - @Model.ViewDate.ToString("dd MMM yyyy")</div>
            <div class="card-body">
                @if (!Model.PendingGroups.Any())
                {
                    <div class="text-muted text-center py-4">
                        <i class="bi bi-check2-all d-block fs-2 text-success mb-1"></i>
                        All consultant collections for this day have been handed over.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Consultant</th>
                                    <th class="text-center">Tokens</th>
                                    <th class="text-end">Hospital Fee</th>
                                    <th class="text-end">Consultant Fee</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Model.PendingGroups)
                                {
                                    <tr>
                                        <td class="fw-semibold">@g.ConsultantName</td>
                                        <td class="text-center">@g.TokenCount</td>
                                        <td class="text-end">@g.HospitalFee.ToString("N2")</td>
                                        <td class="text-end">@g.ProfessionalFee.ToString("N2")</td>
                                        <td class="text-end fw-semibold">@g.Total.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-cash-coin me-1 text-success"></i>Hand Over</div>
            <div class="card-body">
                <form method="post" asp-page-handler="Create">
                    <div class="mb-3">
                        <label class="form-label">Consultant</label>
                        <select asp-for="ConsultantId" class="form-select">
                            <option value="">-- Select consultant --</option>
                            @foreach (var g in Model.PendingGroups)
                            {
                                <option value="@g.ConsultantId">@g.ConsultantName (Rs. @g.ProfessionalFee.ToString("N0"))</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Received by (consultant or representative)</label>
                        <select asp-for="ReceivedById" asp-items="Model.ReceiverOptions" class="form-select">
                            <option value="">-- Select receiver --</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-send-check me-1"></i>Hand Over &amp; Generate Receipt
                    </button>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-clock-history me-1 text-secondary"></i>Settlements - @Model.ViewDate.ToString("dd MMM yyyy")</div>
            <div class="card-body p-0">
                @if (!Model.History.Any())
                {
                    <div class="text-muted text-center py-4 small">No settlements recorded.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Consultant</th>
                                    <th class="text-end">Handed Over</th>
                                    <th class="text-center">Received by</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.History)
                                {
                                    <tr>
                                        <td>
                                            <div>@h.ConsultantName</div>
                                            <div class="text-muted small">@h.BillCount bills &middot; @h.TokenCount tokens &middot; @(h.ReceivedAt?.ToString("HH:mm") ?? "")</div>
                                        </td>
                                        <td class="text-end fw-semibold">@h.AmountHandedOver.ToString("N2")</td>
                                        <td class="text-center small">@h.ReceivedByName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>