@page "/opd/Billing"
@model HmisWeb.Pages.Opd.BillingModel
@{
    ViewData["Title"] = "Generate OPD Bill";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Generate OPD Bill</h4>
        <div class="text-muted small">Batch-generate OPD bills from PreBill / outstanding slips within a period. Mark patients to bill, then click Generate.</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Message</div>
}

<form method="post">
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label mb-1 small fw-bold">Bill Date</label>
                    <input asp-for="BillDate" type="date" class="form-control form-control-sm" style="width:140px;" />
                </div>
                <div class="col-auto">
                    <label class="form-label mb-1 small fw-bold">Period</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">From :</span>
                        <input asp-for="FromDate" type="date" class="form-control" style="width:135px;" />
                    </div>
                </div>
                <div class="col-auto">
                    <label class="form-label mb-1 small fw-bold" style="visibility:hidden">To</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">To :</span>
                        <input asp-for="ToDate" type="date" class="form-control" style="width:135px;" />
                    </div>
                </div>
                <div class="col-auto">
                    <div class="form-check mb-1">
                        <input asp-for="FilterByCompany" class="form-check-input" type="checkbox" id="chkcid" />
                        <label class="form-check-label small" for="chkcid">Company</label>
                    </div>
                    <select asp-for="CompanyId" class="form-select form-select-sm" style="width:220px;">
                        <option value="">-- All Companies --</option>
                        @foreach (var c in Model.CompanyList)
                        {
                            <option value="@c.Value">@c.Text</option>
                        }
                    </select>
                </div>
                <div class="col-auto ms-auto">
                    <button type="submit" asp-page-handler="UpdateList" class="btn btn-primary">
                        <i class="bi bi-arrow-clockwise me-1"></i>Update List
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-11">
            <div class="card">
                <div class="card-body p-0">
                    @if (Model.Rows.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="billGrid">
                                <thead class="table-light">
                                    <tr>
                                        <th>Reg. No.</th>
                                        <th>Patient Name</th>
                                        <th>Company</th>
                                        <th class="text-end">Net Amount</th>
                                        <th class="text-center">Selected</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Rows.Count; i++)
                                    {
                                        var r = Model.Rows[i];
                                        <tr>
                                            <td class="fw-semibold">@r.RegNo</td>
                                            <td>@r.PatientName</td>
                                            <td>@r.CompanyName</td>
                                            <td class="text-end fw-semibold">@r.NetAmount.ToString("N2")</td>
                                            <td class="text-center">
                                                <input class="form-check-input row-check" type="checkbox"
                                                       name="SelectedIds" value="@r.EncounterId" checked="checked" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                            <span class="text-secondary small">
                                @Model.Rows.Count patient(s) listed. Check/uncheck rows or use the buttons on the right.
                            </span>
                            <span class="fw-bold">
                                Total: @Model.Rows.Sum(r => r.NetAmount).ToString("N2")
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-secondary" style="font-size:2.2rem;"></i>
                            <p class="text-secondary mt-2 mb-0">No unbilled slips in the selected period. Set dates and click Update List.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-1">
            <div class="card">
                <div class="card-body p-2 d-flex flex-column gap-2">
                    <button type="button" class="btn btn-outline-success btn-sm" onclick="selectActive()">Select</button>
                    <button type="button" class="btn btn-outline-warning btn-sm" onclick="deselectActive()">De-Select</button>
                    <button type="button" class="btn btn-outline-success btn-sm" onclick="selectAll()">Select All</button>
                    <button type="button" class="btn btn-outline-warning btn-sm" onclick="deselectAll()">De-Select All</button>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center gap-3 mt-3">
        <button type="submit" asp-page-handler="Generate" class="btn btn-success px-4">
            <i class="bi bi-cash-coin me-1"></i>Generate
        </button>
        <a asp-page="/opd/Billing" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        var grid = document.getElementById('billGrid');
        var activeRow = null;

        if (grid) {
            grid.querySelectorAll('tbody tr').forEach(function (tr) {
                tr.addEventListener('click', function () {
                    if (grid.querySelector('tr.row-active')) {
                        grid.querySelector('tr.row-active').classList.remove('row-active');
                    }
                    tr.classList.add('row-active');
                    activeRow = tr;
                });
            });
        }

        function rowCheck(r) {
            return r ? r.querySelector('.row-check') : null;
        }

        function selectAll() {
            if (grid) grid.querySelectorAll('.row-check').forEach(function (c) { c.checked = true; });
        }

        function deselectAll() {
            if (grid) grid.querySelectorAll('.row-check').forEach(function (c) { c.checked = false; });
        }

        function selectActive() {
            var c = rowCheck(activeRow);
            if (c) c.checked = true;
        }

        function deselectActive() {
            var c = rowCheck(activeRow);
            if (c) c.checked = false;
        }
    </script>
}