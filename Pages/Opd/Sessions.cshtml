@page "/opd/sessions"
@model HmisWeb.Pages.Opd.SessionsModel
@{
    ViewData["Title"] = "OPD Sessions";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0 fw-bold">OPD Consultant Sessions</h4>
        <div class="text-secondary small">Allocate consultants, rooms, token ranges and fees for the day.</div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a asp-page="/Opd/Registration" asp-route-SessionDate="@Model.SessionDate?.ToString("yyyy-MM-dd")"
           class="btn btn-sm btn-success">
            <i class="bi bi-person-plus me-1"></i>Registration
        </a>
        <a asp-page="/Hr/Consultants" class="btn btn-sm btn-outline-primary"><i class="bi bi-person-badge me-1"></i>Consultants</a>
        <form method="get" class="d-flex gap-2 align-items-center">
            <input asp-for="SessionDate" type="date" class="form-control form-control-sm" />
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-calendar2-check me-1"></i> Load Day</button>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Message</div>
}

@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@Model.Success</div>
}

@if (Model.AutoCreatedCount > 0)
{
    <div class="alert alert-success py-2">
        <i class="bi bi-check-circle me-1"></i>
        @Model.AutoCreatedCount scheduled session(s) created automatically for this date.
        <a href="#todaySessions" class="alert-link">View sessions</a>
    </div>
}

@{
    var autoGroups = Model.AutoSlots
        .GroupBy(s => new { s.GroupOrder, s.GroupTitle })
        .OrderBy(g => g.Key.GroupOrder)
        .ToList();
}

<div class="card mb-4 border-primary">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="fw-semibold">
            <i class="bi bi-magic me-1 text-primary"></i>
            Auto-fill sessions - @Model.SessionDate?.ToString("dddd, dd MMM yyyy")
        </span>
        <span class="small text-secondary">
            @Model.AutoSlots.Count additional proposal(s);
            <a href="#todaySessions">@Model.Sessions.Count session(s) on this date</a>.
            Consultants scheduled for the day are created automatically.
        </span>
    </div>
    <div class="card-body">
        @if (!Model.AutoSlots.Any())
        {
            <div class="alert alert-info py-2 mb-0">
                No proposals for this day. Set the consultants' working days and clinic times in
                <a asp-page="/Consultants/Index">Consultants</a>, or use the manual form below.
            </div>
        }
        else
        {
            <form method="post" asp-page-handler="AutoCreate">
                <input type="hidden" asp-for="SessionDate" id="autoSessionDate" />

                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <input type="search" id="autoFilter" class="form-control form-control-sm"
                           style="max-width:300px" placeholder="Filter consultant, speciality, room or time" />
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="autoTickVisible">
                        <i class="bi bi-check2-all me-1"></i>Tick visible
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="autoClear">
                        <i class="bi bi-x-square me-1"></i>Clear ticks
                    </button>
                    <span class="small text-secondary">
                        A consultant without a configured window is proposed at 08:00 - 12:00.
                    </span>
                </div>

                <div class="table-responsive border rounded" style="max-height:460px; overflow-y:auto">
                    <table class="table table-sm table-hover align-middle mb-0" id="autoTable">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width:42px"></th>
                                <th>Consultant</th>
                                <th>Speciality</th>
                                <th>Window</th>
                                <th>Room</th>
                                <th class="text-end">Consultant Fee</th>
                                <th class="text-end">Hospital Charge</th>
                                <th class="text-center">Max Tokens</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in autoGroups)
                            {
                                <tr class="table-secondary">
                                    <td colspan="8">
                                        <span class="fw-semibold">@group.Key.GroupTitle</span>
                                        <span class="badge bg-secondary ms-1">@group.Count()</span>
                                        @if (group.Key.GroupOrder == 0)
                                        {
                                            <span class="small text-success ms-2">
                                                <i class="bi bi-check2-circle me-1"></i>pre-ticked
                                            </span>
                                        }
                                    </td>
                                </tr>

                                @foreach (var s in group)
                                {
                                    var search = ($"{s.ConsultantName} {s.SpecialityName} {s.RoomNo} {s.FromTime} {s.ToTime} {s.Period}").ToLowerInvariant();
                                    <tr data-search="@search">
                                        <td class="text-center">
                                            <input class="form-check-input auto-tick" type="checkbox"
                                                   name="selected" value="@s.Key"
                                                   checked="@(s.ScheduledToday ? "checked" : null)" />
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@s.ConsultantName</div>
                                            <div class="small text-muted">@s.Period</div>
                                        </td>
                                        <td class="small">@(string.IsNullOrWhiteSpace(s.SpecialityName) ? "-" : s.SpecialityName)</td>
                                        <td class="small text-nowrap">
                                            @s.FromTime@(string.IsNullOrWhiteSpace(s.ToTime) ? " - open" : " - " + s.ToTime)
                                        </td>
                                        <td><span class="badge bg-secondary">@s.RoomNo</span></td>
                                        <td class="text-end">@s.Fee.ToString("N2")</td>
                                        <td class="text-end">@s.HospitalFee.ToString("N2")</td>
                                        <td class="text-center">@s.TokenMax</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                    <button type="submit" name="startNow" value="false" class="btn btn-primary">
                        <i class="bi bi-check2-square me-1"></i>Create ticked sessions
                    </button>
                    <button type="submit" name="startNow" value="true" class="btn btn-success">
                        <i class="bi bi-play-fill me-1"></i>Create &amp; start ticked
                    </button>
                    <span class="small text-secondary">
                        Only the ticked rows are created; sessions already on the day are skipped.
                    </span>
                </div>
            </form>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-plus-circle me-1 text-primary"></i>New OPD Session</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create">
            <input type="hidden" asp-for="SessionDate" />
            <div class="row g-3">
                <div class="col-md-4 col-xl-3">
                    <label asp-for="ConsultantId" class="form-label">Consultant *</label>
                    <select asp-for="ConsultantId" id="consultantSelect" class="form-select">
                        <option value="">-- Select Consultant --</option>
                        @foreach (var c in Model.ConsultantOptions)
                        {
                            <option value="@c.Id"
                                    data-first="@c.FirstVisitFee.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-sub="@c.SubsequentVisitFee.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-start="@c.SessionStartTime"
                                    data-end="@c.SessionEndTime"
                                    data-room="@c.DefaultRoomNo"
                                    data-hospfee="@c.DefaultHospitalFee.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-days="@c.WorkDays"
                                    data-spec="@(c.SpecialityId?.ToString() ?? "")">@c.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 col-xl-3">
                    <label asp-for="SpecialityId" class="form-label">Speciality</label>
                    <select asp-for="SpecialityId" asp-items="Model.SpecialityList" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="FromTime" class="form-label">Start *</label>
                    <input asp-for="FromTime" type="time" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="ToTime" class="form-label">End (optional)</label>
                    <input asp-for="ToTime" type="time" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="RoomNo" class="form-label">Room</label>
                    <input asp-for="RoomNo" class="form-control" placeholder="OPD-1" />
                </div>
                <div class="col-md-4 col-xl-2">
                    <label asp-for="Fee" class="form-label">Consultant Fee (LKR)</label>
                    <input asp-for="Fee" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-4 col-xl-2">
                    <label asp-for="HospitalFee" class="form-label">Hospital Charge (LKR)</label>
                    <input asp-for="HospitalFee" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-2 col-xl-2">
                    <label asp-for="TokenStartingNo" class="form-label">Starts At</label>
                    <input asp-for="TokenStartingNo" type="number" min="1" class="form-control" />
                </div>
                <div class="col-md-2 col-xl-2">
                    <label asp-for="TokenMax" class="form-label">Max Tokens</label>
                    <input asp-for="TokenMax" type="number" min="1" class="form-control" />
                </div>
                <div class="col-md-4 col-xl-4">
                    <label asp-for="Note" class="form-label">Note</label>
                    <input asp-for="Note" class="form-control" />
                </div>
                <div class="col-md-12 d-flex gap-2 align-items-center">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-plus-lg me-1"></i> Create Session</button>
                    <button type="submit" formaction="@Url.Page("/Opd/Sessions", "CreateAndStart")" class="btn btn-success px-4">
                        <i class="bi bi-play-fill me-1"></i> Create &amp; Start Now
                    </button>
                    <span class="small text-secondary">Create &amp; Start immediately opens the session for registration.</span>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card" id="todaySessions">
    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-calendar3 me-1 text-primary"></i>Sessions on @Model.SessionDate?.ToString("dd MMMM yyyy")</span>
        <div class="d-flex gap-2 align-items-center">
            @if (Model.Sessions.Any(s => s.Status == HmisWeb.Data.Enums.OpdSessionStatus.Scheduled))
            {
                <form method="post" asp-page-handler="StartAll"
                      asp-route-SessionDate="@Model.SessionDate?.ToString("yyyy-MM-dd")" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-success" title="Mark every scheduled session active">
                        <i class="bi bi-play-fill me-1"></i>Start all scheduled
                    </button>
                </form>
            }
            <span class="badge bg-primary">@Model.Sessions.Count</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Consultant</th>
                    <th>Speciality</th>
                    <th>Room</th>
                    <th>Time</th>
                    <th class="text-end">Consultant Fee</th>
                    <th class="text-end">Hospital Charge</th>
                    <th class="text-center">Tokens</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Sessions.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-3">No sessions for this day. Create one above.</td></tr>
                }
                @foreach (var s in Model.Sessions)
                {
                    <tr>
                        <td class="fw-semibold">@s.ConsultantName</td>
                        <td>@(s.SpecialityName ?? "-")</td>
                        <td><span class="badge bg-secondary">@s.RoomNo</span></td>
                        <td>@s.FromTime@(string.IsNullOrEmpty(s.ToTime) ? " – open" : " – " + s.ToTime)</td>
                        <td class="text-end">@s.Fee.ToString("N2")</td>
                        <td class="text-end">@s.HospitalFee.ToString("N2")</td>
                        <td class="text-center">
                            <span class="fw-semibold">@(s.TokenStartingNo + s.IssuedTokens - 1)</span>
                            <span class="text-muted">/ @s.TokenMax</span>
                            <div class="small text-muted">@s.IssuedTokens issued</div>
                        </td>
                        <td>
                            @switch (s.Status)
                            {
                                case HmisWeb.Data.Enums.OpdSessionStatus.Scheduled:
                                    <span class="badge bg-warning text-dark">Scheduled</span>
                                    break;
                                case HmisWeb.Data.Enums.OpdSessionStatus.Active:
                                    <span class="badge bg-success">Active</span>
                                    break;
                                case HmisWeb.Data.Enums.OpdSessionStatus.Completed:
                                    <span class="badge bg-secondary">Completed</span>
                                    break;
                                default:
                                    <span class="badge bg-danger">Cancelled</span>
                                    break;
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (s.Status == HmisWeb.Data.Enums.OpdSessionStatus.Scheduled)
                            {
                                <form method="post" asp-page-handler="Start" asp-route-id="@s.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mark active / start"><i class="bi bi-play-fill"></i></button>
                                </form>
                                <form method="post" asp-page-handler="Cancel" asp-route-id="@s.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel"><i class="bi bi-x-lg"></i></button>
                                </form>
                            }
                            @if (s.Status == HmisWeb.Data.Enums.OpdSessionStatus.Active)
                            {
                                <form method="post" asp-page-handler="Complete" asp-route-id="@s.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="End / complete session"><i class="bi bi-stop-fill"></i></button>
                                </form>
                            }
                            <a asp-page="/Opd/TokenBoard" asp-route-sessionId="@s.Id" class="btn btn-sm btn-outline-primary" title="Token board">
                                <i class="bi bi-card-list"></i>
                            </a>
                            @if (s.Status == HmisWeb.Data.Enums.OpdSessionStatus.Scheduled
                                 || s.Status == HmisWeb.Data.Enums.OpdSessionStatus.Active)
                            {
                                <a asp-page="/Opd/Registration"
                                   asp-route-SessionDate="@Model.SessionDate?.ToString("yyyy-MM-dd")"
                                   asp-route-sessionId="@s.Id"
                                   class="btn btn-sm btn-outline-success" title="Register a patient in this session">
                                    <i class="bi bi-person-plus"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        var dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

        // the session may be created for a day other than today, so use the date
        // on the screen; the day name is compared case-insensitively because the
        // register stores MON,TUE,... and JavaScript day names are Mon,Tue,...
        function selectedDayName() {
            var input = document.getElementById('SessionDate');
            if (input && input.value) {
                var parts = input.value.split('-');
                if (parts.length === 3) {
                    var d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
                    if (!isNaN(d.getTime())) return dayNames[d.getDay()];
                }
            }
            return dayNames[new Date().getDay()];
        }

        function scheduledDays(value) {
            return (value || '')
                .toUpperCase()
                .split(',')
                .map(function (d) { return d.trim(); })
                .filter(function (d) { return d.length > 0; });
        }

        document.getElementById('consultantSelect').addEventListener('change', function () {
            var opt = this.options[this.selectedIndex];
            var $ = function (id) { return document.getElementById(id); };
            var fee = $('Fee'), hosp = $('HospitalFee'), start = $('FromTime'), end = $('ToTime'), room = $('RoomNo'), spec = $('SpecialityId');
            var msg = $('dayWarning');
            if (msg) msg.remove();

            if (!opt || !opt.value) return;

            if (fee && opt.dataset.first && opt.dataset.first !== '0') fee.value = opt.dataset.first;
            if (opt.dataset.hospfee && start) {
                var hf = parseFloat(opt.dataset.hospfee);
                if (!isNaN(hf) && hosp && (hosp.value === '' || parseFloat(hosp.value) === 0)) hosp.value = hf.toFixed(2);
            }
            if (start) start.value = opt.dataset.start || '';
            if (end) end.value = opt.dataset.end || '';
            if (room) room.value = opt.dataset.room || '';
            if (spec && !spec.value && opt.dataset.spec) spec.value = opt.dataset.spec;

            if (opt.dataset.days && opt.dataset.days !== '') {
                var day = selectedDayName();
                var days = scheduledDays(opt.dataset.days);
                if (days.length > 0 && days.indexOf(day.toUpperCase()) === -1) {
                    var div = document.createElement('div');
                    div.id = 'dayWarning';
                    div.className = 'alert alert-warning py-1 px-3 mt-2 mb-0';
                    div.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>This consultant does not list <b>' + day + '</b> as a working day. Verify before creating the session.';
                    document.querySelector('.row.g-3').appendChild(div);
                }
            }
        });

        // ---- auto-fill panel: filter the roster and tick rows quickly --------
        (function () {
            var filter = document.getElementById('autoFilter');
            if (filter) {
                filter.addEventListener('input', function () {
                    var q = this.value.toLowerCase();
                    var rows = document.querySelectorAll('#autoTable tbody tr[data-search]');
                    for (var i = 0; i < rows.length; i++) {
                        var row = rows[i];
                        var text = row.getAttribute('data-search') || '';
                        if (q === '' || text.indexOf(q) !== -1) {
                            row.classList.remove('d-none');
                        } else {
                            row.classList.add('d-none');
                        }
                    }
                });
            }

            var tickVisible = document.getElementById('autoTickVisible');
            if (tickVisible) {
                tickVisible.addEventListener('click', function () {
                    var boxes = document.querySelectorAll('#autoTable tbody tr[data-search]:not(.d-none) .auto-tick');
                    for (var i = 0; i < boxes.length; i++) boxes[i].checked = true;
                });
            }

            var clear = document.getElementById('autoClear');
            if (clear) {
                clear.addEventListener('click', function () {
                    var boxes = document.querySelectorAll('#autoTable .auto-tick');
                    for (var i = 0; i < boxes.length; i++) boxes[i].checked = false;
                });
            }
        })();
    </script>
}