@page "/opd/RegistrationLegacy"
@model HmisWeb.Pages.Opd.RegistrationLegacyModel
@using HmisWeb.Data.Enums
@*
    Legacy-style OPD Registration (Phase 1) - mirrors opdreg.scx.
    Developer : [TAJWER JALAL]
    Date      : 23-Nov-2026
    Time      : 09:00
    Change Log: 23-Nov-2026 - Phase 1 created.
*@
@{
    ViewData["Title"] = "OPD Registration (Legacy)";
}
<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <h4 class="mb-0 fw-bold">OPD Registration</h4>
    <div class="d-flex gap-1 flex-wrap">
        <form method="post" asp-page-handler="Top" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@Model.ChkTop">⏮ First</button></form>
        <form method="post" asp-page-handler="Prev" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@Model.ChkTop">◀ Prev</button></form>
        <form method="post" asp-page-handler="Next" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@Model.ChkBottom">Next ▶</button></form>
        <form method="post" asp-page-handler="Bottom" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@Model.ChkBottom">Last ⏭</button></form>
        <form method="post" asp-page-handler="Add" class="d-inline"><button type="submit" class="btn btn-sm btn-success"><i class="bi bi-plus-lg"></i> Add</button></form>
        <form method="post" asp-page-handler="Edit" class="d-inline"><button type="submit" class="btn btn-sm btn-warning" disabled="@Model.ChgMode">Edit</button></form>
        <form method="post" asp-page-handler="Delete" class="d-inline"><button type="submit" class="btn btn-sm btn-danger" disabled="@Model.ChgMode" onclick="return confirm('Delete this record?')">Delete</button></form>
        <form method="post" asp-page-handler="Save" class="d-inline"><button type="submit" class="btn btn-sm btn-primary" disabled="@(!Model.ChgMode)">Save</button></form>
        <form method="post" asp-page-handler="Revert" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@(!Model.ChgMode)">Revert</button></form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger py-2">@Model.ErrorMessage</div> }
@if (!string.IsNullOrEmpty(Model.SuccessMessage)) { <div class="alert alert-success py-2">@Model.SuccessMessage</div> }
@if (!string.IsNullOrEmpty(Model.ValidMsg)) { <div class="alert alert-warning py-2">@Model.ValidMsg</div> }

<!-- Find -->
<form method="post" asp-page-handler="Find" class="d-flex gap-2 mb-2">
    <input asp-for="SearchTerm" class="form-control form-control-sm" placeholder="Find by Reg No / Patient Code / Name" />
    <button type="submit" class="btn btn-sm btn-outline-primary">Find</button>
    <form method="post" asp-page-handler="LoadList" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-info">List</button></form>
</form>

<ul class="nav nav-tabs mb-2" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#formTab">Form</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#listTab">List</a></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="formTab">
        <form method="post">
            <input type="hidden" asp-for="RegNo" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="card mb-2">
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-2">
                            <label class="form-label">OPD No</label>
                            <input asp-for="RegNo" class="form-control" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Reg Date</label>
                            <input asp-for="RegDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Reg Time</label>
                            <input asp-for="RegTime" class="form-control" placeholder="HH:mm" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Patient Code</label>
                            <div class="input-group">
                                <input asp-for="PCode" class="form-control" />
                                <button type="submit" asp-page-handler="SearchPatient" class="btn btn-outline-primary" title="Search patient"><i class="bi bi-search"></i></button>
                                <button type="button" class="btn btn-outline-info" onclick="togglePatientLookup(true)" title="Lookup patient"><i class="bi bi-list-ul"></i></button>
                                <button type="button" class="btn btn-outline-success" onclick="toggleNewPatient(true)" title="Add new patient"><i class="bi bi-person-plus"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-2">
                <div class="card-header bg-white fw-semibold">Patient Details</div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Name</label>
                            <input asp-for="PatientName" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Age</label>
                            <input asp-for="Age" type="number" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Unit</label>
                            <select asp-for="AType" class="form-select">
                                @foreach (var u in Model.AgeUnitList) { <option value="@u.Value">@u.Text</option> }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Sex</label>
                            <select asp-for="Sex" class="form-select">
                                <option value="">--</option>
                                @foreach (var s in Model.SexList) { <option value="@s.Value">@s.Text</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">N.I.C No</label>
                            <input asp-for="Nic" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Address</label>
                            <input asp-for="Address" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Phone 1</label>
                            <input asp-for="Phone1" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Phone 2</label>
                            <input asp-for="Phone2" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Phone 3</label>
                            <input asp-for="Phone3" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-2">
                <div class="card-header bg-white fw-semibold">Registration Details</div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-12">
                            <label class="form-label">Diagnosis</label>
                            <input asp-for="Diagnosis" class="form-control" maxlength="60" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Consultant</label>
                            <select asp-for="ConCode" class="form-select">
                                <option value="">-- Select --</option>
                                @foreach (var c in Model.ConsultantList) { <option value="@c.Value">@c.Text</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Company</label>
                            <select asp-for="Cid" class="form-select">
                                <option value="">-- Select --</option>
                                @foreach (var c in Model.CompanyList) { <option value="@c.Value">@c.Text</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">E.Code</label>
                            <select asp-for="ECode" class="form-select">
                                <option value="">-- Select --</option>
                                @foreach (var e in Model.EmployeeList) { <option value="@e.Value">@e.Text</option> }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Relation</label>
                            <input asp-for="ERelation" class="form-control" maxlength="1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ref No</label>
                            <input asp-for="RefNo" class="form-control" maxlength="20" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Valid Upto</label>
                            <input asp-for="RefValid" type="date" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Card No</label>
                            <input asp-for="CardNo" class="form-control" maxlength="10" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-2">
                <div class="card-header bg-white fw-semibold">Audit</div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label">Created By</label>
                            <input asp-for="CUserId" class="form-control" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Created Date</label>
                            <input asp-for="CDate" class="form-control" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Created Time</label>
                            <input asp-for="CTime" class="form-control" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Changed By</label>
                            <input asp-for="UserId" class="form-control" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Changed Date</label>
                            <input asp-for="UDate" class="form-control" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Changed Time</label>
                            <input asp-for="UTime" class="form-control" readonly />
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="tab-pane fade" id="listTab">
        <form method="post" asp-page-handler="LoadList">
            <button type="submit" class="btn btn-sm btn-primary mb-2">Load List</button>
        </form>
        @if (Model.ListRows.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Reg No</th><th>Reg Date</th><th>Reg Time</th><th>Patient Code</th><th>Name</th><th>Age</th><th>Sex</th><th>Address</th><th>Ph1</th><th>Ph2</th><th>Diagnose</th><th>Consultant</th><th>Company</th><th>Relation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ListRows)
                        {
                            <tr>
                                <td>@r.VisitRegNo</td>
                                <td>@(r.RDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@(r.RTime ?? "-")</td>
                                <td>@(r.PatientCode ?? r.PCode ?? "-")</td>
                                <td>@(r.Name ?? "-")</td>
                                <td>@(r.Age ?? "-")</td>
                                <td>@(r.Sex ?? "-")</td>
                                <td>-</td>
                                <td>@(r.Phone ?? "-")</td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- New Patient Modal -->
<div class="modal fade" id="newPatientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <form method="post" asp-page-handler="CreatePatient" class="modal-content">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="modal-header">
                <h5 class="modal-title">Add New Patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">Patient Code (auto)</label>
                        <input asp-for="NewPCode" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Full name *</label>
                        <input asp-for="PatientName" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date of Birth</label>
                        <input asp-for="NewDob" type="date" class="form-control" id="newDob" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Age</label>
                        <input asp-for="Age" type="number" class="form-control" id="newAge" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Unit</label>
                        <select asp-for="AType" class="form-select">
                            @foreach (var u in Model.AgeUnitList) { <option value="@u.Value">@u.Text</option> }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Sex</label>
                        <select asp-for="Sex" class="form-select">
                            <option value="">--</option>
                            @foreach (var s in Model.SexList) { <option value="@s.Value">@s.Text</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">NIC</label>
                        <input asp-for="Nic" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone 1</label>
                        <input asp-for="Phone1" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone 2</label>
                        <input asp-for="Phone2" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Address</label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success">Add &amp; Select</button>
            </div>
        </form>
    </div>
</div>

<!-- Patient Lookup Popup -->
<div class="modal fade" id="patientLookupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Patient Lookup</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="SearchPatientLookup" class="d-flex gap-2 mb-2">
                    <input type="text" name="term" class="form-control" placeholder="Search by code, name, PHN or phone..." value="@Model.PatientSearch" />
                    <button type="submit" class="btn btn-primary">Search</button>
                </form>
                @if (Model.PatientSearchResults.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr><th>Code</th><th>Name</th><th>Age</th><th>Sex</th><th>Phone</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PatientSearchResults)
                                {
                                    <tr>
                                        <td>@p.Code</td>
                                        <td>@(p.LegacyName ?? "-")</td>
                                        <td>@(p.LegacyAge ?? "-")</td>
                                        <td>@(p.LegacySex ?? "-")</td>
                                        <td>@(p.Phone1 ?? "-")</td>
                                        <td>
                                            <form method="post" asp-page-handler="SelectPatientLookup" class="d-inline">
                                                <input type="hidden" name="patientId" value="@p.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Select</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted small">No patients. Use Search or open Add New Patient.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleNewPatient(open) {
            var el = document.getElementById('newPatientModal');
            if (!el || typeof bootstrap === 'undefined') return;
            var m = bootstrap.Modal.getOrCreateInstance(el);
            if (open === false) m.hide(); else m.show();
        }
        function togglePatientLookup(open) {
            var el = document.getElementById('patientLookupModal');
            if (!el || typeof bootstrap === 'undefined') return;
            var m = bootstrap.Modal.getOrCreateInstance(el);
            if (open === false) m.hide(); else m.show();
        }
        // Auto-calculate age from Date of Birth
        document.addEventListener('DOMContentLoaded', function () {
            var dob = document.getElementById('newDob');
            var age = document.getElementById('newAge');
            if (dob && age) {
                dob.addEventListener('change', function () {
                    if (!dob.value) return;
                    var d = new Date(dob.value);
                    var today = new Date();
                    var a = today.getFullYear() - d.getFullYear();
                    if (today < new Date(today.getFullYear(), d.getMonth(), d.getDate())) a--;
                    if (a < 0) a = 0;
                    age.value = a;
                });
            }
            @if (Model.ShowNewPatientModal) { <text>toggleNewPatient(true);</text> }
            @if (Model.ShowPatientLookup) { <text>togglePatientLookup(true);</text> }
        });
    </script>
}