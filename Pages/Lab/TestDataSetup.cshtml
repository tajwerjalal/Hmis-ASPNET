@page "/lab/TestDataSetup"
@model HmisWeb.Pages.Lab.TestDataSetupModel
@{
    ViewData["Title"] = "Test Data Setup";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-table me-2 text-primary"></i>Test Data Setup</h4>
        <div class="text-secondary small">Test parameters with unit &amp; normal range &middot; mirrors VFP Labsys <code>lb0310</code></div>
    </div>
    <a asp-page="/lab/TestDataSetup" asp-route-add="1" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Test Data</a>
</div>

@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert alert-success alert-dismissible fade show py-2"><i class="bi bi-check-circle me-1"></i>@Model.Success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show py-2"><i class="bi bi-exclamation-triangle me-1"></i>@Model.ErrorMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (Model.Input.ShowForm)
{
    <div class="card mb-3 border-primary">
        <div class="card-header bg-primary-subtle fw-semibold">@(Model.Input.Id > 0 ? "Edit Test Data" : "New Test Data")</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Save">
                <input type="hidden" asp-for="Input.Id" />
                <div class="row g-3">
                    <div class="col-md-2"><label class="form-label small mb-1">Code</label><input asp-for="Input.Code" class="form-control form-control-sm" /></div>
                    <div class="col-md-4"><label class="form-label small mb-1">Name <span class="text-danger">*</span></label><input asp-for="Input.Name" class="form-control form-control-sm" required /></div>
                    <div class="col-md-2"><label class="form-label small mb-1">Unit</label><input asp-for="Input.Unit" class="form-control form-control-sm" /></div>
                    <div class="col-md-4"><label class="form-label small mb-1">Test Classification</label><select asp-for="Input.CategoryId" asp-items="Model.CategoryList" class="form-select form-select-sm"><option value="">-- None --</option></select></div>
                    <div class="col-md-4"><label class="form-label small mb-1">Normal Range</label><input asp-for="Input.Range" class="form-control form-control-sm" placeholder="e.g. 4.0 - 11.0" /></div>
                    <div class="col-md-2"><label class="form-label small mb-1">Order</label><input asp-for="Input.OrderNo" class="form-control form-control-sm" type="number" /></div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2 me-1"></i>Save</button>
                    <a asp-page="/lab/TestDataSetup" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" class="btn btn-outline-secondary btn-sm">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-4"><label class="form-label small mb-1">Search</label><input name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="code / name" /></div>
            <div class="col-md-3"><label class="form-label small mb-1">Test Classification</label>
                <select name="CategoryId" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var c in Model.CategoryList)
                    {
                        if (Model.CategoryId?.ToString() == c.Value) { <option value="@c.Value" selected>@c.Text</option> }
                        else { <option value="@c.Value">@c.Text</option> }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2"><button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filter</button><a asp-page="/lab/TestDataSetup" class="btn btn-outline-secondary btn-sm">Reset</a></div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr><th>Code</th><th>Name</th><th>Unit</th><th>Normal Range</th><th>Classification</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var d in Model.Items)
                    {
                        <tr>
                            <td>@d.Code</td>
                            <td class="fw-semibold">@d.Name</td>
                            <td>@d.Unit</td>
                            <td>@d.Range</td>
                            <td>@(d.Category?.Name)</td>
                            <td class="text-end text-nowrap">
                                <a asp-page="/lab/TestDataSetup" asp-route-edit="@d.Id" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil"></i></a>
                                <form method="post" asp-page-handler="Retire" asp-route-id="@d.Id" class="d-inline" onsubmit="return confirm('Retire this test data?');"><button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button></form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No test data found.</td></tr>
                }
            </tbody>
        </table>
        <partial name="_Pager" model="Model.Pager" />
    </div>
</div>