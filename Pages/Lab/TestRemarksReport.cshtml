@page "/lab/TestRemarksReport"
@model HmisWeb.Pages.Lab.TestRemarksReportModel
@{
    ViewData["Title"] = "Test Remarks Report";
}
<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-chat-quote me-2 text-primary"></i>Test Remarks Report</h4>
        <div class="text-secondary small">Canned remarks by test</div>
    </div>
</div>
<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-5"><label class="form-label small mb-1">Search</label><input name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" /></div>
            <div class="col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>View</button>
                <a asp-page="/lab/TestRemarksReport" asp-page-handler="Export" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-outline-success btn-sm"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
            </div>
        </div>
    </div>
</form>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Test</th><th>Remarks</th></tr></thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var r in Model.Items) { <tr><td>@(r.Item?.Name ?? "(any)")</td><td>@r.Remarks</td></tr> }
                }
                else { <tr><td colspan="2" class="text-center text-muted py-4">No remarks found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>