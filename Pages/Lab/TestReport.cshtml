@page "/lab/TestReport"
@model HmisWeb.Pages.Lab.TestReportModel
@{
    ViewData["Title"] = "Test Report";
}
<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-file-text me-2 text-primary"></i>Test Report</h4>
        <div class="text-secondary small">Test master list &middot; mirrors VFP Labsys <code>lb0210</code></div>
    </div>
</div>
<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-4"><label class="form-label small mb-1">Search</label><input name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small mb-1">Classification</label>
                <select name="CategoryId" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var c in Model.CategoryList)
                    {
                        if (Model.CategoryId?.ToString() == c.Value) { <option value="@c.Value" selected>@c.Text</option> }
                        else { <option value="@c.Value">@c.Text</option> }
                    }
                </select>
            </div>
            <div class="col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>View</button>
                <a asp-page="/lab/TestReport" asp-page-handler="Export" asp-route-CategoryId="@Model.CategoryId" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-outline-success btn-sm"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
            </div>
        </div>
    </div>
</form>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Code</th><th>Test</th><th>Classification</th><th class="text-end">Price</th><th class="text-end">Foreigner</th><th>Requirements</th></tr></thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var i in Model.Items)
                    {
                        <tr><td>@i.Code</td><td class="fw-semibold">@i.Name</td><td>@i.Category?.Name</td><td class="text-end">@i.Total?.ToString("N2")</td><td class="text-end">@i.TotalForForeigner?.ToString("N2")</td><td>@i.Requirements</td></tr>
                    }
                }
                else { <tr><td colspan="6" class="text-center text-muted py-4">No tests found.</td></tr> }
            </tbody>
            @if (Model.Items.Any())
            {
                <tfoot class="table-light"><tr class="fw-bold"><td colspan="3">Total</td><td class="text-end">@Model.TotalPrice.ToString("N2")</td><td colspan="2"></td></tr></tfoot>
            }
        </table>
    </div>
</div>

<partial name="_Pager" model="Model" />
