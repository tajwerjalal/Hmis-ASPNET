@page "/lab/indent"
@model HmisWeb.Pages.Lab.IndentModel
@using HmisWeb.Data.Enums
@{
    ViewData["Title"] = "Lab Service Indent (Invoice)";
}

<div class="mb-3">
    <h4 class="mb-0 fw-bold">Laboratory Service Indent (Invoice)</h4>
    <span class="text-secondary small">Create a lab invoice and settle via cash (OPD) or add to the patient's IPD account</span>
</div>

@if (!string.IsNullOrEmpty(Model.Success))
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof swal !== 'undefined') {
                swal.fire({ title: 'Indent Saved', text: '@Html.Raw(Model.Success)', icon: 'success', confirmButtonText: 'OK', customClass: { popup: 'hmis-swal' } });
            } else if (typeof Swal !== 'undefined') {
                Swal.fire({ title: 'Indent Saved', text: '@Html.Raw(Model.Success)', icon: 'success', confirmButtonText: 'OK', customClass: { popup: 'hmis-swal' } });
            }
        });
    </script>
    <div class="alert alert-success py-2 d-flex justify-content-between align-items-center">
        <span><i class="bi bi-check-circle me-1"></i>@Model.Success</span>
        @if (TempData["IndentPrintUrl"] != null)
        {
            <a href="@TempData["IndentPrintUrl"]" target="_blank" class="btn btn-sm btn-outline-light text-success border-success"><i class="bi bi-printer me-1"></i>Print slip for cashier</a>
        }
    </div>
}
@if (TempData["IndentPrintUrl"] != null && TempData["IndentIsIPD"]?.ToString() == "0")
{
    <script>
        (function () {
            var printUrl = '@TempData["IndentPrintUrl"]';
            var cashierUrl = '/Cashier/Receipt?Id=@TempData["IndentBillId"]&Tab=unpaid';
            window.open(printUrl, '_blank', 'width=900,height=1200');
            setTimeout(function () {
                window.location.href = cashierUrl;
            }, 800);
        })();
    </script>
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Message</div>
}

@if (Model.Invoice != null)
{
    <div class="card mb-3 border-primary">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span><i class="bi bi-file-earmark-text me-1"></i>Lab Service Invoice - Ready for Cashier</span>
            <div class="d-flex gap-2">
                <a href="/Lab/Invoice?billId=@Model.Invoice.BillId&format=thermal&print=1" class="btn btn-light btn-sm" target="_blank">
                    <i class="bi bi-printer me-1"></i>Print Invoice
                </a>
                <a asp-page="/Cashier/Receipt" class="btn btn-warning btn-sm">
                    <i class="bi bi-cash-stack me-1"></i>Go to Cashier
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Patient:</strong> @Model.Invoice.PatientName<br />
                    <strong>PHN:</strong> @(Model.Invoice.PatientPhn?.ToString() ?? "-")<br />
                    <strong>Visit/Ref:</strong> @Model.Invoice.VisitNumber
                </div>
                <div class="col-md-6 text-md-end">
                    <strong>Invoice:</strong> @Model.Invoice.InvoiceNumber<br />
                    <strong>Date:</strong> @Model.Invoice.InvoiceDate.ToString("dd MMM yyyy HH:mm")<br />
                    <strong>Dept:</strong> @Model.Invoice.DepartmentName
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Test / Service</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Disc</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Invoice.Lines)
                        {
                            <tr>
                                <td>@line.ItemName</td>
                                <td class="text-center">@line.Qty</td>
                                <td class="text-end">@line.Rate.ToString("N2")</td>
                                <td class="text-end">@(line.Discount > 0 ? line.Discount.ToString("N2") : "-")</td>
                                <td class="text-end fw-bold">@line.NetValue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <td colspan="4" class="text-end fw-bold">Sub Total</td>
                            <td class="text-end">@Model.Invoice.SubTotal.ToString("N2")</td>
                        </tr>
                        <tr class="table-light">
                            <td colspan="4" class="text-end fw-bold">Discount</td>
                            <td class="text-end">@Model.Invoice.Discount.ToString("N2")</td>
                        </tr>
                        <tr class="table-primary">
                            <td colspan="4" class="text-end fw-bold fs-5">NET TOTAL</td>
                            <td class="text-end fw-bold fs-5 text-primary">@Model.Invoice.NetTotal.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            @if (Model.Invoice.IsIPD)
            {
                <div class="alert alert-info mt-3 mb-0">
                    <i class="bi bi-hospital me-1"></i><strong>IPD Patient:</strong> Amount added to patient account. Will be settled at discharge.
                </div>
            }
            else
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i><strong>OPD Patient - UNPAID:</strong> Patient/attendant must present this invoice at <a asp-page="/Cashier/Receipt" class="text-decoration-underline fw-bold">Cashier</a> for payment. Cashier will verify and receive money.
                </div>
            }
        </div>
    </div>
}

<partial name="_LabIndentHistory" model="Model" />

@if (Model.SelectedPatient == null)
{
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-search me-1"></i>Find Patient</h6>
        <div class="d-flex gap-2">
            <a href="@Url.Page("/Opd/Registration", new { returnUrl = "/lab/Indent", newPatient = true })" class="btn btn-sm btn-outline-success"><i class="bi bi-person-plus me-1"></i>Add New Patient</a>
            <form method="post" asp-page-handler="StartNew">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Start a fresh indent / give an empty list"><i class="bi bi-file-earmark-plus me-1"></i>New Indent</button>
            </form>
        </div>
    </div>

    <form method="post" asp-page-handler="SearchPatients" class="card mb-3">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <input asp-for="PatientSearch" class="form-control" placeholder="Reg No, name, PHN / patient code, phone (1, 2 or 3)..." autofocus />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Search</button>
                </div>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger py-2"><i class="bi bi-exclamation-circle me-1"></i>@Model.ErrorMessage</div>
    }

    <div id="newPatientSection" style="display:none">
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-person-plus me-1 text-success"></i>Register a new (walk-in) patient</div>
            <div class="card-body">
                <form method="post" asp-page-handler="CreatePatient" class="row g-2">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4"><input asp-for="NewName" class="form-control form-control-sm" placeholder="Full name *" /></div>
                    <div class="col-md-4"><input asp-for="NewNameWithInitials" class="form-control form-control-sm" placeholder="Name with initials" /></div>
                    <div class="col-md-4"><input asp-for="NewNic" class="form-control form-control-sm" placeholder="NIC" /></div>
                    <div class="col-md-4"><input asp-for="NewMobile" class="form-control form-control-sm" placeholder="Mobile" /></div>
                    <div class="col-md-4"><input asp-for="NewPhone" class="form-control form-control-sm" placeholder="Phone" /></div>
                    <div class="col-md-4">
                        <select asp-for="NewSex" asp-items="Html.GetEnumSelectList<Sex>()" class="form-select form-select-sm">
                            <option value="">-- Sex --</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2 align-items-center">
                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-plus-lg me-1"></i>Add &amp; start indent</button>
                        <a href="javascript:void(0)" onclick="toggleNewPatient(false)" class="small text-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.SearchResults.Any())
    {
        <div class="card mb-3"><div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle"><thead class="table-light"><tr>
                <th>Reg No</th><th>Reg date</th><th>Type</th><th>Name</th><th>Age / Sex</th><th>Phone</th><th></th>
            </tr></thead><tbody>
            @foreach (var p in Model.SearchResults)
            {
                <tr>
                    <td class="fw-semibold">@(p.RegNo ?? "-")</td>
                    <td>@(p.RDate?.ToString("dd MMM yyyy") ?? "-") @p.RTime</td>
                    <td>@(p.TypeText ?? "-")</td>
                    <td>@(p.Name ?? "-")</td>
                    <td>@(p.Age ?? "-") / @(p.Sex ?? "-")</td>
                    <td>@(string.IsNullOrWhiteSpace(p.Phone) ? "-" : p.Phone)</td>
                    <td class="text-end">
                        <form method="post" asp-page-handler="SelectPatient">
                            <input type="hidden" name="SelectedPatientId" value="@p.PatientAppId" />
                            <input type="hidden" name="SelectedRegNo" value="@p.RegNo" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-primary">Select</button>
                        </form>
                    </td>
                </tr>
            }</tbody></table>
        </div></div>
    }

    @if (!Model.SearchResults.Any() && !string.IsNullOrEmpty(Model.PatientSearch))
    {
        <div class="alert alert-info py-2">
            <i class="bi bi-info-circle me-1"></i>No patient found for "<b>@Model.PatientSearch</b>".
            <a href="@Url.Page("/Opd/Registration", new { returnUrl = "/lab/Indent", newPatient = true })" class="fw-semibold text-decoration-underline">Add a new walk-in patient?</a>
        </div>
    }
}
else
{
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card mb-3">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-cash-stack me-1 text-success"></i>Patient unpaid bills</span>
                    @if (Model.HasUnpaidBills)
                    {
                        <span class="badge bg-warning text-dark">@Model.UnpaidBills.Count unpaid</span>
                    }
                </div>
                <div class="card-body py-3">
                    @if (Model.HasUnpaidBills)
                    {
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light"><tr><th>#</th><th>Date</th><th>Dept</th><th class="text-end">Amount</th><th>Type</th></tr></thead>
                                <tbody>
                                    @foreach (var b in Model.UnpaidBills)
                                    {
                                        <tr>
                                            <td>@(b.InvoiceNumber ?? ("#" + b.Id))</td>
                                            <td>@b.CreatedAt?.ToString("dd MMM yyyy")</td>
                                            <td>@(b.Department?.Name ?? "-")</td>
                                            <td class="text-end">@b.NetTotal.ToString("N2")</td>
                                            <td><span class="badge bg-secondary">@b.BillType</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="alert alert-warning py-2 mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>This patient has <strong>@Model.UnpaidBills.Count</strong> unpaid bill(s). You can create a new indent below or collect payment for existing ones.
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary small mb-0">No unpaid bills. You can create a new indent below.</div>
                    }
                    <hr />
                    <div class="row g-3 align-items-center">
                        <div class="col-md-5">
                            <div class="text-secondary small fw-bold text-uppercase">Patient</div>
                            <div class="fw-semibold fs-5">@HmisWeb.Services.PatientDisplayName.Of(Model.SelectedPatient)</div>
                            <small class="text-secondary">Reg No: @(string.IsNullOrWhiteSpace(Model.SelectedRegNo) ? "-" : Model.SelectedRegNo)@(!string.IsNullOrWhiteSpace(Model.SelectedPatient.Phn) ? $" · PHN: {Model.SelectedPatient.Phn}" : "")</small>
                        </div>
                        <div class="col-md-7 text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <form method="post" asp-page-handler="StartNew" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Clear patient and cart, start fresh">
                                        <i class="bi bi-plus-lg me-1"></i>New Indent
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="StartNew" class="d-inline">
                                    <input type="hidden" name="SelectedPatientId" value="@Model.SelectedPatient.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Switch patient</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <partial name="_LegacyPatientInfo" model="Model.LegacyPatient" />
                    @if (Model.ActiveEncounters.Any())
                    {
                        <hr class="my-2" />
                        <form method="post" asp-page-handler="StartNew" class="d-inline">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">Active IPD Encounter</label>
                                    <select name="SelectedEncounterId" class="form-select form-select-sm" asp-for="SelectedEncounterId">
                                        @foreach (var e in Model.ActiveEncounters)
                                        {
                                            <option value="@e.Id">@(e.BhtNo ?? ("BHT #" + e.Id)) — @(e.DateOfAdmission?.ToString("dd MMM") ?? "-")</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <span class="badge bg-soft-info text-dark border p-2">
                                        <i class="bi bi-hospital me-1"></i>IPD mode — charges added to the IPD account, settled at discharge.
                                    </span>
                                </div>
                            </div>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-soft-success text-dark border p-2 mt-2">
                            <i class="bi bi-cash me-1"></i>OPD mode — settle with cash / card now.
                        </span>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-search me-1 text-primary"></i>Add Lab Services</div>
                <div class="card-body text-center py-4">
                    <button type="button" class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#itemModal">
                        <i class="bi bi-plus-lg me-1"></i>Add Test / Service
                    </button>
                    <span class="text-secondary small ms-2">Opens a search popup to add investigations / services.</span>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-receipt me-1 text-primary"></i>Indent Cart (@Model.DisplayCart.Count)</span>
                    @if (Model.DisplayCart.Any())
                    {
                        <form method="post" asp-page-handler="Clear" class="mb-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-trash me-1"></i>Clear</button>
                        </form>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.DisplayCart.Any())
                    {
                        <form method="post" asp-page-handler="UpdateCart">
                            @Html.AntiForgeryToken()
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="table-light"><tr><th>Item</th><th class="text-center" style="width:90px;">Qty</th><th class="text-end" style="width:110px;">Rate</th><th class="text-end" style="width:110px;">Disc</th><th class="text-end">Line Total</th><th></th></tr></thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.DisplayCart.Count; i++)
                                        {
                                            var line = Model.DisplayCart[i];
                                            <tr>
                                                <td>
                                                    <input type="hidden" asp-for="Cart[i].ItemId" />
                                                    <input type="hidden" asp-for="Cart[i].Code" />
                                                    <input type="hidden" asp-for="Cart[i].ItemName" />
                                                    <div class="small fw-semibold">@line.ItemName</div>
                                                    <small class="text-secondary">@(line.Code ?? "#"+line.ItemId)</small>
                                                </td>
                                                <td><input asp-for="Cart[i].Qty" type="number" min="1" step="1" class="form-control form-control-sm text-center" /></td>
                                                <td><input asp-for="Cart[i].Rate" type="number" min="0" step="0.01" class="form-control form-control-sm text-end" /></td>
                                                <td><input asp-for="Cart[i].Discount" type="number" min="0" step="0.01" class="form-control form-control-sm text-end" /></td>
                                                <td class="text-end align-middle fw-semibold small">@line.NetValue.ToString("N2")</td>
                                                <td class="text-end">
                                                    <button type="submit" name="ItemToRemove" value="@line.ItemId" class="btn btn-sm btn-outline-danger" title="Remove"><i class="bi bi-x-lg"></i></button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot><tr class="table-light"><td colspan="4" class="fw-bold">Total</td><td class="text-end fw-bold fs-5">@Model.Total.ToString("N2")</td><td></td></tr></tfoot>
                                </table>
                            </div>
                            <div class="card-body border-top bg-light">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Update Cart</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-4"><i class="bi bi-receipt text-secondary" style="font-size:2rem;"></i><p class="text-secondary mt-2 mb-0">Cart is empty. Search and add investigations/services.</p></div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card mb-3">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-cash-stack me-1 text-primary"></i>Payment</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Save">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="SelectedEncounterId" value="@(Model.SelectedEncounter?.Id)" />

                        @if (Model.SelectedEncounter != null)
                        {
                            <div class="bg-info bg-opacity-10 border border-info rounded p-3">
                                <div class="fw-semibold"><i class="bi bi-hospital me-1"></i>IPD Mode</div>
                                <small class="text-secondary">Net charges <strong>@Model.NetTotal.ToString("N2")</strong> will be added to the patient's IPD account and settled at discharge.</small>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-1"></i>
                                <strong>OPD Mode:</strong> Bill will be created as <strong>unpaid</strong>. Patient must pay at <a asp-page="/Cashier/Receipt" class="text-decoration-underline">Cashier Receipt</a> page.
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Comments" class="form-label small fw-bold">Comments</label>
                                <textarea asp-for="Comments" class="form-control" rows="2" placeholder="Optional"></textarea>
                            </div>
                        </div>

                        <div class="bg-light border rounded p-3 mt-3">
                            <div class="row g-2">
                                <div class="col-6 text-secondary small fw-bold">Gross Total:</div>
                                <div class="col-6 text-end fw-semibold">@Model.Total.ToString("N2")</div>
                                <div class="col-6 text-secondary small fw-bold">Discount:</div>
                                <div class="col-6 text-end fw-semibold">@Model.DiscountTotal.ToString("N2")</div>
                                <div class="col-6 text-secondary small fw-bold border-top pt-1">Net Total:</div>
                                <div class="col-6 text-end fw-bold fs-5 border-top pt-1 text-primary">@Model.NetTotal.ToString("N2")</div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 px-4 mt-3"
                                disabled="@(!Model.DisplayCart.Any())" title="Save the indent as an UNPAID OPD bill (payment slip to cashier)">
                            <i class="fa-solid fa-floppy-disk"></i> Save
                        </button>
                        <button type="button" class="btn btn-outline-secondary w-100 px-4 mt-3"
                                disabled="@(!Model.HasSavedIndent)" title="@(Model.HasSavedIndent ? "Open the cashier payment slip for the saved indent (UNPAID)." : "Save the indent first to print the payment slip.")"
                                onclick="window.open('/Lab/Invoice?billId=@(Model.LastBillId ?? 0)&format=thermal&print=1', '_blank');">
                            <i class="fa-solid fa-print me-1"></i> Print
                        </button>
                        @if (!Model.DisplayCart.Any())
                        {
                            <div class="form-text text-center mt-2">Add at least one investigation / service.</div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- ADD TEST / SERVICE MODAL -->
<div class="modal fade" id="itemModal" tabindex="-1" aria-labelledby="itemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-white">
                <h5 class="modal-title fw-semibold" id="itemModalLabel">Add Lab Test / Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @* Search form *@
                <form method="get" asp-page-handler="SearchItems" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="DepartmentId" value="@Model.LabDepartment?.Id" />
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-secondary"></i></span>
                        <input asp-for="ItemSearch" class="form-control" placeholder="Search investigations or services..." />
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                    </div>
                </form>

                @if (Model.DeptServiceResults.Any())
                {
                    <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Test / Service</th>
                                    <th class="text-end" style="width:130px;">Rate</th>
                                    <th style="width:120px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var svc in Model.DeptServiceResults)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-info text-white me-1" style="font-size:.65rem;">LAB</span>
                                            <span class="fw-semibold small">@svc.Name</span>
                                            <small class="text-secondary ms-1 d-block">Code: @svc.Code</small>
                                        </td>
                                        <td class="text-end small">@((svc.Rate ?? 0).ToString("N2"))</td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="AddItem" class="d-inline">
                                                <input type="hidden" name="ItemSearch" value="@Model.ItemSearch" />
                                                <input type="hidden" name="SelectedItemId" value="@svc.Id" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-plus-lg"></i> Add</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (Model.OpenItemModal && !Model.DeptServiceResults.Any() && !string.IsNullOrEmpty(Model.ItemSearch))
                {
                    <div class="text-center text-secondary py-3">No matching lab tests / services found.</div>
                }
                @if (!Model.OpenItemModal && !Model.DeptServiceResults.Any())
                {
                    <div class="text-center text-secondary py-3">Click <strong>Add Test / Service</strong> to browse laboratory tests.</div>
                }
            </div>
            <div class="modal-footer border-0 bg-white">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleNewPatient(open) {
            var el = document.getElementById('newPatientSection');
            if (el) { el.style.display = open ? '' : 'none'; }
        }

        @if (Model.OpenItemModal)
        {
            <text>
                var itemModal = new bootstrap.Modal(document.getElementById('itemModal'));
                itemModal.show();
            </text>
        }
    </script>
}