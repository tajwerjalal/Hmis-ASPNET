@page "/lab/MedicineSetup"
@model HmisWeb.Pages.Lab.MedicineSetupModel
@{
    ViewData["Title"] = "Medicine Setup";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-capsule me-2 text-primary"></i>Medicine Setup</h4>
        <div class="text-secondary small">Medicine master &middot; mirrors VFP Labsys <code>lb0330</code></div>
    </div>
    <a asp-page="/lab/MedicineSetup" asp-route-add="1" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Medicine</a>
</div>

@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert alert-success alert-dismissible fade show py-2"><i class="bi bi-check-circle me-1"></i>@Model.Success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show py-2"><i class="bi bi-exclamation-triangle me-1"></i>@Model.ErrorMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (Model.Input.ShowForm)
{
    <div class="card mb-3 border-primary">
        <div class="card-header bg-primary-subtle fw-semibold">@(Model.Input.Id > 0 ? "Edit Medicine" : "New Medicine")</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Save">
                <input type="hidden" asp-for="Input.Id" />
                <div class="row g-3">
                    <div class="col-md-2"><label class="form-label small mb-1">Code</label><input asp-for="Input.Code" class="form-control form-control-sm" /></div>
                    <div class="col-md-4"><label class="form-label small mb-1">Name <span class="text-danger">*</span></label><input asp-for="Input.Name" class="form-control form-control-sm" required /></div>
                    <div class="col-md-3"><label class="form-label small mb-1">Print Name</label><input asp-for="Input.PrintName" class="form-control form-control-sm" /></div>
                    <div class="col-md-3"><label class="form-label small mb-1">Generic</label><input asp-for="Input.Sname" class="form-control form-control-sm" /></div>
                    <div class="col-md-4"><label class="form-label small mb-1">Classification</label><select asp-for="Input.CategoryId" asp-items="Model.CategoryList" class="form-select form-select-sm"><option value="">-- None --</option></select></div>
                    <div class="col-md-2"><label class="form-label small mb-1">Price</label><input asp-for="Input.Total" class="form-control form-control-sm" type="number" step="0.01" /></div>
                    <div class="col-md-2"><label class="form-label small mb-1">Foreigner Price</label><input asp-for="Input.TotalForForeigner" class="form-control form-control-sm" type="number" step="0.01" /></div>
                    <div class="col-md-2"><label class="form-label small mb-1">Unit Rate</label><input asp-for="Input.UnitRate" class="form-control form-control-sm" type="number" step="0.01" /></div>
                    <div class="col-md-2"><label class="form-label small mb-1">Unit</label><select asp-for="Input.MeasurementUnitId" asp-items="Model.UnitList" class="form-select form-select-sm"><option value="">-- None --</option></select></div>
                    <div class="col-12 d-flex gap-4">
                        <div class="form-check"><input asp-for="Input.Billable" class="form-check-input" /><label asp-for="Input.Billable" class="form-check-label small">Billable</label></div>
                        <div class="form-check"><input asp-for="Input.Inactive" class="form-check-input" /><label asp-for="Input.Inactive" class="form-check-label small">Inactive</label></div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2 me-1"></i>Save</button>
                    <a asp-page="/lab/MedicineSetup" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-outline-secondary btn-sm">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-5"><label class="form-label small mb-1">Search</label><input name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="code / name" /></div>
            <div class="col-md-3 d-flex gap-2"><button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filter</button><a asp-page="/lab/MedicineSetup" class="btn btn-outline-secondary btn-sm">Reset</a></div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr><th>Code</th><th>Name</th><th>Generic</th><th>Classification</th><th class="text-end">Price</th><th class="text-end">Unit Rate</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var m in Model.Items)
                    {
                        <tr>
                            <td>@m.Code</td>
                            <td class="fw-semibold">@m.Name</td>
                            <td>@m.Sname</td>
                            <td>@(m.Category?.Name)</td>
                            <td class="text-end">@m.Total?.ToString("N2")</td>
                            <td class="text-end">@m.UnitRate?.ToString("N2")</td>
                            <td>@if (m.Retired) { <span class="badge bg-secondary">Retired</span> } else if (m.Inactive) { <span class="badge bg-warning text-dark">Inactive</span> } else { <span class="badge bg-success">Active</span> }</td>
                            <td class="text-end text-nowrap">
                                <a asp-page="/lab/MedicineSetup" asp-route-edit="@m.Id" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil"></i></a>
                                @if (m.Retired)
                                {
                                    <form method="post" asp-page-handler="Activate" asp-route-id="@m.Id" class="d-inline"><button class="btn btn-outline-success btn-sm"><i class="bi bi-arrow-counterclockwise"></i></button></form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Retire" asp-route-id="@m.Id" class="d-inline" onsubmit="return confirm('Retire this medicine?');"><button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button></form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No medicines found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>