@page "/lab/OrganismsList"
@model HmisWeb.Pages.Lab.OrganismsListModel
@{
    ViewData["Title"] = "Organisms List";
}
<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-bug me-2 text-primary"></i>Organisms List</h4>
        <div class="text-secondary small">Micro-organisms for culture reporting</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/lab/OrganismsList" asp-page-handler="Export" class="btn btn-outline-success btn-sm"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Code</th><th>Name</th></tr></thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var o in Model.Items) { <tr><td>@o.Code</td><td>@o.Name</td></tr> }
                }
                else { <tr><td colspan="2" class="text-center text-muted py-4">No organisms found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>