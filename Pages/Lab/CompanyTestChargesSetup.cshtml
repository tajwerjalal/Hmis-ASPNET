@page "/lab/CompanyTestChargesSetup"
@model HmisWeb.Pages.Lab.CompanyTestChargesSetupModel
@{
    ViewData["Title"] = "Company Test Charges Setup";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-building me-2 text-primary"></i>Company Test Charges Setup</h4>
        <div class="text-secondary small">Panel/company rates for laboratory tests &middot; mirrors VFP Labsys <code>lb0340</code></div>
    </div>
    <a asp-page="/lab/CompanyTestChargesSetup" asp-route-add="1" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Charge</a>
</div>

@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert alert-success alert-dismissible fade show py-2"><i class="bi bi-check-circle me-1"></i>@Model.Success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show py-2"><i class="bi bi-exclamation-triangle me-1"></i>@Model.ErrorMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (Model.Input.ShowForm)
{
    <div class="card mb-3 border-primary">
        <div class="card-header bg-primary-subtle fw-semibold">@(Model.Input.Id > 0 ? "Edit Charge" : "New Charge")</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Save">
                <input type="hidden" asp-for="Input.Id" />
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label small mb-1">Company <span class="text-danger">*</span></label><select asp-for="Input.CompanyId" asp-items="Model.CompanyList" class="form-select form-select-sm"><option value="">-- select --</option></select></div>
                    <div class="col-md-4"><label class="form-label small mb-1">Test <span class="text-danger">*</span></label><select asp-for="Input.ItemId" asp-items="Model.TestList" class="form-select form-select-sm"><option value="">-- select --</option></select></div>
                    <div class="col-md-2"><label class="form-label small mb-1">Rate</label><input asp-for="Input.Rate" class="form-control form-control-sm" type="number" step="0.01" /></div>
                    <div class="col-md-2"><label class="form-label small mb-1">Discount %</label><input asp-for="Input.DiscountPercent" class="form-control form-control-sm" type="number" step="0.01" /></div>
                    <div class="col-md-2"><label class="form-label small mb-1">Staff Rate</label><input asp-for="Input.StaffRate" class="form-control form-control-sm" type="number" step="0.01" /></div>
                    <div class="col-md-2"><label class="form-label small mb-1">Unit Rate</label><input asp-for="Input.UnitRate" class="form-control form-control-sm" type="number" step="0.01" /></div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2 me-1"></i>Save</button>
                    <a asp-page="/lab/CompanyTestChargesSetup" asp-route-CompanyId="@Model.CompanyId" class="btn btn-outline-secondary btn-sm">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-5"><label class="form-label small mb-1">Company</label>
                <select name="CompanyId" class="form-select form-select-sm">
                    <option value="">All companies</option>
                    @foreach (var c in Model.CompanyList)
                    {
                        if (Model.CompanyId?.ToString() == c.Value) { <option value="@c.Value" selected>@c.Text</option> }
                        else { <option value="@c.Value">@c.Text</option> }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2"><button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filter</button><a asp-page="/lab/CompanyTestChargesSetup" class="btn btn-outline-secondary btn-sm">Reset</a></div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr><th>Company</th><th>Test</th><th class="text-end">Rate</th><th class="text-end">Discount %</th><th class="text-end">Staff Rate</th><th class="text-end">Unit Rate</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td>@(r.Company?.Name)</td>
                            <td>@(((r.Item?.Code ?? "") + " " + r.Item?.Name).Trim())</td>
                            <td class="text-end fw-semibold">@r.Rate.ToString("N2")</td>
                            <td class="text-end">@r.DiscountPercent?.ToString("N2")</td>
                            <td class="text-end">@r.StaffRate?.ToString("N2")</td>
                            <td class="text-end">@r.UnitRate?.ToString("N2")</td>
                            <td class="text-end text-nowrap">
                                <a asp-page="/lab/CompanyTestChargesSetup" asp-route-edit="@r.Id" asp-route-CompanyId="@Model.CompanyId" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil"></i></a>
                                <form method="post" asp-page-handler="Retire" asp-route-id="@r.Id" class="d-inline" onsubmit="return confirm('Retire this charge?');"><button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button></form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No company test charges found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" model="Model" />
