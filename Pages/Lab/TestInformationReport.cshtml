@page "/lab/TestInformationReport"
@model HmisWeb.Pages.Lab.TestInformationReportModel
@{
    ViewData["Title"] = "Test Information Report";
}
<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Test Information Report</h4>
        <div class="text-secondary small">Descriptive information for tests &middot; mirrors VFP Labsys <code>lb0230</code></div>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/lab/TestInformationReport" asp-page-handler="Export" class="btn btn-outline-success btn-sm"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
    </div>
</div>

@if (Model.Selected != null)
{
    <div class="card mb-3 border-primary">
        <div class="card-header bg-primary-subtle fw-semibold">@Model.Selected.Code - @Model.Selected.Name</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Classification</dt><dd class="col-sm-9">@Model.Selected.Category?.Name</dd>
                <dt class="col-sm-3">Method / Description</dt><dd class="col-sm-9">@Model.Selected.Descreption</dd>
                <dt class="col-sm-3">Requirements</dt><dd class="col-sm-9">@Model.Selected.Requirements</dd>
                <dt class="col-sm-3">Duration</dt><dd class="col-sm-9">@Model.Selected.MinDuration &ndash; @Model.Selected.MaxDuration</dd>
                <dt class="col-sm-3">Price</dt><dd class="col-sm-9">@Model.Selected.Total?.ToString("N2") (foreigner @Model.Selected.TotalForForeigner?.ToString("N2"))</dd>
            </dl>
            @if (Model.Parameters.Any())
            {
                <hr />
                <div class="fw-semibold small mb-1">Parameters</div>
                <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Name</th><th>Unit</th><th>Range</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Parameters) { <tr><td>@p.Name</td><td>@p.Unit</td><td>@p.Range</td></tr> }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Code</th><th>Test</th><th>Classification</th><th>Requirements</th><th>Duration</th><th class="text-end"></th></tr></thead>
            <tbody>
                @if (Model.Tests.Any())
                {
                    @foreach (var i in Model.Tests)
                    {
                        <tr>
                            <td>@i.Code</td><td class="fw-semibold">@i.Name</td><td>@i.Category?.Name</td><td>@i.Requirements</td>
                            <td>@i.MinDuration &ndash; @i.MaxDuration</td>
                            <td class="text-end"><a asp-page="/lab/TestInformationReport" asp-route-TestId="@i.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-eye"></i> Info</a></td>
                        </tr>
                    }
                }
                else { <tr><td colspan="6" class="text-center text-muted py-4">No tests found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>