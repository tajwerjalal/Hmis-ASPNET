@page "/lab/TestResultPrint"
@model HmisWeb.Pages.Lab.TestResultPrintModel
@using System
@using System.Collections.Generic
@using System.Linq
@using HmisWeb.Models.Lab
@*
    ============================================================================
    File........: Pages/Lab/TestResultPrint.cshtml
    Purpose.....: Standalone printable laboratory test report for one TESTTR
                  line. Shows the patient header, entered READTR results, the
                  culture block and the test remarks.
    Inputs......: TestResultPrintModel (LabEntryView, ErrorMessage, AutoPrint).
    Outputs.....: A4 print layout with a Print button. Layout is disabled so the
                  report is not wrapped in the application sidebar.
    Business
      rules.....: 1. Only result rows with a value are printed.
                  2. Culture is printed only when growth/species/medicine data
                     exists.
                  3. The report date is TESTTR.REPODT, falling back to the
                     collection date.
                  4. print=1 opens the browser print dialog automatically.
    Developer...: Tajwer Jalal
    Date/Time...: 2026-11-03 12:16
    ============================================================================
*@
@{
    Layout = null;
    var header = Model.Entry?.Header;
    var test = Model.Entry?.SelectedTest;
    var readings = (Model.Entry?.Readings ?? new List<LabReadingRow>())
        .Where(r => !string.IsNullOrWhiteSpace(r.Value))
        .ToList();
    var culture = Model.Entry?.Culture;
    var cultureMedicines = (culture?.Medicines ?? new List<LabCultureMedicine>())
        .Where(m => !string.IsNullOrWhiteSpace(m.S1)
                    || !string.IsNullOrWhiteSpace(m.S2)
                    || !string.IsNullOrWhiteSpace(m.S3))
        .ToList();
    var hasCulture = culture != null &&
        (!string.IsNullOrWhiteSpace(culture.Species1)
         || !string.IsNullOrWhiteSpace(culture.Species2)
         || !string.IsNullOrWhiteSpace(culture.Species3)
         || !string.IsNullOrWhiteSpace(culture.Growth1)
         || !string.IsNullOrWhiteSpace(culture.Growth2)
         || !string.IsNullOrWhiteSpace(culture.Growth3)
         || cultureMedicines.Count > 0);
    var reportDate = test?.RepoDt ?? header?.Date ?? DateTime.Today;
    var ageText = string.Join(" ", new[] { header?.Age, header?.ATypeDisplay }
        .Where(x => !string.IsNullOrWhiteSpace(x)));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lab Report @(header?.LabNoDisplay ?? "")</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            background: #eef1f4;
            color: #000;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10pt;
        }
        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 10mm auto;
            padding: 12mm 14mm;
            background: #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, .18);
        }
        .no-print {
            text-align: center;
            padding: 12px 0 0;
        }
        .no-print button {
            padding: 7px 18px;
            margin: 0 4px;
            border: 1px solid #0d6efd;
            border-radius: 4px;
            background: #0d6efd;
            color: #fff;
            cursor: pointer;
            font-size: 10pt;
        }
        .no-print button.secondary {
            background: #fff;
            color: #0d6efd;
        }
        .hospital {
            text-align: center;
            font-size: 16pt;
            font-weight: bold;
            letter-spacing: .4px;
        }
        .title {
            text-align: center;
            font-size: 13pt;
            font-weight: bold;
            margin-top: 2px;
        }
        .subtitle {
            text-align: center;
            font-size: 9pt;
            margin-top: 2px;
            color: #333;
        }
        .rule {
            border-top: 2px solid #000;
            margin: 7px 0 10px;
        }
        table { width: 100%; border-collapse: collapse; }
        .meta td {
            padding: 2px 5px;
            vertical-align: top;
            font-size: 9.5pt;
        }
        .meta .label { font-weight: bold; width: 19%; }
        .meta .value { width: 31%; }
        .test-title {
            margin: 12px 0 6px;
            padding: 4px 6px;
            border: 1px solid #000;
            background: #f0f0f0;
            font-size: 11pt;
            font-weight: bold;
        }
        .results th, .results td {
            border: 1px solid #000;
            padding: 4px 6px;
            font-size: 9.5pt;
        }
        .results th { background: #e9e9e9; text-align: left; }
        .results td.result { font-weight: bold; }
        .results td.num { width: 22%; }
        .results td.unit { width: 15%; }
        .results td.range { width: 28%; }
        .section-title {
            margin: 12px 0 4px;
            font-weight: bold;
            text-decoration: underline;
        }
        .culture-table th, .culture-table td {
            border: 1px solid #000;
            padding: 4px 6px;
            font-size: 9.5pt;
            text-align: left;
        }
        .culture-table th { background: #e9e9e9; }
        .remarks {
            margin-top: 10px;
            white-space: pre-wrap;
            font-size: 9.5pt;
        }
        .footer {
            display: flex;
            justify-content: space-between;
            gap: 30px;
            margin-top: 28px;
        }
        .sign {
            flex: 1;
            border-top: 1px solid #000;
            padding-top: 4px;
            text-align: center;
            font-size: 9pt;
        }
        .printed {
            margin-top: 14px;
            text-align: right;
            font-size: 8pt;
            color: #444;
        }
        .error {
            max-width: 120mm;
            margin: 30mm auto;
            padding: 14px;
            border: 1px solid #dc3545;
            background: #fff5f5;
            color: #842029;
            font-size: 11pt;
        }
        @@media print {
            body { background: #fff; }
            .page {
                width: auto;
                min-height: auto;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }
            .no-print { display: none !important; }
            @@page { size: A4; margin: 12mm; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        @if (string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <button type="button" onclick="window.print()">Print Report</button>
        }
        <button type="button" class="secondary" onclick="window.close()">Close</button>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">
            <strong>Report not available.</strong>
            <div>@Model.ErrorMessage</div>
        </div>
    }
    else if (header != null && test != null)
    {
        <div class="page">
            <div class="hospital">HMIS - HOSPITAL</div>
            <div class="title">LABORATORY TEST REPORT</div>
            <div class="subtitle">Clinical Laboratory Services</div>
            <div class="rule"></div>

            <table class="meta">
                <tr>
                    <td class="label">Patient Name</td>
                    <td class="value">@header.Name</td>
                    <td class="label">Lab Indent No</td>
                    <td class="value">@header.LabNoDisplay</td>
                </tr>
                <tr>
                    <td class="label">Patient Id</td>
                    <td class="value">@header.PCodeDisplay</td>
                    <td class="label">Registration No</td>
                    <td class="value">@header.Hrno</td>
                </tr>
                <tr>
                    <td class="label">Age / Sex</td>
                    <td class="value">@ageText / @header.Sex</td>
                    <td class="label">Collection</td>
                    <td class="value">@(header.Date?.ToString("dd MMM yyyy") ?? "") @header.Time</td>
                </tr>
                <tr>
                    <td class="label">Report Date</td>
                    <td class="value">@reportDate.ToString("dd MMM yyyy")</td>
                    <td class="label">Consultant</td>
                    <td class="value">@header.Concode</td>
                </tr>
                <tr>
                    <td class="label">Test</td>
                    <td class="value">@test.Name</td>
                    <td class="label">Test ID / Group</td>
                    <td class="value">@test.Tid / @test.GroupName</td>
                </tr>
            </table>

            <div class="test-title">@test.Name</div>

            <table class="results">
                <thead>
                    <tr>
                        <th style="width:12%">Reading</th>
                        <th>Description</th>
                        <th class="num">Result</th>
                        <th class="unit">Unit</th>
                        <th class="range">Normal Range</th>
                    </tr>
                </thead>
                <tbody>
                    @if (readings.Count == 0)
                    {
                        <tr>
                            <td colspan="5" style="text-align:center; color:#666; padding:10px;">
                                No result lines entered.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in readings)
                        {
                            <tr>
                                <td>@row.Code</td>
                                <td>@row.Name</td>
                                <td class="result">@row.Value</td>
                                <td>@row.UnitDisplay</td>
                                <td>@row.Range</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            @if (hasCulture)
            {
                <div class="section-title">Culture &amp; Sensitivity</div>
                <table class="culture-table">
                    <tr>
                        <th style="width:16%">Species A</th>
                        <td style="width:34%">@culture.Species1</td>
                        <th style="width:16%">Growth 1</th>
                        <td>@culture.Growth1</td>
                    </tr>
                    <tr>
                        <th>Species B</th>
                        <td>@culture.Species2</td>
                        <th>Growth 2</th>
                        <td>@culture.Growth2</td>
                    </tr>
                    <tr>
                        <th>Species C</th>
                        <td>@culture.Species3</td>
                        <th>Growth 3</th>
                        <td>@culture.Growth3</td>
                    </tr>
                </table>

                @if (cultureMedicines.Count > 0)
                {
                    <table class="culture-table" style="margin-top:6px;">
                        <thead>
                            <tr>
                                <th style="width:16%">Code</th>
                                <th>Medicine</th>
                                <th style="width:12%">A</th>
                                <th style="width:12%">B</th>
                                <th style="width:12%">C</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var medicine in cultureMedicines)
                            {
                                <tr>
                                    <td>@medicine.Code</td>
                                    <td>@medicine.Name</td>
                                    <td>@medicine.S1</td>
                                    <td>@medicine.S2</td>
                                    <td>@medicine.S3</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }

            @if (!string.IsNullOrWhiteSpace(test.Remarks))
            {
                <div class="section-title">Remarks</div>
                <div class="remarks">@test.Remarks</div>
            }

            <div class="footer">
                <div class="sign">Reported by</div>
                <div class="sign">Verified by</div>
            </div>
            <div class="printed">Printed: @Model.PrintedAt.ToString("dd MMM yyyy HH:mm")</div>
        </div>
    }

    @if (Model.AutoPrint && string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <script>
            // Give the browser one paint cycle to lay out the A4 page.
            window.addEventListener('load', function () {
                setTimeout(function () { window.print(); }, 300);
            });
        </script>
    }
</body>
</html>
