@page "/lab/ResourceTestChargesReport"
@model HmisWeb.Pages.Lab.ResourceTestChargesReportModel
@{
    ViewData["Title"] = "Resource wise Test Charges Report";
}
<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-files me-2 text-primary"></i>Resource wise Test Charges Report</h4>
        <div class="text-secondary small">Staff/resource rates for tests &middot; mirrors VFP Labsys <code>lb0260</code></div>
    </div>
</div>
<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-5"><label class="form-label small mb-1">Resource</label>
                <select name="ResourceId" class="form-select form-select-sm">
                    <option value="">All resources</option>
                    @foreach (var r in Model.ResourceList)
                    {
                        if (Model.ResourceId?.ToString() == r.Value) { <option value="@r.Value" selected>@r.Text</option> }
                        else { <option value="@r.Value">@r.Text</option> }
                    }
                </select>
            </div>
            <div class="col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>View</button>
                <a asp-page="/lab/ResourceTestChargesReport" asp-page-handler="Export" asp-route-ResourceId="@Model.ResourceId" class="btn btn-outline-success btn-sm"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
            </div>
        </div>
    </div>
</form>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Resource</th><th>Test</th><th class="text-end">Staff Rate</th><th class="text-end">Unit Rate</th></tr></thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var r in Model.Items)
                    {
                        <tr><td>@r.Resource?.Name</td><td class="fw-semibold">@(((r.Item?.Code ?? "") + " " + r.Item?.Name).Trim())</td><td class="text-end">@r.StaffRate.ToString("N2")</td><td class="text-end">@r.UnitRate.ToString("N2")</td></tr>
                    }
                }
                else { <tr><td colspan="4" class="text-center text-muted py-4">No charges found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>