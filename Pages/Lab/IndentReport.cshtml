@page "/lab/IndentReport"
@model HmisWeb.Pages.Lab.IndentReportModel
@{
    ViewData["Title"] = "Indent No. wise Report";
}
<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Indent No. wise Report</h4>
        <div class="text-secondary small">Laboratory indents (investigation orders) &middot; mirrors VFP Labsys <code>frmindwise</code></div>
    </div>
</div>
<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label small mb-1">From</label><input name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" type="date" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small mb-1">To</label><input name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" type="date" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small mb-1">Search</label><input name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="patient / test" /></div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>View</button>
                <a asp-page="/lab/IndentReport" asp-page-handler="Export" asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-outline-success btn-sm"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
            </div>
        </div>
    </div>
</form>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Indent</th><th>Date</th><th>Patient</th><th>Test</th><th>Ordered</th><th>Sample</th><th>Completed</th><th>Due</th></tr></thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var o in Model.Items)
                    {
                        <tr>
                            <td>@o.Id</td>
                            <td>@o.CreatedAt?.ToString("yyyy-MM-dd")</td>
                            <td>@o.Patient?.Person?.Name</td>
                            <td>@(o.Item?.Name ?? o.InvestigationName)</td>
                            <td>@if (o.Ordered) { <span class="badge bg-success">Yes</span> } else { <span class="badge bg-secondary">No</span> }</td>
                            <td>@if (o.SampleCollected) { <span class="badge bg-info text-dark">Yes</span> } else { <span class="badge bg-secondary">No</span> }</td>
                            <td>@if (o.Completed) { <span class="badge bg-success">Yes</span> } else { <span class="badge bg-secondary">No</span> }</td>
                            <td>@o.DueDate?.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                }
                else { <tr><td colspan="8" class="text-center text-muted py-4">No indents found for the selected period.</td></tr> }
            </tbody>
        </table>
    </div>
</div>