@page "/lab/TestReportII"
@model HmisWeb.Pages.Lab.TestReportIIModel
@{
    ViewData["Title"] = "Test Report II";
}
<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Test Report II</h4>
        <div class="text-secondary small">Tests summarised by classification &middot; mirrors VFP Labsys <code>lb0220</code></div>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/lab/TestReportII" asp-page-handler="Export" class="btn btn-outline-success btn-sm"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Classification</th><th class="text-end">Tests</th><th class="text-end">Total Price</th></tr></thead>
            <tbody>
                @if (Model.Rows.Any())
                {
                    @foreach (var r in Model.Rows)
                    {
                        <tr><td class="fw-semibold">@r.Classification</td><td class="text-end">@r.Count</td><td class="text-end">@r.TotalPrice.ToString("N2")</td></tr>
                    }
                }
                else { <tr><td colspan="3" class="text-center text-muted py-4">No tests found.</td></tr> }
            </tbody>
            @if (Model.Rows.Any())
            {
                <tfoot class="table-light"><tr class="fw-bold"><td>Total</td><td class="text-end">@Model.TotalCount</td><td class="text-end">@Model.TotalPrice.ToString("N2")</td></tr></tfoot>
            }
        </table>
    </div>
</div>