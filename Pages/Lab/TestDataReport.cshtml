@page "/lab/TestDataReport"
@model HmisWeb.Pages.Lab.TestDataReportModel
@*
    ============================================================================
    File........: Pages/Lab/TestDataReport.cshtml
    Purpose.....: Test Data Report - test parameters with units & normal ranges.
    Inputs......: TestDataReportModel (TESTDATA/CATEGORY + legacy READINGS).
    Outputs.....: HTML table and CSV export.
    Developer...: Tajwer Jalal
    Date/Time...: 2026-11-03 13:57
    ============================================================================
*@
@{
    ViewData["Title"] = "Test Data Report";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-table me-2 text-primary"></i>Test Data Report</h4>
        <div class="text-secondary small">Test parameters with units &amp; normal ranges</div>
    </div>
</div>

<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-4"><label class="form-label small mb-1">Search</label><input name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small mb-1">Classification</label>
                <select name="CategoryId" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var c in Model.CategoryList)
                    {
                        if (Model.CategoryId?.ToString() == c.Value) { <option value="@c.Value" selected>@c.Text</option> }
                        else { <option value="@c.Value">@c.Text</option> }
                    }
                </select>
            </div>
            <div class="col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>View</button>
                <a asp-page="/lab/TestDataReport" asp-page-handler="Export" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" class="btn btn-outline-success btn-sm"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Code</th><th>Name</th><th>Unit</th><th>Normal Range</th><th>Classification</th></tr></thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var d in Model.Items)
                    {
                        <tr><td>@d.Code</td><td class="fw-semibold">@d.Name</td><td>@d.Unit</td><td>@d.Range</td><td>@d.Category?.Name</td></tr>
                    }
                }
                else { <tr><td colspan="5" class="text-center text-muted py-4">No test data found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>