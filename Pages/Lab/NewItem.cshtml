@page
@model HmisWeb.Pages.Lab.NewItemModel
@{
    ViewData["Title"] = "New Investigation";
}

<h4>New Investigation</h4>
<div class="text-secondary small mb-2">Writes to the shared services master [SERVICES] &middot; DEPT 01</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger py-2">
        <div asp-validation-summary="All"></div>
    </div>
}

<div class="card mt-3">
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Name *</label>
                <input asp-for="Input.Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Code</label>
                <input asp-for="Input.Code" class="form-control" maxlength="5" />
            </div>
            <div class="mb-3">
                <label class="form-label">Price</label>
                <input asp-for="Input.Price" class="form-control" type="number" step="0.01" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="/Lab/Investigation" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
