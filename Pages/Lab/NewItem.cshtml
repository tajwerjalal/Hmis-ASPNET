@page
@model HmisWeb.Pages.Lab.NewItemModel
@{
    ViewData["Title"] = "New Investigation";
}

<h4>New Investigation</h4>

<div class="card mt-3">
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Name *</label>
                <input asp-for="Input.Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Code</label>
                <input asp-for="Input.Code" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Price</label>
                <input asp-for="Input.Price" class="form-control" type="number" step="0.01" />
            </div>
            <div class="mb-3">
                <label class="form-label">Category</label>
                <select asp-for="Input.CategoryId" asp-items="Model.CategoryList" class="form-select">
                    <option value="">-- None --</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="/Lab/Investigation" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
