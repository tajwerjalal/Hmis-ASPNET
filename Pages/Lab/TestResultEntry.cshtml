@page "/lab/TestResultEntry"
@model HmisWeb.Pages.Lab.TestResultEntryModel
@*
    ============================================================================
    File........: Pages/Lab/TestResultEntry.cshtml
    Purpose.....: LB0110 "Test Result Entry" screen. Two top level tabs:
                  "List" (read-only REPORT browse) and "Entry" (result/culture
                  data entry for the selected indent).
    Inputs......: TestResultEntryModel (List, Entry, Readings, Culture, filters).
    Outputs.....: Bootstrap tabs hosting the partial views; the antiforgery token
                  and the pick-list modal used by lab-testresult.js.
    Business
      rules.....: 1. The List tab is always available; the Entry tab is enabled
                     only when an indent is loaded.
                  2. A scanned 9 digit Lab No opens the Entry tab directly
                     (handled in OnGetAsync).
                  3. All data entry is done through the partial views so the
                     page can refresh the grid without a full reload.
    Developer...: Tajwer Jalal
    Date/Time...: 2026-11-02 11:22
    ============================================================================
*@
@{
    ViewData["Title"] = "Test Result Entry";
    var entryActive = Model.ActiveTab == "entry" && Model.Entry != null;
}

<div class="d-flex justify-content-between align-items-start mb-3 gap-2 flex-wrap">
    <div>
        <h4 class="mb-0 fw-bold">Test Result Entry</h4>
        <span class="text-secondary small">
            Legacy lb0110 &mdash; enter investigation results and culture by Lab Indent No
        </span>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnFindIndent">
            <i class="bi bi-search me-1"></i>Find
        </button>
        <a href="/lab/TestResultEntry" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </a>
    </div>
</div>

<div id="lbAlert"></div>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-circle me-1"></i>@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@Model.Success</div>
}

<ul class="nav nav-tabs" id="lbMainTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(entryActive ? "" : "active")" id="listTabBtn"
                data-bs-toggle="tab" data-bs-target="#listTab" type="button" role="tab">
            <i class="bi bi-list-ul me-1"></i>List
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(entryActive ? "active" : "") @(Model.Entry == null ? "disabled" : "")"
                id="entryTabBtn" data-bs-toggle="tab" data-bs-target="#entryTab" type="button" role="tab">
            <i class="bi bi-pencil-square me-1"></i>Entry
        </button>
    </li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom bg-white p-3" id="lbTabContent">
    <div class="tab-pane fade @(entryActive ? "" : "show active")" id="listTab" role="tabpanel">
        <div id="listHost">
            @await Html.PartialAsync("Partial/_ListGrid", Model)
        </div>
    </div>
    <div class="tab-pane fade @(entryActive ? "show active" : "")" id="entryTab" role="tabpanel">
        <div id="entryHost">
            @if (Model.Entry != null)
            {
                @await Html.PartialAsync("Partial/_EntryPane", Model)
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-upc-scan fs-1 d-block mb-2"></i>
                    <div>Select an indent from the <b>List</b> tab, or scan a Lab Indent No.</div>
                </div>
            }
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
@await Html.PartialAsync("Partial/_PickListModal")

@section Scripts {
    <script>
        window.LB0110_ACTIVE_TAB = '@(entryActive ? "entry" : "list")';
    </script>
    @* SweetAlert2 for Save success/failure feedback. The bundle is local so
       the dialog still works on machines without internet access; the JS also
       falls back to the inline #lbAlert if the bundle cannot load. *@
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/js/lab-testresult.js" asp-append-version="true"></script>
}
