                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-4">No tests found.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ================= INDENT SEARCH MODAL ================= *@
    @if (Model.OpenIndentModal)
    {
        <div class="modal fade show d-block sc-modal" tabindex="-1" style="background:rgba(15,39,71,.45)">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="fa-solid fa-file-lines me-2 text-primary"></i>Laboratory Indents</h5>
                        <a class="btn-close" href="@Url.Page("/Lab/SampleCollection")"></a>
                    </div>
                    <div class="modal-body">
                        <form method="get" asp-page="/Lab/SampleCollection" class="row g-2 mb-3">
                            <input type="hidden" name="OpenIndentModal" value="true" />
                            <div class="col-md-9">
                                <input name="IndentSearch" value="@Model.IndentSearch" class="form-control sc-input" placeholder="Search indent no or patient name..." autofocus />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100 sc-btn">Search</button>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 sc-table">
                                <thead>
                                    <tr>
                                        <th>Indent No</th>
                                        <th>Date</th>
                                        <th>Patient</th>
                                        <th class="text-end">Total</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ind in Model.RecentIndents)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@ind.LabNo</td>
