                                            <td>@(ind.Name ?? "-")</td>
                                            <td class="text-end">@ind.Net.ToString("N2")</td>
                                            <td>@(string.Equals(ind.Posted, "N", StringComparison.OrdinalIgnoreCase) ? "Unposted" : (ind.Posted ?? "-"))</td>
