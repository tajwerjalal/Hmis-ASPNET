@page "/lab/SampleCollection"
@model HmisWeb.Pages.Lab.SampleCollectionModel
@using HmisWeb.Data.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Sample Collection Entry";

    var patientName = Model.SelectedPatient != null
        ? HmisWeb.Services.PatientDisplayName.Of(Model.SelectedPatient)
        : null;
    var patientNameWithTitle = string.IsNullOrWhiteSpace(Model.PatientTitle)
        ? patientName
        : $"{patientName} ({Model.PatientTitle})";

    var companyItems = Model.Companies
        .Select(c => new { Value = c.Id, Text = (c.Name + " " + c.Id) });
    var consultantItems = Model.Consultants
        .Select(c => new { Value = c.Code, Text = (c.Prefix + " " + c.Name + " " + c.Code).Replace("  ", " ") });
    var selectedBilling = Model.SelectedVisitBilling;
}

<style>
    :root {
        --sc-navy: #0f2747;
        --sc-blue: #1d4ed8;
        --sc-light: #eaf2ff;
        --sc-soft: #f5f9ff;
        --sc-border: #d7e5f7;
        --sc-text: #1e293b;
        --sc-muted: #64748b;
    }

    .sc-page {
        font-family: "Segoe UI", Inter, system-ui, -apple-system, sans-serif;
        color: var(--sc-text);
    }

    .sc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        padding: 1rem 1.25rem;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--sc-navy), var(--sc-blue));
        color: #fff;
        box-shadow: 0 12px 30px rgba(15, 39, 71, .18);
    }

    .sc-header h4 { margin: 0; font-weight: 700; letter-spacing: .2px; }
    .sc-header .subtitle { color: rgba(255,255,255,.82); font-size: .88rem; margin-top: .2rem; }

    .sc-header-search {
        position: relative;
        min-width: 250px;
        max-width: 320px;
        flex: 1;
    }

    .sc-header-search input {
        height: 36px;
        border-radius: 999px;
        border: 0;
        padding-right: 40px;
        background: rgba(255,255,255,.92);
        color: var(--sc-navy);
        font-weight: 600;
    }

    .sc-header-search input::placeholder { color: #64748b; font-weight: 500; }

    .sc-header-search button {
        position: absolute;
        right: 4px;
        top: 50%;
        transform: translateY(-50%);
        width: 30px;
        height: 30px;
        border: 0;
        border-radius: 50%;
        background: var(--sc-navy);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .sc-card {
        background: #fff;
        border: 1px solid var(--sc-border);
        border-radius: 16px;
        box-shadow: 0 10px 28px rgba(15, 39, 71, .08);
        margin-bottom: 1rem;
        overflow: hidden;
    }

    .sc-card-header {
        padding: .85rem 1.15rem;
        background: linear-gradient(180deg, #f8fbff, #eef5ff);
        border-bottom: 1px solid var(--sc-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
    }

    .sc-card-title {
        font-weight: 700;
        color: var(--sc-navy);
        display: flex;
        align-items: center;
        gap: .55rem;
    }

    .sc-card-body { padding: 1.1rem; }

    .sc-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--sc-muted);
        margin-bottom: .35rem;
        letter-spacing: .02em;
    }

    .sc-input, .sc-select {
        height: 34px;
        border-radius: 8px;
        border: 1px solid var(--sc-border);
        background: #fff;
        transition: border-color .15s ease, box-shadow .15s ease;
        font-size: .9rem;
    }

    .sc-input:focus, .sc-select:focus {
        border-color: var(--sc-blue);
        box-shadow: 0 0 0 .2rem rgba(29, 78, 216, .12);
    }

    .sc-input-readonly {
        background: #f1f5f9;
        color: #334155;
        font-weight: 600;
    }

    .sc-search-wrap { position: relative; }

    .sc-search-btn {
        position: absolute;
        right: 4px;
        top: 50%;
        transform: translateY(-50%);
        width: 28px;
        height: 28px;
        border: 0;
        border-radius: 6px;
        background: var(--sc-blue);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background .15s ease;
    }

    .sc-search-btn:hover { background: var(--sc-navy); }

    .sc-btn {
        height: 34px;
        border-radius: 8px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: 0 .85rem;
    }

    .sc-patient-panel {
        margin-top: 1rem;
        padding: 1rem 1.15rem;
        border-radius: 14px;
        background: linear-gradient(135deg, #eef6ff, #f8fbff);
        border: 1px solid #cfe0f5;
        border-left: 5px solid var(--sc-blue);
    }

    .sc-patient-name {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--sc-navy);
        margin-bottom: .65rem;
    }

    .sc-patient-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: .65rem .9rem;
    }

    .sc-patient-item {
        display: flex;
        align-items: flex-start;
        gap: .55rem;
        padding: .55rem .65rem;
        border-radius: 10px;
        background: rgba(255,255,255,.72);
        border: 1px solid rgba(207, 224, 245, .8);
    }

    .sc-patient-item i {
        color: var(--sc-blue);
        margin-top: .15rem;
    }

    .sc-patient-item span {
        display: block;
        font-size: .72rem;
        font-weight: 700;
        color: var(--sc-muted);
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .sc-patient-item strong {
        display: block;
        color: var(--sc-text);
        font-size: .92rem;
        font-weight: 700;
    }

    .sc-table thead th {
        background: linear-gradient(180deg, var(--sc-navy), #163b66);
        color: #fff;
        font-size: .82rem;
        font-weight: 700;
        border: 0;
        white-space: nowrap;
        padding: .7rem .6rem;
    }

    .sc-table tbody td {
        vertical-align: middle;
        padding: .55rem .6rem;
        border-color: #e7eff8;
        font-size: .88rem;
    }

    .sc-table tbody tr:nth-child(even) { background: #fafcff; }
    .sc-table tbody tr:hover { background: #eef5ff; }

    .sc-empty {
        padding: 2.5rem 1rem;
        text-align: center;
        color: var(--sc-muted);
    }

    .sc-empty i {
        font-size: 2.6rem;
        color: #b9cbe5;
        display: block;
        margin-bottom: .6rem;
    }

    .sc-total-box {
        background: linear-gradient(135deg, var(--sc-navy), var(--sc-blue));
        color: #fff;
        border-radius: 12px;
        padding: .85rem 1.1rem;
        display: inline-flex;
        align-items: center;
        gap: .75rem;
        box-shadow: 0 8px 20px rgba(29, 78, 216, .2);
    }

    .sc-total-box .label { font-size: .8rem; opacity: .85; font-weight: 700; }
    .sc-total-box .value { font-size: 1.35rem; font-weight: 800; }

    .sc-footer {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .sc-modal .modal-content {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(15, 39, 71, .25);
    }

    .sc-modal .modal-header {
        background: linear-gradient(180deg, #f8fbff, #eef5ff);
        border-bottom: 1px solid var(--sc-border);
    }

    .sc-billing-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        padding-bottom: .75rem;
        border-bottom: 1px dashed var(--sc-border);
    }

    .sc-billing-name {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--sc-navy);
    }

    .sc-billing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: .65rem;
    }

    .sc-billing-box {
        padding: .75rem .85rem;
        border-radius: 12px;
        background: #f8fbff;
        border: 1px solid var(--sc-border);
    }

    .sc-billing-box span {
        display: block;
        font-size: .72rem;
        font-weight: 700;
        color: var(--sc-muted);
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .sc-billing-box strong {
        display: block;
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--sc-text);
    }

    .sc-billing-box.sc-billing-balance {
        background: linear-gradient(135deg, var(--sc-navy), var(--sc-blue));
        border-color: transparent;
    }

    .sc-billing-box.sc-billing-balance span { color: rgba(255,255,255,.8); }
    .sc-billing-box.sc-billing-balance strong { color: #fff; }

    @@media (max-width: 768px) {
        .sc-header { flex-direction: column; align-items: flex-start; }
        .sc-card-body { padding: .9rem; }
    }
</style>

<div class="sc-page">
    <div class="sc-header">
        <div>
            <h4><i class="fa-solid fa-flask me-2"></i>Sample Collection Entry</h4>
            <div class="subtitle">Collect patient, indent and laboratory test details in one professional workflow</div>
        </div>
        <form method="get" asp-page="/Lab/SampleCollection" class="sc-header-search">
            <input type="hidden" name="OpenIndentModal" value="true" />
            <input name="IndentSearch" value="@Model.IndentSearch" class="form-control form-control-sm" placeholder="Search indent no / patient..." />
            <button type="submit" title="Search laboratory indents">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </form>

        @if (Model.SelectedPatient != null)
        {
            <form method="post" asp-page-handler="SwitchPatient">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-light"><i class="fa-solid fa-arrow-right-arrow-left me-1"></i>Switch Patient</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="StartNew">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-light"><i class="fa-solid fa-file-circle-plus me-1"></i>New Entry</button>
            </form>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success py-2"><i class="fa-solid fa-circle-check me-1"></i>@Model.Success</div>
    }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-warning py-2"><i class="fa-solid fa-triangle-exclamation me-1"></i>@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger py-2"><i class="fa-solid fa-circle-xmark me-1"></i>@Model.ErrorMessage</div>
    }
    @if (Model.IsViewOnly)
    {
        <div class="alert alert-info py-2"><i class="fa-solid fa-circle-info me-1"></i><b>Read-only mode:</b> This indent is either paid or already posted. Changes are not allowed.</div>
    }

    @* ================= MASTER / PATIENT ================= *@
    <div class="sc-card">
        <div class="sc-card-header">
            <div class="sc-card-title"><i class="fa-solid fa-id-card"></i>Indent &amp; Patient</div>

        </div>
        <div class="sc-card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="sc-label">Lab Indent No</label>
                    <input asp-for="LabNoInput" readonly class="form-control sc-input sc-input-readonly" placeholder="Auto generated" />
                </div>
                <div class="col-md-4">
                    <label class="sc-label">Collection Date</label>
                    <input type="date" name="CollectionDate" readonly class="form-control sc-input sc-input-readonly" value="@(Model.CollectionDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-4">
                    <label class="sc-label">Collection Time</label>
                    <input type="time" name="CollectionTime" readonly class="form-control sc-input sc-input-readonly" value="@Model.CollectionTime" />
                </div>
            </div>

            @if (!Model.IsViewOnly)
            {
                <form method="post" asp-page-handler="SearchPatients" class="row g-3 align-items-end mb-2">
                    @Html.AntiForgeryToken()
                    <div class="col-md-3">
                        <label class="sc-label">Patient Type</label>
                        <select asp-for="PatientType" class="form-select sc-select">
                            <option value="OPD">OPD</option>
                            <option value="IPD">IPD</option>
                        </select>
                    </div>
                    <div class="col-md-9">
                        <label class="sc-label">Patient Code / Reg No.</label>
                        <div class="sc-search-wrap">
                            <input asp-for="PatientSearch" class="form-control sc-input" style="padding-right: 82px;" placeholder="Patient code, reg no, name or phone" />
                            <button type="submit" class="sc-search-btn" style="right: 42px;" title="Search registered patients">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                            <a class="sc-search-btn" style="right: 4px; background: #16a34a; text-decoration: none;"
                               href="@Url.Page("/Opd/Registration", new { returnUrl = "/lab/SampleCollection", newPatient = true })"
                               title="Add new patient">
                                <i class="fa-solid fa-user-plus"></i>
                            </a>
                        </div>
                    </div>
                </form>
            }

            <div id="newPatientSection" style="display:none" class="mt-3">
                <div class="sc-card" style="box-shadow:none;border-color:#cfe0f5;">
                    <div class="sc-card-header">
                        <div class="sc-card-title"><i class="fa-solid fa-user-plus"></i>Add New Patient</div>
                    </div>
                    <div class="sc-card-body">
                        <form method="post" asp-page-handler="CreatePatient" class="row g-2">
                            @Html.AntiForgeryToken()
                            <div class="col-md-4"><input asp-for="NewName" class="form-control sc-input" placeholder="Full name *" /></div>
                            <div class="col-md-4"><input asp-for="NewNameWithInitials" class="form-control sc-input" placeholder="Name with initials" /></div>
                            <div class="col-md-4"><input asp-for="NewNic" class="form-control sc-input" placeholder="NIC" /></div>
                            <div class="col-md-4"><input asp-for="NewMobile" class="form-control sc-input" placeholder="Mobile" /></div>
                            <div class="col-md-4"><input asp-for="NewPhone" class="form-control sc-input" placeholder="Phone" /></div>
                            <div class="col-md-4">
                                <select asp-for="NewSex" asp-items="Html.GetEnumSelectList<Sex>()" class="form-select sc-select">
                                    <option value="">-- Sex --</option>
                                </select>
                            </div>
                            <div class="col-12 d-flex gap-2 align-items-center">
                                <button type="submit" class="btn btn-success sc-btn"><i class="fa-solid fa-plus me-1"></i>Add &amp; select</button>
                                <a href="javascript:void(0)" onclick="toggleNewPatient(false)" class="small text-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @if (!Model.SearchResults.Any() && !string.IsNullOrEmpty(Model.PatientSearch))
            {
                <div class="alert alert-info py-2 mt-3 mb-0">
                    <i class="fa-solid fa-circle-info me-1"></i>No patient found for "<b>@Model.PatientSearch</b>".
                    <a href="@Url.Page("/Opd/Registration", new { returnUrl = "/lab/SampleCollection", newPatient = true })" class="fw-semibold text-decoration-underline">Add a new walk-in patient?</a>
                </div>
            }

            @if (Model.SelectedPatient != null)
            {
                <div class="sc-patient-panel">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div class="sc-patient-name">
                            <i class="fa-solid fa-user me-2"></i>@patientNameWithTitle
                        </div>
                        @if (selectedBilling != null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary sc-btn"
                                    onclick="showBilling(this)"
                                    data-patient-code="@(selectedBilling.PatientCode ?? Model.PatientCode)"
                                    data-regno="@(selectedBilling.RegNo ?? Model.SelectedRegNo)"
                                    data-date="@(selectedBilling.RDate?.ToString("dd MMM yyyy") ?? "-") @selectedBilling.RTime"
                                    data-name="@selectedBilling.Name"
                                    data-sex="@selectedBilling.Sex"
                                    data-age="@selectedBilling.Age"
                                    data-type="@(selectedBilling.Type == "I" ? "IPD" : selectedBilling.Type == "O" ? "OPD" : (selectedBilling.Type ?? "-"))"
                                    data-company="@selectedBilling.Cid"
                                    data-consultant="@selectedBilling.Concode"
                                    data-phone="@(Model.LegacyPatient?.Phone1 ?? Model.LegacyPatient?.Phone2 ?? Model.LegacyPatient?.Phone3)"
                                    data-bill="@((selectedBilling.BillAmount ?? 0).ToString("N2"))"
                                    data-received="@((selectedBilling.Received ?? 0).ToString("N2"))"
                                    data-paid="@((selectedBilling.Paid ?? 0).ToString("N2"))"
                                    data-discount="@((selectedBilling.Discount ?? 0).ToString("N2"))"
                                    data-balance="@selectedBilling.Balance.ToString("N2")"
                                    data-generated="@selectedBilling.BillGeneratedText"
                                    data-settled="@selectedBilling.SettledText"
                                    data-status="@selectedBilling.BillStatusText">
                                <i class="fa-solid fa-receipt me-1"></i>Visit Billing
                            </button>
                        }
                    </div>
                    <div class="sc-patient-grid">
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-barcode"></i>
                            <div><span>Patient Code</span><strong>@(Model.PatientCode ?? "-")</strong></div>
                        </div>
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-hashtag"></i>
                            <div><span>Registration No</span><strong>@(string.IsNullOrWhiteSpace(Model.SelectedRegNo) ? "-" : Model.SelectedRegNo)</strong></div>
                        </div>
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-venus-mars"></i>
                            <div><span>Sex</span><strong>@(Model.LegacyPatient?.Sex?.Trim().ToUpperInvariant() switch { "M" => "Male", "F" => "Female", _ => (Model.LegacyPatient?.Sex ?? "-") })</strong></div>
                        </div>
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-cake-candles"></i>
                            <div><span>Age</span><strong>@(Model.LegacyPatient?.Age ?? "-") @(Model.LegacyPatient?.AType ?? "")</strong></div>
                        </div>
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-hospital-user"></i>
                            <div><span>Patient Type</span><strong>@(Model.LegacyPatient?.RegType ?? Model.LegacyPatient?.AType ?? Model.PatientType)</strong></div>
                        </div>
                    </div>

                    @* Billing controls only: no duplicate patient details *@
                    <div class="row g-3 mt-2">
                        <div class="col-md-5">
                            <label class="sc-label">Company Code + Name</label>
                            <select asp-for="SelectedCid" disabled="@Model.IsViewOnly" form="entryForm" class="form-select sc-select @(Model.IsViewOnly ? "sc-input-readonly" : "")"
                                    asp-items="@(new SelectList(companyItems, "Value", "Text", Model.CompanyCode))">
                                <option value="">-- none / self paying --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="sc-label">Consultant Code + Name</label>
                            <select asp-for="SelectedConcode" disabled="@Model.IsViewOnly" form="entryForm" class="form-select sc-select @(Model.IsViewOnly ? "sc-input-readonly" : "")"
                                    asp-items="@(new SelectList(consultantItems, "Value", "Text", Model.ConsultCode))">
                                <option value="">-- none --</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            @if (!Model.IsViewOnly)
                            {
                                <button type="submit" form="entryForm" formaction="@Url.Page("/Lab/SampleCollection", new { handler = "UpdateContext" })"
                                        class="btn btn-primary sc-btn w-100">
                                    <i class="fa-solid fa-check-double me-1"></i>Update / Re-price
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (Model.SelectedPatient != null)
    {
        <form method="post" id="entryForm">
            @Html.AntiForgeryToken()

            @* ---------- Detail record: tests grid ---------- *@
            <div class="sc-card">
                <div class="sc-card-header">
                    <div class="sc-card-title"><i class="fa-solid fa-flask"></i>Laboratory Test Details</div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge rounded-pill text-bg-primary px-3 py-2">Tests: @Model.DisplayCart.Count</span>
                        @if (!Model.IsViewOnly)
                        {
                            <button type="submit" formaction="@Url.Page("/Lab/SampleCollection", new { handler = "OpenItems" })" class="btn btn-sm btn-primary sc-btn">
                                <i class="fa-solid fa-plus me-1"></i>Add Test
                            </button>
                        }
                    </div>
                </div>
                <div class="sc-card-body">
                    @if (Model.DisplayCart.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0 sc-table" id="testsTable">
                                <thead>
                                    <tr>
                                        <th style="width:42px">#</th>
                                        <th style="width:110px">Test ID / Code</th>
                                        <th>Test Description</th>
                                        <th style="width:110px" class="text-end">Charges</th>
                                        <th style="width:110px" class="text-end">Amount</th>
                                        <th style="width:135px">Date</th>
                                        <th style="width:145px">Resource (LID)</th>
                                        <th style="width:46px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.DisplayCart.Count; i++)
                                    {
                                        var line = Model.DisplayCart[i];
                                        <tr class="sc-test-row">
                                            <td>@(i + 1)</td>
                                            <td>
                                                <input type="hidden" name="Cart[@i].ItemId" value="@line.ItemId" />
                                                <input type="hidden" name="Cart[@i].Code" value="@line.Code" />
                                                <input type="hidden" name="Cart[@i].ItemName" value="@line.ItemName" />
                                                <input type="hidden" name="Cart[@i].Qty" value="@line.Qty" />
                                                <input type="hidden" name="Cart[@i].RateUrgent" value="@line.RateUrgent" />
                                                <input type="hidden" name="Cart[@i].Urgent" value="@line.Urgent" />
                                                <input class="form-control form-control-sm sc-input-readonly" value="@line.Code" readonly />
                                            </td>
                                            <td class="fw-semibold">@line.ItemName</td>
                                            <td class="text-end">
                                                <input type="number" step="0.01" min="0" name="Cart[@i].Rate"
                                                       value="@line.Rate.ToString("0.00")"
                                                       @(Model.IsViewOnly ? "readonly disabled" : "")
                                                       class="form-control form-control-sm text-end @(Model.IsViewOnly ? "sc-input-readonly" : "charge-input")" />
                                            </td>
                                            <td class="text-end fw-semibold">@line.NetValue.ToString("N2")</td>
                                            <td>
                                                <input type="date" name="Cart[@i].TCDate"
                                                       value="@(line.TCDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))"
                                                       @(Model.IsViewOnly ? "readonly disabled" : "")
                                                       class="form-control form-control-sm @(Model.IsViewOnly ? "sc-input-readonly" : "")" />
                                            </td>
                                            <td>
                                                <input list="resourceList" name="Cart[@i].Lid" value="@line.Lid"
                                                       @(Model.IsViewOnly ? "readonly disabled" : "")
                                                       class="form-control form-control-sm @(Model.IsViewOnly ? "sc-input-readonly" : "")" placeholder="HM" />
                                            </td>
                                            <td class="text-end">
                                                @if (!Model.IsViewOnly)
                                                {
                                                    <button type="submit"
                                                            formaction="@Url.Page("/Lab/SampleCollection", new { handler = "RemoveItem", ItemToRemove = i })"
                                                            formnovalidate
                                                            class="btn btn-sm btn-outline-danger" title="Remove">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-light">
                                        <td colspan="4" class="text-end fw-bold">Total</td>
                                        <td class="text-end fw-bold"><span id="grandTotal">@((Model.DisplayCart?.Any() == true ? Model.DisplayCart.Sum(c => c.NetValue) : (Model.Cart?.Any() == true ? Model.Cart.Sum(c => c.NetValue) : Model.NetTotal)).ToString("N2"))</span></td>
                                        <td colspan="3"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="sc-empty">
                            <i class="fa-solid fa-vial"></i>
                            No tests added yet.
                            @if (!Model.IsViewOnly)
                            {
                                <div class="mt-2">
                                    <button type="submit" formaction="@Url.Page("/Lab/SampleCollection", new { handler = "OpenItems" })" class="btn btn-sm btn-primary sc-btn">
                                        <i class="fa-solid fa-plus me-1"></i>Add Test
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* ---------- Financial summary footer ---------- *@
            <div class="sc-card">
                <div class="sc-card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label class="sc-label">Remarks</label>
                            <input asp-for="Comments" readonly="@Model.IsViewOnly" disabled="@Model.IsViewOnly" class="form-control sc-input @(Model.IsViewOnly ? "sc-input-readonly" : "")" placeholder="Optional remarks..." />
                        </div>
                        <div class="col-md-3">
                            <div class="sc-total-box">
                                <div>
                                    <div class="label">Total Charges</div>
                                    <div class="value" id="grandTotalFooter">@((Model.DisplayCart?.Any() == true ? Model.DisplayCart.Sum(c => c.NetValue) : (Model.Cart?.Any() == true ? Model.Cart.Sum(c => c.NetValue) : Model.NetTotal)).ToString("N2"))</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="sc-footer">
                                @if (!Model.IsViewOnly)
                                {
                                    <button type="submit" formaction="@Url.Page("/Lab/SampleCollection", new { handler = "StartNew" })" class="btn btn-outline-secondary sc-btn">
                                        <i class="fa-solid fa-rotate-left"></i>Clear
                                    </button>
                                    <button type="submit" formaction="@Url.Page("/Lab/SampleCollection", new { handler = "Save" })"
                                            class="btn btn-success sc-btn" @(Model.DisplayCart.Any() ? "" : "disabled")>
                                        <i class="fa-solid fa-save"></i>Save Indent
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <datalist id="resourceList">
            @foreach (var r in Model.Resources)
            {
                <option value="@r.Code">@r.Name</option>
            }
        </datalist>
    }

    @* ================= TEST SEARCH MODAL ================= *@
    @if (Model.OpenItemModal)
    {
        <div class="modal fade show d-block sc-modal" tabindex="-1" style="background:rgba(15,39,71,.45)">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="fa-solid fa-flask me-2 text-primary"></i>Find Test (SERVICES - dept 01)</h5>
                        <a class="btn-close" href="@Url.Page("/Lab/SampleCollection")"></a>
                    </div>
                    <div class="modal-body">
                        <form method="get" asp-page="/Lab/SampleCollection" class="row g-2 mb-3">
                            <input type="hidden" name="OpenItemModal" value="true" />
                            <div class="col-md-9">
                                <input name="ItemSearch" value="@Model.ItemSearch" class="form-control sc-input" placeholder="Test name or code..." autofocus />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100 sc-btn">Search</button>
                            </div>
                        </form>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 sc-table">
                                <thead>
                                    <tr><th>Code</th><th>Test</th><th class="text-end">Rate</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.DeptServiceResults)
                                    {
                                        <tr>
                                            <td>@s.Code</td>
                                            <td>@(s.Name?.Trim())</td>
                                            <td class="text-end">@(((double)(s.Rate ?? s.RateForeigner ?? 0)).ToString("N2"))</td>
                                            <td class="text-end">
                                                <form method="post" asp-page-handler="AddItem">
                                                    <input type="hidden" name="SelectedItemId" value="@s.Id" />
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success">Add</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
