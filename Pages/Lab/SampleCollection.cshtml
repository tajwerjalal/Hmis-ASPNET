    @* ================= PATIENT SEARCH RESULTS MODAL ================= *@
    @if (Model.SearchResults.Any())
    {
        <div class="modal fade show d-block sc-modal" tabindex="-1" style="background:rgba(15,39,71,.55); z-index:1055;">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title"><i class="fa-solid fa-users me-2 text-primary"></i>Patient Search Results</h5>
                            <div class="small text-muted mt-1">
                                Search: <b>@Model.PatientSearch</b> &middot; @Model.SearchResults.Count result(s)
                                &middot; patient code is permanent, registration no is per visit
                            </div>
                        </div>
                        <a class="btn-close" href="@Url.Page("/Lab/SampleCollection")" title="Close"></a>
                    </div>
                    <div class="modal-body">
                        <form method="post" asp-page-handler="SearchPatients" class="row g-2 mb-3">
                            @Html.AntiForgeryToken()
                            <div class="col-md-9">
                                <input name="PatientSearch" value="@Model.PatientSearch" class="form-control sc-input" placeholder="Patient code, reg no, name or phone" />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100 sc-btn">
                                    <i class="fa-solid fa-magnifying-glass me-1"></i>Search again
                                </button>
                            </div>
                        </form>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 sc-table">
                                <thead>
                                    <tr>
                                        <th>Patient Code</th>
                                        <th>Reg No</th>
                                        <th>Date</th>
                                        <th>Name</th>
                                        <th>Sex</th>
                                        <th>Age</th>
                                        <th>Type</th>
                                        <th>Company</th>
                                        <th>Consultant</th>
                                        <th>Phone</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.SearchResults)
                                    {
                                        var patientCode = r.PatientCode ?? r.PCode ?? r.RegNo;
                                        var visitRegNo = r.VisitRegNo;
                                        var typeText = r.Type == "I" ? "IPD" : r.Type == "O" ? "OPD" : (r.Type ?? "-");
                                        var balance = (r.BillAmount ?? 0) - (r.Received ?? 0) + (r.Paid ?? 0) - (r.Discount ?? 0);
                                        <tr>
                                            <td class="fw-semibold">@(patientCode ?? "-")</td>
                                            <td class="fw-semibold">@(string.IsNullOrWhiteSpace(visitRegNo) ? "-" : visitRegNo)</td>
                                            <td>@(r.RDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                            <td>@(r.Name ?? "-")</td>
                                            <td>@(r.Sex ?? "-")</td>
                                            <td>@(r.Age ?? "-")</td>
                                            <td>@typeText</td>
                                            <td>@(r.Cid ?? "-")</td>
                                            <td>@(r.Concode ?? "-")</td>
                                            <td>@(r.Phone ?? "-")</td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                                        onclick="showBilling(this)"
                                                        data-patient-code="@(patientCode)"
                                                        data-regno="@(visitRegNo)"
                                                        data-date="@(r.RDate?.ToString("dd MMM yyyy") ?? "-") @r.RTime"
                                                        data-name="@r.Name"
                                                        data-sex="@r.Sex"
                                                        data-age="@r.Age"
                                                        data-type="@typeText"
                                                        data-company="@r.Cid"
                                                        data-consultant="@r.Concode"
                                                        data-phone="@r.Phone"
                                                        data-bill="@((r.BillAmount ?? 0).ToString("N2"))"
                                                        data-received="@((r.Received ?? 0).ToString("N2"))"
                                                        data-paid="@((r.Paid ?? 0).ToString("N2"))"
                                                        data-discount="@((r.Discount ?? 0).ToString("N2"))"
                                                        data-balance="@balance.ToString("N2")"
                                                        data-generated="@r.BillGeneratedText"
                                                        data-settled="@r.SettledText"
                                                        data-status="@r.BillStatusText"
                                                        data-has-billing="@(string.IsNullOrWhiteSpace(r.VisitRegNo) ? "0" : "1")">
                                                    <i class="fa-solid fa-receipt"></i> Billing
                                                </button>
                                                <form method="post" asp-page-handler="SelectPatient" class="d-inline">
                                                    <input type="hidden" name="SelectedPatientId" value="@r.PatientAppId" />
                                                    <input type="hidden" name="SelectedRegNo" value="@visitRegNo" />
                                                    <input type="hidden" name="SelectedPatientCode" value="@patientCode" />
                                                    <input type="hidden" name="SelectedCid" value="@r.Cid" />
                                                    <input type="hidden" name="SelectedConcode" value="@r.Concode" />
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-primary">Select</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ================= VISIT BILLING MODAL ================= *@
    <div id="billingModal" class="modal fade sc-modal" tabindex="-1" style="display:none; background:rgba(15,39,71,.6); z-index:1070;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title"><i class="fa-solid fa-receipt me-2 text-primary"></i>Visit Billing Summary</h5>
                        <div class="small text-muted mt-1">REGISTER + PATIENT &middot; p.CODE = r.PCODE</div>
                    </div>
                    <button type="button" class="btn-close" onclick="closeBilling()" title="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="billNoRecord" class="alert alert-info py-2" style="display:none;">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        No REGISTER billing record was found for this patient/visit. The patient code is shown, but no visit bill exists yet.
                    </div>
                    <div class="sc-billing-head">
                        <div>
                            <div class="sc-billing-name" id="billName">-</div>
                            <div class="small text-muted" id="billSexAge">-</div>
                        </div>
                        <span class="badge text-bg-primary" id="billStatus">-</span>
                    </div>

                    <div class="sc-patient-grid mt-3">
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-barcode"></i>
                            <div><span>Patient Code</span><strong id="billPatientCode">-</strong></div>
                        </div>
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-hashtag"></i>
                            <div><span>Registration No</span><strong id="billRegNo">-</strong></div>
                        </div>
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-calendar"></i>
                            <div><span>Visit Date</span><strong id="billDate">-</strong></div>
                        </div>
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-hospital-user"></i>
                            <div><span>Patient Type</span><strong id="billType">-</strong></div>
                        </div>
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-building"></i>
                            <div><span>Company</span><strong id="billCompany">-</strong></div>
                        </div>
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-user-doctor"></i>
                            <div><span>Consultant</span><strong id="billConsultant">-</strong></div>
                        </div>
                        <div class="sc-patient-item">
                            <i class="fa-solid fa-phone"></i>
                            <div><span>Phone</span><strong id="billPhone">-</strong></div>
                        </div>
                    </div>

                    <div class="sc-billing-grid mt-3" id="billFinancials">
                        <div class="sc-billing-box"><span>Bill Amount</span><strong id="billAmount">0.00</strong></div>
                        <div class="sc-billing-box"><span>Received</span><strong id="billReceived">0.00</strong></div>
                        <div class="sc-billing-box"><span>Paid</span><strong id="billPaid">0.00</strong></div>
                        <div class="sc-billing-box"><span>Discount</span><strong id="billDiscount">0.00</strong></div>
                        <div class="sc-billing-box sc-billing-balance"><span>Balance</span><strong id="billBalance">0.00</strong></div>
                    </div>

                    <div class="d-flex gap-3 flex-wrap mt-3 small text-muted" id="billStatusLine">
                        <span>Bill generated: <b id="billGenerated">-</b></span>
                        <span>Settled: <b id="billSettled">-</b></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary sc-btn" onclick="closeBilling()">Close</button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function toggleNewPatient(open) {
                var el = document.getElementById('newPatientSection');
                if (el) { el.style.display = open ? '' : 'none'; }
            }

            function showBilling(btn) {
                var d = btn.dataset || {};
                function set(id, value) {
                    var el = document.getElementById(id);
                    if (el) el.textContent = (value === undefined || value === null || value === '') ? '-' : value;
                }
                set('billName', d.name);
                set('billSexAge', [d.sex, d.age].filter(function (x) { return x && x !== '-'; }).join(' / '));
                set('billPatientCode', d.patientCode);
                set('billRegNo', d.regno);
                set('billDate', d.date);
                set('billType', d.type);
                set('billCompany', d.company);
                set('billConsultant', d.consultant);
                set('billPhone', d.phone);
                set('billAmount', d.bill);
                set('billReceived', d.received);
                set('billPaid', d.paid);
                set('billDiscount', d.discount);
                set('billBalance', d.balance);
                set('billGenerated', d.generated);
                set('billSettled', d.settled);
                set('billStatus', d.status);
                var hasBilling = d.hasBilling !== '0';
                var noRecord = document.getElementById('billNoRecord');
                var financials = document.getElementById('billFinancials');
                var statusLine = document.getElementById('billStatusLine');
                if (noRecord) noRecord.style.display = hasBilling ? 'none' : '';
                if (financials) financials.style.display = hasBilling ? '' : 'none';
                if (statusLine) statusLine.style.display = hasBilling ? '' : 'none';
                var modal = document.getElementById('billingModal');
                if (modal) {
                    modal.style.display = 'block';
                    modal.classList.add('show');
                    modal.setAttribute('aria-modal', 'true');
                }
            }

            function closeBilling() {
                var modal = document.getElementById('billingModal');
                if (modal) {
                    modal.classList.remove('show');
                    modal.style.display = 'none';
                    modal.removeAttribute('aria-modal');
                }
            }

            function recalcTotal() {
                var sum = 0;
                document.querySelectorAll('.charge-input').forEach(function (el) {
                    sum += parseFloat(el.value) || 0;
                });
                var text = sum.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                var a = document.getElementById('grandTotal');
                var b = document.getElementById('grandTotalFooter');
                if (a) a.textContent = text;
                if (b) b.textContent = text;
            }

            function filterTests(term) {
                term = (term || '').toLowerCase();
                document.querySelectorAll('.sc-test-row').forEach(function (row) {
                    var text = row.textContent.toLowerCase();
                    row.style.display = text.indexOf(term) >= 0 ? '' : 'none';
                });
            }

            document.addEventListener('input', function (e) {
                if (e.target && e.target.classList && e.target.classList.contains('charge-input')) {
                    recalcTotal();
                }
            });

            recalcTotal();
        </script>
    }