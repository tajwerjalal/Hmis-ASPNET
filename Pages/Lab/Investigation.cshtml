@page
@model HmisWeb.Pages.Lab.InvestigationModel
@{
    ViewData["Title"] = "Investigations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Investigations</h4>
    <a asp-page="/Lab/NewItem" class="btn btn-primary btn-sm">Add Investigation</a>
</div>

<table class="table table-bordered table-sm table-hover">
    <thead class="table-light">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Code</th>
            <th>Category</th>
            <th class="text-end">Price</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Code</td>
                    <td>@(item.Category?.Name ?? "")</td>
                    <td class="text-end">@item.Total?.ToString("N2")</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5" class="text-center text-muted">No investigations found.</td></tr>
        }
    </tbody>
</table>
