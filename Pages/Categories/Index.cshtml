@page
@model HmisWeb.Pages.Categories.IndexModel
@*
    Item Categories - list + add form of the category master.

    Developer : [TAJWER JALAL]
    Date      : 22-Oct-2026
    Time      : 13:20
    Change Log: 22-Oct-2026 13:20 - the retire confirmation moved from the native
                confirm() to SweetAlert2, matching the consultant master screen.
                The form still posts the same handler and id, the dialog only
                decides whether the post happens.
*@
@{
    ViewData["Title"] = "Item Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Item Categories</h4>
        <div class="text-muted small">Manage Item Categories records.</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7 col-12">
        <div class="card">
            <div class="card-header bg-white d-flex align-items-center justify-content-between">
                <strong>Item Categories</strong>
                <span class="badge bg-primary rounded-pill">@Model.Items.Count</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Institution</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No records yet. Add the first one on the right.</td></tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@(item.Code ?? "-")</td>
                                <td>@(item.SymanticType?.ToString() ?? "-")</td>
                                <td>@(item.Institution?.Name ?? "-")</td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Delete" class="js-retire" data-name="@item.Name">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Retire"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5 col-12">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Add New</div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
                }
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Name" class="form-label">Name *</label>
                            <input asp-for="Input.Name" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Code" class="form-label">Code</label>
                            <input asp-for="Input.Code" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.SymanticType" class="form-label">Semantic Type</label>
                            <select asp-for="Input.SymanticType" asp-items="Html.GetEnumSelectList<SymanticType>()" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ParentCategoryId" class="form-label">Parent Category</label>
                            <select asp-for="Input.ParentCategoryId" asp-items="Model.ParentCategoryIdList" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3 w-100"><i class="bi bi-plus-lg"></i> Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.1/sweetalert2.all.min.js"></script>
    <script>
        // retire confirmation: SweetAlert2 instead of the browser confirm().
        // Every retire form is intercepted; the post only runs when the user
        // confirms, so the server side handler is untouched.
        (function () {
            document.querySelectorAll('form.js-retire').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    var name = form.dataset.name || 'this category';

                    if (!window.Swal) {
                        if (window.confirm('Retire ' + name + '?')) form.submit();
                        return;
                    }

                    window.Swal.fire({
                        title: 'Retire category?',
                        text: name + ' - the record is kept for history and leaves the list.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Retire',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#dc3545'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        })();
    </script>
}