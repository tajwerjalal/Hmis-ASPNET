@page "/xr/indent"
@model HmisWeb.Pages.Xr.IndentModel
@*
    X-ray / CT scan indent screen (route /xr/indent).

    Purpose
      Renders the shared department indent UI so the X-ray process is identical
      to Ultrasound: patient search, IPD detection, service popup, cart, save.

    Why
      The page used to carry its own inline service grid. It now delegates the
      whole indenting process to Pages/Shared/_DepartmentIndent.cshtml and
      Pages/Shared/DepartmentIndentPageModel.cs.

    Business rules / validations
      Handled by the shared page model (patient + one line required, DEPT 02
      services only, panel rate resolution, discount clamping, IPD vs OPD).

    Developer : AI Assistant
    Modified  : 27-Oct-2026 11:27 - replaced the bespoke X-ray layout with the
                shared Ultrasound indenting process.
*@
@{
    ViewData["Title"] = "X-ray Service Indent (Invoice)";
}

<partial name="_DepartmentIndent" model="Model" />

@section Scripts {
    <script src="~/js/department-indent.js" asp-append-version="true"></script>
}
