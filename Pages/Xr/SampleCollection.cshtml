@page "/xr/SampleCollection"
@model HmisWeb.Pages.Xr.SampleCollectionModel
@using HmisWeb.Data.Enums
@{
    ViewData["Title"] = "X-ray Collection Entry";
}

<style>
    .sc-page { max-width: 1380px; margin: 0 auto; }
    .sc-header {
        display: flex; justify-content: space-between; align-items: center; gap: 1rem;
        padding: 1rem 1.25rem; margin-bottom: 1rem;
        border: 1px solid #d9e5f2; border-radius: 14px;
        background: linear-gradient(135deg, #0f2747 0%, #1f4e79 55%, #2f6ea8 100%);
        color: #fff; box-shadow: 0 10px 24px rgba(15, 39, 71, .12);
    }
    .sc-header h4 { margin: 0; font-weight: 700; letter-spacing: .2px; }
    .sc-header .subtitle { font-size: .86rem; color: rgba(255,255,255,.84); }
    .sc-card { border: 1px solid #dfe8f3; border-radius: 14px; box-shadow: 0 6px 18px rgba(20, 44, 77, .05); margin-bottom: 1rem; background: #fff; }
    .sc-card-header {
        padding: .85rem 1rem; border-bottom: 1px solid #e7eef7;
        background: linear-gradient(180deg, #f8fbff 0%, #f2f7fd 100%);
        border-radius: 14px 14px 0 0;
        display: flex; justify-content: space-between; align-items: center; gap: .75rem;
    }
    .sc-card-header h6 { margin: 0; font-weight: 700; color: #183a63; }
    .sc-card-body { padding: 1rem; }
    .sc-section-title {
        font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .45px;
        color: #355a86; margin-bottom: .65rem; padding-bottom: .35rem; border-bottom: 1px dashed #d7e3f1;
    }
    .sc-label { font-size: .75rem; font-weight: 600; color: #5b6f86; margin-bottom: .2rem; }
    .sc-input, .sc-select { min-height: 34px; font-size: .875rem; border-radius: 8px; border-color: #cedae8; }
    .sc-input:focus, .sc-select:focus { border-color: #6fa3d8; box-shadow: 0 0 0 .18rem rgba(47,110,168,.12); }
    .sc-input-readonly { background: #f4f8fc; color: #274766; }
    .sc-kv { display: grid; grid-template-columns: 120px 1fr; gap: .25rem .6rem; font-size: .875rem; }
    .sc-kv .k { color: #60758d; }
    .sc-kv .v { color: #17324f; font-weight: 600; word-break: break-word; }
    .sc-table thead th {
        font-size: .74rem; text-transform: uppercase; letter-spacing: .35px;
        color: #4e6682; background: #f4f8fd; border-bottom: 1px solid #dce7f3; white-space: nowrap;
        padding: .55rem .6rem;
    }
    .sc-table tbody td { vertical-align: middle; padding: .5rem .6rem; font-size: .875rem; }
    .sc-table tbody tr:hover { background: #eef5ff; }
    .sc-btn { border-radius: 8px; font-weight: 600; font-size: .875rem; }
    .sc-empty { padding: 2rem 1rem; text-align: center; color: #6b7f95; }
    @@media (max-width: 768px) {
        .sc-header { flex-direction: column; align-items: flex-start; }
        .sc-kv { grid-template-columns: 1fr; }
    }
</style>

<div class="sc-page">
    <div class="sc-header">
        <div>
            <h4><i class="fa-solid fa-x-ray me-2"></i>X-ray Collection Entry</h4>
            <div class="subtitle">Record X-ray films that have been performed — compact, queue-driven workflow</div>
        </div>
        <form method="post" asp-page-handler="SearchPatients" class="d-flex gap-2 align-items-center">
            @Html.AntiForgeryToken()
            @if (Model.SelectedPatient == null)
            {
                <input name="PatientSearch" value="@Model.PatientSearch" class="form-control form-control-sm sc-input" style="min-width:240px; background:rgba(255,255,255,.95); color:#17324f;" placeholder="Search patient (ID / PHN / name / phone)" />
                <button type="submit" class="btn btn-light btn-sm sc-btn"><i class="bi bi-search me-1"></i>Search</button>
            }
            else
            {
                <button type="submit" asp-page-handler="StartNew" class="btn btn-outline-light btn-sm sc-btn"><i class="bi bi-arrow-left-right me-1"></i>Change Patient</button>
            }
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@Model.Success</div>
    }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger py-2"><i class="bi bi-exclamation-circle me-1"></i>@Model.ErrorMessage</div>
    }

    <!-- Pending X-rays Queue -->
    <div class="sc-card">
        <div class="sc-card-header">
            <h6><i class="bi bi-list-check me-2"></i>Pending X-rays Queue <span class="badge bg-secondary ms-1">@Model.PendingScans.Count</span></h6>
            <span class="small text-secondary">Paid indents appear first — select to collect</span>
        </div>
        <div class="sc-card-body p-0">
            @if (Model.PendingScans.Any())
            {
                <div class="table-responsive">
                    <table class="table sc-table mb-0">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>ID / PHN</th>
                                <th>X-ray Required</th>
                                <th>Bill</th>
                                <th>Payment</th>
                                <th>Waiting Since</th>
                                <th style="width:90px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.PendingScans)
                            {
                                <tr>
                                    <td class="fw-semibold">@row.PatientName <small class="text-secondary fw-normal">(@(row.Sex?.ToString() ?? "-") @row.AgeString)</small></td>
                                    <td>@(row.PatientId?.ToString() ?? row.Phn ?? "-")</td>
                                    <td>@row.XrRequired</td>
                                    <td>
                                        @if (row.BillId.HasValue)
                                        {
                                            <span>#@row.BillId &middot; Rs. @row.BillNetTotal.ToString("N0")</span>
                                        }
                                        else { <span class="text-secondary">-</span> }
                                    </td>
                                    <td>
                                        @if (row.IsPaid)
                                        { <span class="badge bg-success">Paid</span> }
                                        else
                                        { <span class="badge bg-warning text-dark">Unpaid</span> }
                                    </td>
                                    <td>@(row.WaitingSince?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
                                    <td>
                                        <form method="post" asp-page-handler="SelectPatient" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="SelectedPatientId" value="@row.PatientDbId" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary sc-btn">Collect</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="sc-empty"><i class="bi bi-check2-circle me-1"></i>No X-rays are waiting for collection.</div>
            }
        </div>
    </div>

    @if (Model.SelectedPatient == null)
    {
        <!-- Patient Search & Registration -->
        <div class="sc-card">
            <div class="sc-card-header">
                <h6><i class="bi bi-search me-2"></i>Find / Register Patient</h6>
                <a href="javascript:void(0)" onclick="toggleNewPatient(true)" class="btn btn-sm btn-outline-success sc-btn"><i class="bi bi-person-plus me-1"></i>Add New Patient</a>
            </div>
            <div class="sc-card-body">
                <form method="post" asp-page-handler="SearchPatients" class="row g-2 align-items-end mb-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-5">
                        <label class="sc-label">Search</label>
                        <input name="PatientSearch" value="@Model.PatientSearch" class="form-control sc-input" placeholder="Patient ID, PHN, name, or phone" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary sc-btn"><i class="bi bi-search me-1"></i>Search</button>
                    </div>
                </form>

                @if (Model.PatientResults?.Any() == true)
                {
                    <div class="table-responsive mb-3">
                        <table class="table sc-table mb-0">
                            <thead><tr><th>Patient ID</th><th>PHN</th><th>Name</th><th>Gender</th><th>Phone</th><th style="width:90px"></th></tr></thead>
                            <tbody>
                                @foreach (var p in Model.PatientResults)
                                {
                                    <tr>
                                        <td>@p.PatientId</td>
                                        <td>@p.Phn</td>
                                        <td class="fw-semibold">@p.Person?.Name</td>
                                        <td>@(p.Person?.Sex.ToString() ?? "-")</td>
                                        <td>@(string.IsNullOrWhiteSpace(p.Person?.Mobile) ? (p.Person?.Phone ?? "-") : p.Person.Mobile)</td>
                                        <td>
                                            <form method="post" asp-page-handler="SelectPatient" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="SelectedPatientId" value="@p.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary sc-btn">Select</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div id="newPatientSection" style="display:none">
                    <div class="sc-section-title">New Patient Registration</div>
                    <form method="post" asp-page-handler="CreatePatient">
                        @Html.AntiForgeryToken()
                        <div class="row g-2">
                            <div class="col-md-4"><label class="sc-label">Full Name <span class="text-danger">*</span></label><input asp-for="NewName" class="form-control sc-input" placeholder="Full name" /></div>
                            <div class="col-md-4"><label class="sc-label">Name with Initials</label><input asp-for="NewNameWithInitials" class="form-control sc-input" placeholder="Optional" /></div>
                            <div class="col-md-4"><label class="sc-label">NIC</label><input asp-for="NewNic" class="form-control sc-input" placeholder="NIC / ID" /></div>
                            <div class="col-md-3"><label class="sc-label">Mobile</label><input asp-for="NewMobile" class="form-control sc-input" placeholder="Mobile" /></div>
                            <div class="col-md-3"><label class="sc-label">Phone</label><input asp-for="NewPhone" class="form-control sc-input" placeholder="Phone" /></div>
                            <div class="col-md-2"><label class="sc-label">Gender</label>
                                <select asp-for="NewSex" class="form-select sc-select">
                                    <option value="">--</option>
                                    <option value="@Sex.Male">Male</option>
                                    <option value="@Sex.Female">Female</option>
                                    <option value="@Sex.Other">Other</option>
                                </select>
                            </div>
                            <div class="col-12 d-flex gap-2 mt-1">
                                <button type="submit" class="btn btn-success sc-btn"><i class="bi bi-check2 me-1"></i>Register &amp; Select</button>
                                <button type="button" class="btn btn-outline-secondary sc-btn" onclick="toggleNewPatient(false)">Cancel</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Patient & Encounter Context -->
        <div class="sc-card">
            <div class="sc-card-header">
                <h6><i class="bi bi-person-vcard me-2"></i>Patient &amp; Encounter</h6>
                <form method="post" asp-page-handler="StartNew" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-secondary sc-btn"><i class="bi bi-x-circle me-1"></i>Change Patient</button>
                </form>
            </div>
            <div class="sc-card-body">
                <div class="row g-3">
                    <div class="col-lg-5">
                        <div class="sc-section-title">Patient</div>
                        <div class="sc-kv">
                            <div class="k">Name</div><div class="v">@Model.SelectedPatient.Person?.Name</div>
                            <div class="k">Patient ID</div><div class="v">@Model.SelectedPatient.PatientId</div>
                            <div class="k">PHN</div><div class="v">@(Model.SelectedPatient.Phn ?? "-")</div>
                            <div class="k">Sex / Phone</div><div class="v">@(Model.SelectedPatient.Person?.Sex.ToString() ?? "-") / @(string.IsNullOrWhiteSpace(Model.SelectedPatient.Person?.Mobile) ? (Model.SelectedPatient.Person?.Phone ?? "-") : Model.SelectedPatient.Person.Mobile)</div>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="sc-section-title">Encounter</div>
                        @if (Model.ActiveEncounters.Any())
                        {
                            <form method="post" asp-page-handler="SelectEncounter" class="d-flex flex-wrap gap-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <div>
                                    <label class="sc-label">Active Encounter</label>
                                    <select asp-for="SelectedEncounterId" class="form-select form-select-sm sc-select" onchange="this.form.submit()">
                                        @foreach (var enc in Model.ActiveEncounters)
                                        {
                                            <option value="@enc.Id">
                                                @(string.IsNullOrWhiteSpace(enc.BhtNo) ? enc.BhtLong : enc.BhtNo) — Adm: @(enc.DateOfAdmission?.ToString("dd-MMM-yyyy") ?? "-")
                                            </option>
                                        }
                                    </select>
                                </div>
                                <a href="/xr/Indent" class="btn btn-sm btn-outline-success sc-btn"><i class="bi bi-plus me-1"></i>New X-ray Indent</a>
                            </form>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-secondary small">No active encounter.</span>
                                <a href="/xr/Indent" class="btn btn-sm btn-outline-primary sc-btn"><i class="bi bi-plus me-1"></i>Create X-ray Indent</a>
                            </div>
                        }
                        @if (Model.SelectedEncounter != null)
                        {
                            <div class="small text-primary mt-2"><i class="bi bi-check-circle me-1"></i>Active encounter: <strong>@(string.IsNullOrWhiteSpace(Model.SelectedEncounter.BhtNo) ? Model.SelectedEncounter.BhtLong : Model.SelectedEncounter.BhtNo)</strong></div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending X-rays / Collection -->
        <div class="sc-card">
            <div class="sc-card-header">
                <h6><i class="bi bi-collection me-2"></i>X-rays for Collection <span class="badge bg-secondary ms-1">@Model.PendingOrders.Count pending</span></h6>
                @if (Model.PendingOrders.Any())
                {
                    <form method="post" asp-page-handler="GenerateBarcodes" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-primary sc-btn"><i class="bi bi-upc-scan me-1"></i>Generate Barcodes</button>
                    </form>
                }
            </div>
            @if (Model.PendingOrders.Any())
            {
                <form method="post" asp-page-handler="SaveCollections">
                    @Html.AntiForgeryToken()
                    <div class="table-responsive">
                        <table class="table sc-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width:44px" class="text-center">Collect</th>
                                    <th>X-ray</th>
                                    <th style="width:170px">Barcode</th>
                                    <th style="width:150px">X-ray Type</th>
                                    <th style="width:180px">Collected At</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.SampleCollections.Count; i++)
                                {
                                    var row = Model.SampleCollections[i];
                                    <tr>
                                        <td class="text-center">
                                            <input type="hidden" asp-for="SampleCollections[i].OrderId" />
                                            <input class="form-check-input" type="checkbox" asp-for="SampleCollections[i].Collect" />
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@row.ServiceName</div>
                                            <div class="small text-secondary">
                                                @row.Code
                                                @if (row.Qty > 1) { <span>&times;@row.Qty</span> }
                                                @if (!string.IsNullOrWhiteSpace(row.BillNo)) { <span>&middot; Bill #@row.BillNo</span> }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(row.Instructions))
                                            {
                                                <div class="small text-warning-emphasis"><i class="bi bi-info-circle me-1"></i>@row.Instructions</div>
                                            }
                                        </td>
                                        <td><input asp-for="SampleCollections[i].Barcode" class="form-control form-control-sm sc-input" /></td>
                                        <td><input asp-for="SampleCollections[i].SampleType" class="form-control form-control-sm sc-input" placeholder="e.g. Chest PA" /></td>
                                        <td><input asp-for="SampleCollections[i].CollectionDateTime" type="datetime-local" class="form-control form-control-sm sc-input" /></td>
                                        <td><input asp-for="SampleCollections[i].CollectionNotes" class="form-control form-control-sm sc-input" placeholder="Optional" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="sc-card-body border-top bg-light d-flex align-items-center gap-2">
                        <button type="submit" class="btn btn-success sc-btn"><i class="bi bi-check2-square me-1"></i>Mark Selected as Collected</button>
                        <span class="text-secondary small">Findings are entered later on X-ray Result Entry.</span>
                    </div>
                </form>
            }
            else
            {
                <div class="sc-empty">
                    <i class="bi bi-inbox" style="font-size:2rem;"></i>
                    <p class="mt-2 mb-0">No pending X-rays for this patient.</p>
                    <small>Select a paid X-ray from the queue or create an X-ray indent.</small>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleNewPatient(open) {
            var el = document.getElementById('newPatientSection');
            if (el) { el.style.display = open ? '' : 'none'; }
        }
    </script>
}
